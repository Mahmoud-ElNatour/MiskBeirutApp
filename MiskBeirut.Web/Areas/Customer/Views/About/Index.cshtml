@model MiskBeirut.Web.Support.PageContent
@{
    ViewData["Active"] = "about";
    Layout = "_PublicLayout";
}
<main class="pt-24">
<!-- Hero Header -->
<section class="relative bg-primary-container/10 pt-[80px] pb-stack-lg px-6 md:px-margin-desktop">
<div class="max-w-[1280px] mx-auto">
<h1 class="font-headline-lg text-headline-lg md:text-display-lg text-onyx-text mb-6" data-cms-field="hero_title" data-cms-type="Text">@Model.Text("hero_title", "About Misk Beirut")</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl" data-cms-field="hero_subtitle" data-cms-type="Text">
                    @Model.Text("hero_subtitle", "A timeless sanctuary of Levantine hospitality, where every dish tells a story of heritage and every visit feels like coming home.")
                </p>
</div>
<!-- Decorative Element -->
<div class="hero-decorative absolute right-0 top-0 w-1/3 h-full opacity-40 pointer-events-none hidden lg:block">
<img class="w-full h-full object-cover" alt="" aria-hidden="true" data-cms-field="hero_image" data-cms-type="Image" src="@Model.Image("hero_image", "/img/cms-placeholder.svg")"/>
</div>
</section>
<!-- Founder Story Section -->
<section class="py-section-gap px-margin-desktop max-w-[1280px] mx-auto">
<div class="grid grid-cols-1 md:grid-cols-12 gap-gutter items-center">
<!-- Left Column: Portrait -->
<div class="md:col-span-5 reveal-on-scroll">
<div class="relative group">
<div class="absolute -inset-4 border border-slate-blue/10 pointer-events-none transition-transform duration-500 group-hover:scale-[1.02]"></div>
<img alt="@Model.Text("founder_name", "Elias Mansour")" class="w-full h-auto object-cover grayscale hover:grayscale-0 transition-all duration-700 shadow-sm" data-cms-field="founder_image" data-cms-type="Image" src="@Model.Image("founder_image", "/img/cms-placeholder.svg")">
<div class="mt-6">
<p class="font-headline-md text-headline-md text-primary italic" data-cms-field="founder_name" data-cms-type="Text">@Model.Text("founder_name", "Elias Mansour")</p>
<p class="font-label-lg text-label-lg text-on-surface-variant uppercase tracking-widest mt-1" data-cms-field="founder_role" data-cms-type="Text">@Model.Text("founder_role", "Founder & Visionary")</p>
</div>
</div>
</div>
<!-- Right Column: Story -->
<div class="md:col-span-6 md:col-start-7 mt-12 md:mt-0 reveal-on-scroll" style="transition-delay: 200ms">
<span class="font-label-lg text-label-lg text-brick-red uppercase tracking-widest mb-4 block" data-cms-field="founder_eyebrow" data-cms-type="Text">@Model.Text("founder_eyebrow", "Since 1982")</span>
<h2 class="font-headline-lg text-headline-lg text-primary mb-8" data-cms-field="founder_title" data-cms-type="Text">@Model.Text("founder_title", "Our Story")</h2>
<div class="space-y-6">
<p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed" data-cms-field="founder_body_1" data-cms-type="Text">
                            @Model.Text("founder_body_1", "Misk Beirut began as a modest kitchen in the heart of pre-war Beirut, driven by Elias Mansour's unwavering belief that the soul of Lebanese culture resides in its flavors. What started as a small gathering place for poets and painters blossomed into a sanctuary for authentic Levantine gastronomy.")
                        </p>
<p class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed" data-cms-field="founder_body_2" data-cms-type="Text">
                            @Model.Text("founder_body_2", "Over four decades, we have remained anchored in our commitment to artisanal Levant techniques—sourcing the finest sumac from the mountains, olive oil from the groves of Koura, and hospitality from the depths of our heritage.")
                        </p>
</div>
<blockquote class="mt-12 pl-8 border-l-2 border-brick-red">
<p class="font-headline-md text-headline-md text-primary italic leading-tight" data-cms-field="founder_quote" data-cms-type="Text">
                            @Model.Text("founder_quote", "\"An honest approach to food, focusing on the integrity of ingredients and the warmth of Lebanese tradition.\"")
                        </p>
</blockquote>
</div>
</div>
</section>
<!-- Values Section -->
<section class="bg-marble-white py-section-gap">
<div class="max-w-[1280px] mx-auto px-margin-desktop">
<div class="text-center mb-16 reveal-on-scroll">
<h2 class="font-headline-lg text-headline-lg text-primary" data-cms-field="values_title" data-cms-type="Text">@Model.Text("values_title", "The Pillars of Misk")</h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-3 gap-gutter">
@{
    var valueIcons = new[] { "history_edu", "verified", "diversity_3" };
    var valueDefaults = new[]
    {
        ("Heritage", "Preserving the generational secrets of Lebanese culinary arts while embracing contemporary refinement."),
        ("Quality", "Sourcing without compromise. Every ingredient is selected for its purity, origin, and seasonal peak."),
        ("Community", "Creating a table where every guest is family. Our hospitality extends far beyond the dining room.")
    };
}
@for (var i = 1; i <= 3; i++)
{
    var (titleDefault, bodyDefault) = valueDefaults[i - 1];
    <div class="p-6 lg:p-12 reveal-on-scroll hover:translate-y-[-8px] transition-transform duration-300 text-center min-w-0" style="transition-delay: @(i * 100)ms">
        <div class="w-12 h-12 mx-auto flex items-center justify-center text-brick-red mb-8">
            <span class="material-symbols-outlined text-4xl">@valueIcons[i - 1]</span>
        </div>
        <h3 class="font-headline-md text-[clamp(18px,2.6vw,32px)] leading-[1.25] text-primary mb-4 whitespace-nowrap" data-cms-field="value_@(i)_title" data-cms-type="Text">@Model.Text($"value_{i}_title", titleDefault)</h3>
        <p class="font-body-md text-body-md text-on-surface-variant" data-cms-field="value_@(i)_body" data-cms-type="Text">
            @Model.Text($"value_{i}_body", bodyDefault)
        </p>
    </div>
}
</div>
</div>
</section>
<!-- Journey Timeline -->
<section class="py-section-gap px-margin-desktop max-w-[1280px] mx-auto">
<div class="text-center mb-24 reveal-on-scroll">
<h2 class="font-headline-lg text-headline-lg text-primary" data-cms-field="timeline_title" data-cms-type="Text">@Model.Text("timeline_title", "Our Journey Through Time")</h2>
</div>
<div class="relative">
<!-- Vertical Line -->
<div class="absolute left-1/2 -translate-x-1/2 h-full w-px bg-outline/10 hidden md:block"></div>
<!-- Timeline Items -->
<div class="space-y-24">
<!-- 1982 -->
<div class="relative grid grid-cols-1 md:grid-cols-2 gap-gutter md:gap-32 items-center reveal-on-scroll">
<div class="md:text-right">
<span class="font-display-lg text-display-lg text-brick-red/20 block mb-2 leading-none" data-cms-field="timeline_1_year" data-cms-type="Text">@Model.Text("timeline_1_year", "1982")</span>
<h4 class="font-headline-md text-headline-md text-primary mb-4" data-cms-field="timeline_1_title" data-cms-type="Text">@Model.Text("timeline_1_title", "The Founding")</h4>
<p class="font-body-md text-body-md text-on-surface-variant max-w-md md:ml-auto" data-cms-field="timeline_1_body" data-cms-type="Text">
                                @Model.Text("timeline_1_body", "Elias Mansour opens the first Misk oven in Beirut, focused on artisanal manousheh and traditional mezze.")
                            </p>
</div>
<div class="hidden md:block relative">
<div class="aspect-video bg-cover bg-center rounded-lg shadow-sm" data-cms-field="timeline_1_image" data-cms-type="BackgroundImage" style="background-image: url('@Model.Image("timeline_1_image", "/img/cms-placeholder.svg")')"></div>
</div>
</div>
<!-- 2004 -->
<div class="relative grid grid-cols-1 md:grid-cols-2 gap-gutter md:gap-32 items-center reveal-on-scroll">
<div class="md:order-2">
<span class="font-display-lg text-display-lg text-brick-red/20 block mb-2 leading-none" data-cms-field="timeline_2_year" data-cms-type="Text">@Model.Text("timeline_2_year", "2004")</span>
<h4 class="font-headline-md text-headline-md text-primary mb-4" data-cms-field="timeline_2_title" data-cms-type="Text">@Model.Text("timeline_2_title", "Expansion")</h4>
<p class="font-body-md text-body-md text-on-surface-variant max-w-md" data-cms-field="timeline_2_body" data-cms-type="Text">
                                @Model.Text("timeline_2_body", "Relocation to a historic manor in the Central District, transforming into a full-scale culinary destination.")
                            </p>
</div>
<div class="hidden md:block relative md:order-1">
<div class="aspect-video bg-cover bg-center rounded-lg shadow-sm" data-cms-field="timeline_2_image" data-cms-type="BackgroundImage" style="background-image: url('@Model.Image("timeline_2_image", "/img/cms-placeholder.svg")')"></div>
</div>
</div>
<!-- Today -->
<div class="relative grid grid-cols-1 md:grid-cols-2 gap-gutter md:gap-32 items-center reveal-on-scroll">
<div class="md:text-right">
<span class="font-display-lg text-display-lg text-brick-red/20 block mb-2 leading-none" data-cms-field="timeline_3_year" data-cms-type="Text">@Model.Text("timeline_3_year", "Today")</span>
<h4 class="font-headline-md text-headline-md text-primary mb-4" data-cms-field="timeline_3_title" data-cms-type="Text">@Model.Text("timeline_3_title", "Contemporary Sanctuary")</h4>
<p class="font-body-md text-body-md text-on-surface-variant max-w-md md:ml-auto" data-cms-field="timeline_3_body" data-cms-type="Text">
                                @Model.Text("timeline_3_body", "Now a multi-award winning institution, bridging traditional Levantine warmth with modern luxury across the globe.")
                            </p>
</div>
<div class="hidden md:block relative">
<div class="aspect-video bg-cover bg-center rounded-lg shadow-sm" data-cms-field="timeline_3_image" data-cms-type="BackgroundImage" style="background-image: url('@Model.Image("timeline_3_image", "/img/cms-placeholder.svg")')"></div>
</div>
</div>
</div>
</div>
</section>
</main>
