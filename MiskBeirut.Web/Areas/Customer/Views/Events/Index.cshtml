@model MiskBeirut.Web.Support.PageContent
@{
    ViewData["Active"] = "events";
    Layout = "_PublicLayout";
    var footballCaptions = Model.IsRtl
        ? new[] { "يوم مباراة 1", "يوم مباراة 2", "يوم مباراة 3", "يوم مباراة 4" }
        : new[] { "Match Day 1", "Match Day 2", "Match Day 3", "Match Day 4" };
    var privateCaptions = Model.IsRtl
        ? new[] { "حفلات الزفاف", "فعاليات الشركات", "أعياد الميلاد", "المناسبات الخاصة" }
        : new[] { "Weddings", "Corporate Events", "Birthday Parties", "Special Occasions" };
}
<!-- PAGE HEADER -->
<section class="relative mt-24 bg-primary-container/10 pt-[80px] pb-stack-lg px-6 md:px-margin-desktop" id="header">
<div class="max-w-[1280px] mx-auto">
<h1 class="font-headline-lg text-headline-lg md:text-display-lg text-onyx-text mb-6" data-cms-field="hero_title" data-cms-type="Text">@Model.Text("hero_title", "Events at Misk Beirut")</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl" data-cms-field="hero_subtitle" data-cms-type="Text">@Model.Text("hero_subtitle", "Experience unforgettable moments with us")</p>
</div>
<!-- Decorative Element -->
<div class="hero-decorative absolute right-0 top-0 w-1/3 h-full opacity-40 pointer-events-none hidden lg:block">
<img class="w-full h-full object-cover" alt="" aria-hidden="true" data-cms-field="hero_image" data-cms-type="Image" src="@Model.Image("hero_image", "/img/cms-placeholder.svg")"/>
</div>
</section>

<!-- FOOTBALL & LIVE MATCH SCREENINGS -->
<section class="py-[80px] scroll-mt-24" id="football">
<div class="max-w-[1280px] mx-auto px-[20px] md:px-[80px]">
<h2 class="font-display-lg text-headline-lg text-primary mb-[16px]" data-cms-field="football_title" data-cms-type="Text">@Model.Text("football_title", "Football & Live Match Screenings")</h2>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl mb-[48px]" data-cms-field="football_body" data-cms-type="Text">@Model.Text("football_body", "Big matches on the big screen, with the kitchen open and a table held for your group.", "المباريات الكبرى على الشاشة الكبيرة، مع مطبخ مفتوح وطاولة محجوزة لمجموعتك.")</p>
<div class="carousel-head flex items-center justify-between mb-[16px]">
<div class="w-16 h-0.5 bg-brick-red"></div>

</div>
<div class="flex gap-[16px] overflow-x-auto pb-4 snap-x space-carousel" id="footballGalleryRow">
@{ var footballMaxIndex = Math.Max(3, Model.MaxIndex("football_gallery_", "_image")); }
@for (var i = 1; i <= footballMaxIndex; i++)
{
    var tileImage = Model.Image($"football_gallery_{i}_image");
    var captionDefault = i <= footballCaptions.Length ? footballCaptions[i - 1] : $"Photo {i}";
    var tileCaption = Model.Text($"football_gallery_{i}_caption", captionDefault);
    var tileField = $"football_gallery_{i}_image";
    var tileCaptionField = $"football_gallery_{i}_caption";
    var tileIsPlaceholder = !Model.Has(tileField);
    var tileImageOrPlaceholder = tileIsPlaceholder ? "/img/cms-placeholder.svg" : tileImage;
    <div class="cms-gallery-slot w-[280px] h-[280px] md:w-[340px] md:h-[320px] flex-shrink-0 snap-start bg-slate-blue/10 border border-outline/20 flex items-center justify-center text-on-surface-variant bg-cover bg-center relative" data-gallery="football" data-cms-field="@tileField" data-cms-type="BackgroundImage" style="background-image:url('@tileImageOrPlaceholder')">
        @if (tileIsPlaceholder)
        {
            <span class="cms-placeholder-badge absolute bottom-2 left-2 right-2 text-center bg-black/60 text-white text-[10px] uppercase tracking-wider px-2 py-1 rounded pointer-events-none">No image set</span>
        }
        <span class="sr-only @(tileIsPlaceholder ? "cms-placeholder-caption" : "")" data-cms-field="@tileCaptionField" data-cms-type="Text">@tileCaption</span>
    </div>
}
<button type="button" class="cms-add-gallery-slot cms-preview-edit-only w-[100px] h-[280px] md:h-[320px] flex-shrink-0 snap-start border-2 border-dashed border-outline/40 items-center justify-center gap-2 text-on-surface-variant hover:border-brick-red hover:text-brick-red transition-colors" data-gallery="football">
    <span class="material-symbols-outlined text-2xl">add_photo_alternate</span>
    <span class="text-xs font-label-sm uppercase tracking-wider">Add Photo</span>
</button>
</div>
<template id="footballGallerySlotTemplate">
    <div class="cms-gallery-slot w-[280px] h-[280px] md:w-[340px] md:h-[320px] flex-shrink-0 snap-start bg-slate-blue/10 border border-outline/20 flex items-center justify-center text-on-surface-variant bg-cover bg-center relative" data-gallery="football" data-cms-field="football_gallery___INDEX___image" data-cms-type="BackgroundImage" style="background-image:url('/img/cms-placeholder.svg')">
        <span class="cms-placeholder-badge absolute bottom-2 left-2 right-2 text-center bg-black/60 text-white text-[10px] uppercase tracking-wider px-2 py-1 rounded pointer-events-none">No image set</span>
        <span data-cms-field="football_gallery___INDEX___caption" data-cms-type="Text">@(Model.IsRtl ? "صورة" : "Photo") __INDEX__</span>
    </div>
</template>
<div class="mt-[48px]">
<a asp-controller="Contact" asp-action="Index" class="bg-brick-red text-white px-12 py-5 font-label-lg text-label-lg uppercase tracking-widest hover:bg-opacity-90 transition-all inline-block" data-cms-field="football_cta_label" data-cms-type="Text">@Model.Text("football_cta_label", "Reserve Your Spot")</a>
</div>
</div>
</section>

<!-- Divider -->
<hr class="max-w-[1280px] mx-auto border-t border-outline/20 mx-[20px] md:mx-auto">

<!-- PRIVATE EVENTS & CELEBRATIONS -->
<section class="py-[80px] scroll-mt-24" id="private-events">
<div class="max-w-[1280px] mx-auto px-[20px] md:px-[80px]">
<h2 class="font-display-lg text-headline-lg text-primary mb-[16px]" data-cms-field="private_title" data-cms-type="Text">@Model.Text("private_title", "Private Events & Celebrations")</h2>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl mb-[48px]" data-cms-field="private_body" data-cms-type="Text">@Model.Text("private_body", "Birthdays, engagements and company dinners, planned with you and hosted in the space that fits them.", "أعياد ميلاد وخطوبات وعشاءات عمل، نخطّط لها معك ونستضيفها في المساحة التي تناسبها.")</p>
<div class="carousel-head flex items-center justify-between mb-[16px]">
<div class="w-16 h-0.5 bg-brick-red"></div>

</div>
<div class="flex gap-[16px] overflow-x-auto pb-4 snap-x space-carousel" id="privateGalleryRow">
@{ var privateMaxIndex = Math.Max(3, Model.MaxIndex("private_gallery_", "_image")); }
@for (var i = 1; i <= privateMaxIndex; i++)
{
    var tileImage = Model.Image($"private_gallery_{i}_image");
    var captionDefault = i <= privateCaptions.Length ? privateCaptions[i - 1] : $"Photo {i}";
    var tileCaption = Model.Text($"private_gallery_{i}_caption", captionDefault);
    var tileField = $"private_gallery_{i}_image";
    var tileCaptionField = $"private_gallery_{i}_caption";
    var tileIsPlaceholder = !Model.Has(tileField);
    var tileImageOrPlaceholder = tileIsPlaceholder ? "/img/cms-placeholder.svg" : tileImage;
    <div class="cms-gallery-slot w-[280px] h-[280px] md:w-[340px] md:h-[320px] flex-shrink-0 snap-start bg-slate-blue/10 border border-outline/20 flex items-center justify-center text-on-surface-variant bg-cover bg-center relative" data-gallery="private" data-cms-field="@tileField" data-cms-type="BackgroundImage" style="background-image:url('@tileImageOrPlaceholder')">
        @if (tileIsPlaceholder)
        {
            <span class="cms-placeholder-badge absolute bottom-2 left-2 right-2 text-center bg-black/60 text-white text-[10px] uppercase tracking-wider px-2 py-1 rounded pointer-events-none">No image set</span>
        }
        <span class="sr-only @(tileIsPlaceholder ? "cms-placeholder-caption" : "")" data-cms-field="@tileCaptionField" data-cms-type="Text">@tileCaption</span>
    </div>
}
<button type="button" class="cms-add-gallery-slot cms-preview-edit-only w-[100px] h-[280px] md:h-[320px] flex-shrink-0 snap-start border-2 border-dashed border-outline/40 items-center justify-center gap-2 text-on-surface-variant hover:border-brick-red hover:text-brick-red transition-colors" data-gallery="private">
    <span class="material-symbols-outlined text-2xl">add_photo_alternate</span>
    <span class="text-xs font-label-sm uppercase tracking-wider">Add Photo</span>
</button>
</div>
<template id="privateGallerySlotTemplate">
    <div class="cms-gallery-slot w-[280px] h-[280px] md:w-[340px] md:h-[320px] flex-shrink-0 snap-start bg-slate-blue/10 border border-outline/20 flex items-center justify-center text-on-surface-variant bg-cover bg-center relative" data-gallery="private" data-cms-field="private_gallery___INDEX___image" data-cms-type="BackgroundImage" style="background-image:url('/img/cms-placeholder.svg')">
        <span class="cms-placeholder-badge absolute bottom-2 left-2 right-2 text-center bg-black/60 text-white text-[10px] uppercase tracking-wider px-2 py-1 rounded pointer-events-none">No image set</span>
        <span data-cms-field="private_gallery___INDEX___caption" data-cms-type="Text">@(Model.IsRtl ? "صورة" : "Photo") __INDEX__</span>
    </div>
</template>
<div class="mt-[48px]">
<a asp-controller="Contact" asp-action="Index" class="bg-slate-blue text-white px-12 py-5 font-label-lg text-label-lg uppercase tracking-widest hover:opacity-90 transition-all inline-block" data-cms-field="private_cta_label" data-cms-type="Text">@Model.Text("private_cta_label", "Get in Touch")</a>
</div>
</div>
</section>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const hash = window.location.hash.replace('#', '');
        if (hash === 'football' || hash === 'private-events') {
            const target = document.getElementById(hash);
            if (target) {
                setTimeout(function() {
                    target.scrollIntoView({ behavior: 'smooth' });
                }, 100);
            }
        }

        // CMS edit mode only (see .cms-preview-edit-only in _CmsPreviewOverlay.cshtml): there's no
        // fixed slot count — "Add Photo" clones a blank tile from the matching <template>, numbered
        // one past however many tiles are currently in that gallery, and inserts it just before the
        // button. Its pencil shows up on the next overlay relayout, ready to be filled in like any
        // other field. Click it as many times as you like; MaxIndex() on the next page load picks up
        // wherever the numbering ended.
        document.querySelectorAll('.cms-add-gallery-slot').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var gallery = btn.dataset.gallery;
                var template = document.getElementById(gallery + 'GallerySlotTemplate');
                if (!template) return;
                var nextIndex = document.querySelectorAll('.cms-gallery-slot[data-gallery="' + gallery + '"]').length + 1;
                var html = template.innerHTML.replace(/__INDEX__/g, nextIndex);
                var wrapper = document.createElement('div');
                wrapper.innerHTML = html.trim();
                var tile = wrapper.firstElementChild;
                btn.parentNode.insertBefore(tile, btn);
                if (window.cmsRelayoutOverlay) window.cmsRelayoutOverlay();
            });
        });
    });
</script>
}
