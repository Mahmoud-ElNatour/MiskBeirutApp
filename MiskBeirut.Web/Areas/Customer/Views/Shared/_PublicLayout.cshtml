</script>
<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
    /* Base rule lives here (loaded on EVERY page) rather than only in _CmsPreviewOverlay.cshtml,
       which is included solely when IsCmsPreview is true — a real site visitor never gets that
       partial, so without this the "Add Photo" button (and anything else CMS-edit-only) would
       render as a normal visible control on the live public page. The "show it back" override for
       CMS edit mode still lives in _CmsPreviewOverlay.cshtml, since body.cms-edit-mode can only ever
       be set from within a CMS preview anyway. */
    .cms-preview-edit-only { display: none; }
    .hero-gradient {
        background: linear-gradient(to bottom, rgba(53, 89, 112, 0.4), rgba(53, 89, 112, 0.6));
    }
    @@keyframes scroll-indicator {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
    }
    .animate-scroll {
        animation: scroll-indicator 2s infinite;
    }
    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-on-scroll.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .form-input-focus:focus {
        border-color: #8F383A;
        border-bottom-width: 2px;
        outline: none;
    }
    .transition-form {
        transition: max-height 0.5s ease-in-out, opacity 0.4s ease-in-out;
    }
    .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .insta-carousel, .space-carousel { scrollbar-width: thin; scrollbar-color: #8F383A rgba(78,114,137,0.12); }
    .insta-carousel::-webkit-scrollbar, .space-carousel::-webkit-scrollbar { height: 4px; }
    .insta-carousel::-webkit-scrollbar-track, .space-carousel::-webkit-scrollbar-track { background: rgba(78,114,137,0.12); }
    .insta-carousel::-webkit-scrollbar-thumb, .space-carousel::-webkit-scrollbar-thumb { background: #8F383A; }
    .space-carousel > div { transition: box-shadow .3s, transform .3s; }
    .space-carousel > div:hover { box-shadow: 0 8px 24px rgba(53,89,112,0.15); transform: translateY(-4px); }

    html[dir="rtl"] body { text-align: right; }
    html[dir="rtl"] .text-center { text-align: center; }
    html[dir="rtl"] .border-l-2 { border-left-width: 0; border-right-width: 2px; }
    html[dir="rtl"] .border-l { border-left-width: 0; border-right-width: 1px; }
    html[dir="rtl"] .pl-6 { padding-left: 0; padding-right: 1.5rem; }
    html[dir="rtl"] .md\:text-right { text-align: left; }
    html[dir="rtl"] #mobile-drawer { right: auto; left: 0; border-left: none; border-right: 1px solid rgba(114,120,125,0.1); }
    html[dir="rtl"] #mobile-drawer.translate-x-full { transform: translateX(-100%); }
    html[dir="rtl"] .group-hover\:translate-x-1,
    html[dir="rtl"] .hover\:translate-x-2 { --tw-translate-x: -0.25rem; }
    html[dir="rtl"] .hero-decorative { right: auto; left: 0; }
</style>
@await RenderSectionAsync("Head", required: false)
</head>
<body class="bg-marble-white text-on-surface font-body-md overflow-x-hidden">
@if (ViewData["IsCmsPreview"] as bool? == true)
{
    @await Html.PartialAsync("~/Areas/Cms/Views/Shared/_CmsPreviewBar.cshtml")
}
@await Html.PartialAsync("_PublicNav")
@RenderBody()
@await Html.PartialAsync("_PublicFooter")
@{
    var isHomePage = string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), "Home", StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), "Index", StringComparison.OrdinalIgnoreCase);
}
@if (isHomePage)
{
    @await Html.PartialAsync("_DiscountPopup")
}
@if (ViewData["IsCmsPreview"] as bool? == true)
{
    @await Html.PartialAsync("~/Areas/Cms/Views/Shared/_FieldEditModal.cshtml")
    @await Html.PartialAsync("~/Areas/Cms/Views/Shared/_CmsPreviewOverlay.cshtml")
}

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const currentYear = new Date().getFullYear();
        const yearElement = document.getElementById('current-year');
        if (yearElement) {
            yearElement.textContent = currentYear;
        }
    });

    function toggleMobileMenu() {
        const drawer = document.getElementById('mobile-drawer');
        const backdrop = document.getElementById('mobile-backdrop');
        if (drawer.classList.contains('translate-x-full')) {
            drawer.classList.remove('translate-x-full');
            backdrop.classList.remove('hidden');
            setTimeout(() => backdrop.classList.add('opacity-100'), 10);
            document.body.style.overflow = 'hidden';
        } else {
            drawer.classList.add('translate-x-full');
            backdrop.classList.remove('opacity-100');
            setTimeout(() => backdrop.classList.add('hidden'), 300);
            document.body.style.overflow = '';
        }
    }

    function toggleLanguage() {
        const next = document.documentElement.getAttribute('lang') === 'ar' ? 'en' : 'ar';
        document.cookie = 'lang=' + next + ';path=/;max-age=31536000';
        location.reload();
    }

    window.addEventListener('scroll', () => {
        const nav = document.querySelector('nav');
        if (!nav) return;
        if (window.scrollY > 20) {
            nav.classList.add('py-2', 'bg-surface/95');
            nav.classList.remove('py-4', 'bg-surface/80');
        } else {
            nav.classList.add('py-4', 'bg-surface/80');
            nav.classList.remove('py-2', 'bg-surface/95');
        }
    });

    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.reveal-on-scroll').forEach(el => revealObserver.observe(el));

    function scrollCarousel(btn, dir) {
        const track = btn.closest('.carousel-head').nextElementSibling;
        track.scrollBy({ left: dir * 360, behavior: 'smooth' });
    }
</script>
<script>
(function () {
    const GALLERY_SELECTOR = '.space-carousel, .insta-carousel';
    let items = [];
    let index = 0;

    const overlay = document.createElement('div');
    overlay.id = 'photo-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    overlay.style.cssText = 'position:fixed;inset:0;z-index:100;background:rgba(26,26,26,0.95);display:none;align-items:center;justify-content:center;';

    const stage = document.createElement('div');
    stage.style.cssText = 'max-width:90vw;max-height:85vh;display:flex;align-items:center;justify-content:center;';
    overlay.appendChild(stage);

    function lbButton(label, icon, css) {
        const btn = document.createElement('button');
        btn.setAttribute('aria-label', label);
        btn.style.cssText = 'position:absolute;width:56px;height:56px;border:1px solid rgba(255,255,255,0.3);background:rgba(255,255,255,0.08);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .2s;' + css;
        btn.innerHTML = '<span class="material-symbols-outlined" style="font-size:28px;">' + icon + '</span>';
        btn.onmouseenter = () => btn.style.background = 'rgba(255,255,255,0.22)';
        btn.onmouseleave = () => btn.style.background = 'rgba(255,255,255,0.08)';
        overlay.appendChild(btn);
        return btn;
    }
    const closeBtn = lbButton('Close full screen view', 'close', 'top:24px;right:24px;');
    const prevBtn = lbButton('Previous photo', 'arrow_back', 'left:16px;top:50%;transform:translateY(-50%);');
    const nextBtn = lbButton('Next photo', 'arrow_forward', 'right:16px;top:50%;transform:translateY(-50%);');

    const counter = document.createElement('p');
    counter.style.cssText = 'position:absolute;bottom:24px;left:50%;transform:translateX(-50%);color:#fff;opacity:.7;letter-spacing:.2em;font-size:13px;margin:0;';
    overlay.appendChild(counter);

    function imageUrlOf(item) {
        const img = item.querySelector('img');
        if (img && img.src) return img.src;
        const host = [item].concat(Array.from(item.querySelectorAll('*'))).find(function (e) {
            const bg = getComputedStyle(e).backgroundImage;
            return bg && bg.indexOf('url(') === 0;
        });
        if (host) {
            const bg = getComputedStyle(host).backgroundImage;
            return bg.replace(/^url\(["']?/, '').replace(/["']?\)$/, '');
        }
        return null;
    }

    function render() {
        stage.innerHTML = '';
        const item = items[index];
        const url = imageUrlOf(item);
        if (url) {
            const img = document.createElement('img');
            img.src = url;
            img.alt = (item.querySelector('img') && item.querySelector('img').alt) || item.getAttribute('data-alt') || '';
            img.style.cssText = 'max-width:90vw;max-height:85vh;object-fit:contain;box-shadow:0 20px 60px rgba(0,0,0,0.5);';
            stage.appendChild(img);
        } else {
            const clone = item.cloneNode(true);
            clone.style.cssText = 'width:min(80vw,560px);height:min(80vw,560px);transform:none;cursor:default;';
            stage.appendChild(clone);
        }
        counter.textContent = (index + 1) + ' / ' + items.length;
    }

    function openLightbox() {
        overlay.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
        overlay.style.display = 'none';
        document.body.style.overflow = '';
    }
    function step(dir) {
        index = (index + dir + items.length) % items.length;
        render();
    }

    closeBtn.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', function (e) { e.stopPropagation(); step(-1); });
    nextBtn.addEventListener('click', function (e) { e.stopPropagation(); step(1); });
    overlay.addEventListener('click', function (e) { if (e.target === overlay || e.target === stage) closeLightbox(); });
    document.addEventListener('keydown', function (e) {
        if (overlay.style.display === 'none' || !overlay.style.display) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
    });

    // Only real photo tiles open the lightbox — controls that happen to live inside a gallery row
    // (e.g. the CMS's "Add Photo" button, see Areas/Customer/Views/Events/Index.cshtml) opt out via
    // .cms-preview-edit-only so a click on them doesn't also pop the full-screen viewer.
    function galleryTiles(gallery) {
        return Array.from(gallery.children).filter(function (el) { return !el.classList.contains('cms-preview-edit-only'); });
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.body.appendChild(overlay);
        document.querySelectorAll(GALLERY_SELECTOR).forEach(function (gallery) {
            galleryTiles(gallery).forEach(function (tile) {
                tile.style.cursor = 'zoom-in';
                tile.addEventListener('click', function () {
                    items = galleryTiles(gallery);
                    index = items.indexOf(tile);
                    render();
                    openLightbox();
                });
            });
        });
    });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
