<script>
    document.addEventListener('DOMContentLoaded', function () {
        const currentYear = new Date().getFullYear();
        const yearElement = document.getElementById('current-year');
        if (yearElement) {
            yearElement.textContent = currentYear;
        }
    });

    function toggleMobileMenu() {
        const drawer = document.getElementById('mobile-drawer');
        const backdrop = document.getElementById('mobile-backdrop');
        if (drawer.classList.contains('translate-x-full')) {
            drawer.classList.remove('translate-x-full');
            backdrop.classList.remove('hidden');
            setTimeout(() => backdrop.classList.add('opacity-100'), 10);
            document.body.style.overflow = 'hidden';
        } else {
            drawer.classList.add('translate-x-full');
            backdrop.classList.remove('opacity-100');
            setTimeout(() => backdrop.classList.add('hidden'), 300);
            document.body.style.overflow = '';
        }
    }

    // Fallback for the Cms's visual preview only. On the public site the language switcher is a
    // pair of ordinary links to /en/... and /ar/... — switching language changes which page you are
    // on, so it has to be shareable, bookmarkable and followable by a crawler, none of which a
    // cookie-and-reload button is. The preview has no public URL to link to, so it still flips the
    // cookie; the page it lands on writes the same cookie back (PublicContentController).
    function setLanguage(code) {
        if (document.documentElement.getAttribute('lang') === code) return;
        document.cookie = 'lang=' + code + ';path=/;max-age=31536000';
        location.reload();
    }

    window.addEventListener('scroll', () => {
        const nav = document.querySelector('nav');
        if (!nav) return;
        if (window.scrollY > 20) {
            nav.classList.add('py-2', 'bg-surface/95');
            nav.classList.remove('py-4', 'bg-surface/80');
        } else {
            nav.classList.add('py-4', 'bg-surface/80');
            nav.classList.remove('py-2', 'bg-surface/95');
        }
    });

    const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('visible');
            }
        });
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    document.querySelectorAll('.reveal-on-scroll').forEach(el => revealObserver.observe(el));

    function scrollCarousel(btn, dir) {
        const track = btn.closest('.carousel-head').nextElementSibling;
        track.scrollBy({ left: dir * 360, behavior: 'smooth' });
    }
</script>
<script>
(function () {
    const GALLERY_SELECTOR = '.space-carousel, .insta-carousel';
    let items = [];
    let index = 0;

    const overlay = document.createElement('div');
    overlay.id = 'photo-lightbox';
    overlay.setAttribute('role', 'dialog');
    overlay.setAttribute('aria-modal', 'true');
    // Only `display` stays inline (it is the open/closed switch); everything else is in the
    // #photo-lightbox stylesheet so the mobile media query can reach it.
    overlay.style.display = 'none';

    const stage = document.createElement('div');
    stage.className = 'lb-stage';
    overlay.appendChild(stage);

    // Positioning/sizing lives in the #photo-lightbox rules at the top of this file — inline styles
    // here would win over the mobile media query and put the chevrons back on top of the photo.
    function lbButton(label, icon, className) {
        const btn = document.createElement('button');
        btn.setAttribute('aria-label', label);
        btn.className = 'lb-btn ' + className;
        btn.innerHTML = '<span class="material-symbols-outlined">' + icon + '</span>';
        overlay.appendChild(btn);
        return btn;
    }
    const closeBtn = lbButton('Close full screen view', 'close', 'lb-close');
    const prevBtn = lbButton('Previous photo', 'arrow_back', 'lb-prev');
    const nextBtn = lbButton('Next photo', 'arrow_forward', 'lb-next');

    const counter = document.createElement('p');
    counter.className = 'lb-counter';
    overlay.appendChild(counter);

    function imageUrlOf(item) {
        const img = item.querySelector('img');
        if (img && img.src) return img.src;
        const host = [item].concat(Array.from(item.querySelectorAll('*'))).find(function (e) {
            const bg = getComputedStyle(e).backgroundImage;
            return bg && bg.indexOf('url(') === 0;
        });
        if (host) {
            const bg = getComputedStyle(host).backgroundImage;
            return bg.replace(/^url\(["']?/, '').replace(/["']?\)$/, '');
        }
        return null;
    }

    function render() {
        stage.innerHTML = '';
        const item = items[index];
        const url = imageUrlOf(item);
        if (url) {
            const img = document.createElement('img');
            img.src = url;
            img.alt = (item.querySelector('img') && item.querySelector('img').alt) || item.getAttribute('data-alt') || '';
            stage.appendChild(img);
        } else {
            const clone = item.cloneNode(true);
            clone.style.cssText = 'width:min(80vw,560px);height:min(80vw,560px);transform:none;cursor:default;';
            stage.appendChild(clone);
        }
        counter.textContent = (index + 1) + ' / ' + items.length;
    }

    function openLightbox() {
        overlay.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
        overlay.style.display = 'none';
        document.body.style.overflow = '';
    }
    function step(dir) {
        index = (index + dir + items.length) % items.length;
        render();
    }

    closeBtn.addEventListener('click', closeLightbox);
    prevBtn.addEventListener('click', function (e) { e.stopPropagation(); step(-1); });
    nextBtn.addEventListener('click', function (e) { e.stopPropagation(); step(1); });
    overlay.addEventListener('click', function (e) { if (e.target === overlay || e.target === stage) closeLightbox(); });
    document.addEventListener('keydown', function (e) {
        if (overlay.style.display === 'none' || !overlay.style.display) return;
        if (e.key === 'Escape') closeLightbox();
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
    });

    // Only real photo tiles open the lightbox. Two kinds of child opt out: controls that happen to
    // live inside a gallery row (the CMS's "Add Photo" button, see Events/Index.cshtml) via
    // .cms-preview-edit-only, and tiles that are themselves links — the live Instagram posts, which
    // lead to instagram.com and would otherwise both navigate and pop the viewer on one click.
    function galleryTiles(gallery) {
        return Array.from(gallery.children).filter(function (el) {
            return !el.classList.contains('cms-preview-edit-only') && !el.hasAttribute('data-no-lightbox');
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        document.body.appendChild(overlay);
        document.querySelectorAll(GALLERY_SELECTOR).forEach(function (gallery) {
            galleryTiles(gallery).forEach(function (tile) {
                tile.style.cursor = 'zoom-in';
                tile.addEventListener('click', function () {
                    items = galleryTiles(gallery);
                    index = items.indexOf(tile);
                    render();
                    openLightbox();
                });
            });
        });
    });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
