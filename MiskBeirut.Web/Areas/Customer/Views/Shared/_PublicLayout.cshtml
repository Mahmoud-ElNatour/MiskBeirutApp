<style>
    .material-symbols-outlined {
        font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 24;
    }
    /* Base rule lives here (loaded on EVERY page) rather than only in _CmsPreviewOverlay.cshtml,
       which is included solely when IsCmsPreview is true — a real site visitor never gets that
       partial, so without this the "Add Photo" button (and anything else CMS-edit-only) would
       render as a normal visible control on the live public page. The "show it back" override for
       CMS edit mode still lives in _CmsPreviewOverlay.cshtml, since body.cms-edit-mode can only ever
       be set from within a CMS preview anyway. */
    .cms-preview-edit-only { display: none; }
    /* Same reasoning for the empty-image affordances. A real visitor gets the branded placeholder
       (/img/cms-placeholder.svg) on its own; the "No image set" badge and the slot's caption text
       are working notes that only mean something to whoever can fill the slot in, so they surface
       inside a Cms preview and nowhere else. */
    .cms-placeholder-badge { display: none; }
    body.cms-preview .cms-placeholder-badge { display: block; }
    body.cms-preview .cms-placeholder-caption {
        position: static; width: auto; height: auto;
        padding: 0; margin: 0; overflow: visible; clip: auto; white-space: normal;
    }
    .hero-gradient {
        background: linear-gradient(to bottom, rgba(53, 89, 112, 0.4), rgba(53, 89, 112, 0.6));
    }
    @@keyframes scroll-indicator {
        0%, 20%, 50%, 80%, 100% { transform: translateY(0); }
        40% { transform: translateY(-10px); }
        60% { transform: translateY(-5px); }
    }
    .animate-scroll {
        animation: scroll-indicator 2s infinite;
    }
    .reveal-on-scroll {
        opacity: 0;
        transform: translateY(20px);
        transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .reveal-on-scroll.visible {
        opacity: 1;
        transform: translateY(0);
    }
    .form-input-focus:focus {
        border-color: #8F383A;
        border-bottom-width: 2px;
        outline: none;
    }
    .transition-form {
        transition: max-height 0.5s ease-in-out, opacity 0.4s ease-in-out;
    }
    /* Careers vacancy details (<details>/<summary>): hide the browser's own disclosure triangle so
       the chevron in the summary is the only marker, and turn it when the section opens. */
    .vacancy-details summary::-webkit-details-marker { display: none; }
    .vacancy-details[open] .vacancy-details-chevron { transform: rotate(180deg); }
    /* Full-screen photo viewer (built in script at the bottom of this file). Styled here rather
       than with inline styles so the mobile layout below can actually override it: at phone width
       the two 56px chevrons sat on top of the photo itself, half-covering it and landing right where
       a thumb swipes. On small screens they move to a control row beneath the image instead. */
    #photo-lightbox {
        position: fixed; inset: 0; z-index: 100; background: rgba(26,26,26,0.95);
        align-items: center; justify-content: center;
    }
    #photo-lightbox .lb-btn {
        position: absolute; width: 56px; height: 56px;
        border: 1px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.08); color: #fff;
        display: flex; align-items: center; justify-content: center; cursor: pointer; transition: background .2s;
    }
    #photo-lightbox .lb-btn:hover { background: rgba(255,255,255,0.22); }
    #photo-lightbox .lb-btn .material-symbols-outlined { font-size: 28px; }
    #photo-lightbox .lb-close { top: 24px; right: 24px; }
    #photo-lightbox .lb-prev { left: 16px; top: 50%; transform: translateY(-50%); }
    #photo-lightbox .lb-next { right: 16px; top: 50%; transform: translateY(-50%); }
    #photo-lightbox .lb-counter {
        position: absolute; bottom: 24px; left: 50%; transform: translateX(-50%);
        color: #fff; opacity: .7; letter-spacing: .2em; font-size: 13px; margin: 0;
    }
    #photo-lightbox .lb-stage { max-width: 90vw; max-height: 85vh; display: flex; align-items: center; justify-content: center; }
    #photo-lightbox .lb-stage img { max-width: 90vw; max-height: 85vh; object-fit: contain; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
    @@media (max-width: 767px) {
        #photo-lightbox { align-items: flex-start; padding-top: 72px; }
        #photo-lightbox .lb-stage { max-height: calc(100vh - 220px); }
        #photo-lightbox .lb-stage img { max-height: calc(100vh - 220px); }
        #photo-lightbox .lb-btn { width: 48px; height: 48px; }
        #photo-lightbox .lb-btn .material-symbols-outlined { font-size: 24px; }
        #photo-lightbox .lb-close { top: 12px; right: 12px; }
        #photo-lightbox .lb-prev,
        #photo-lightbox .lb-next {
            top: auto; transform: none;
            bottom: calc(24px + env(safe-area-inset-bottom, 0px));
        }
        #photo-lightbox .lb-prev { left: 50%; margin-left: -68px; }
        #photo-lightbox .lb-next { right: 50%; margin-right: -68px; }
        #photo-lightbox .lb-counter { bottom: calc(88px + env(safe-area-inset-bottom, 0px)); }
    }
    /* The chevrons are literal "back"/"forward" glyphs, so they have to swap with the reading order. */
    /* The glyphs are literal back/forward arrows, so they flip with the reading order too. */
    html[dir="rtl"] #photo-lightbox .lb-prev .material-symbols-outlined,
    html[dir="rtl"] #photo-lightbox .lb-next .material-symbols-outlined { transform: scaleX(-1); }
    html[dir="rtl"] #photo-lightbox .lb-prev { left: auto; right: 16px; }
    html[dir="rtl"] #photo-lightbox .lb-next { right: auto; left: 16px; }
    html[dir="rtl"] #photo-lightbox .lb-close { right: auto; left: 24px; }
    @@media (max-width: 767px) {
        html[dir="rtl"] #photo-lightbox .lb-prev { left: auto; right: 50%; margin-right: -68px; margin-left: 0; }
        html[dir="rtl"] #photo-lightbox .lb-next { right: auto; left: 50%; margin-left: -68px; margin-right: 0; }
        html[dir="rtl"] #photo-lightbox .lb-close { left: 12px; right: auto; }
    }

    .no-scrollbar { scrollbar-width: none; -ms-overflow-style: none; }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .insta-carousel, .space-carousel { scrollbar-width: thin; scrollbar-color: #8F383A rgba(78,114,137,0.12); }
    .insta-carousel::-webkit-scrollbar, .space-carousel::-webkit-scrollbar { height: 4px; }
    .insta-carousel::-webkit-scrollbar-track, .space-carousel::-webkit-scrollbar-track { background: rgba(78,114,137,0.12); }
    .insta-carousel::-webkit-scrollbar-thumb, .space-carousel::-webkit-scrollbar-thumb { background: #8F383A; }
    .space-carousel > div { transition: box-shadow .3s, transform .3s; }
    .space-carousel > div:hover { box-shadow: 0 8px 24px rgba(53,89,112,0.15); transform: translateY(-4px); }

    html[dir="rtl"] body { text-align: right; }
    html[dir="rtl"] .text-center { text-align: center; }
    html[dir="rtl"] .border-l-2 { border-left-width: 0; border-right-width: 2px; }
    html[dir="rtl"] .border-l { border-left-width: 0; border-right-width: 1px; }
    /* A quote's accent bar moves to the right in RTL (above), so its padding has to move with it —
       otherwise the Arabic text sits flush against the bar with no breathing room. Both step sizes
       the quotes use are listed; miss one and only that page looks cramped. */
    html[dir="rtl"] .pl-6 { padding-left: 0; padding-right: 1.5rem; }
    html[dir="rtl"] .pl-8 { padding-left: 0; padding-right: 2rem; }
    html[dir="rtl"] .md\:text-right { text-align: left; }
    /* Floating labels are absolutely positioned from the left; in RTL that leaves every label
       stranded on the wrong side of its own field. */
    html[dir="rtl"] .rtl-form label.absolute { left: auto; right: 0; }
    html[dir="rtl"] .rtl-form label { text-align: right; }
    html[dir="rtl"] .rtl-form input,
    html[dir="rtl"] .rtl-form textarea { text-align: right; }
    /* Directional glyphs (the Contact form's paper plane, "next" chevrons) point the wrong way once
       the page reads right-to-left. */
    html[dir="rtl"] .rtl-flip { transform: scaleX(-1); }
    html[dir="rtl"] .group:hover .rtl-flip { transform: scaleX(-1) translateX(0.25rem); }
    html[dir="rtl"] #mobile-drawer { right: auto; left: 0; border-left: none; border-right: 1px solid rgba(114,120,125,0.1); }
    html[dir="rtl"] #mobile-drawer.translate-x-full { transform: translateX(-100%); }
    html[dir="rtl"] .group-hover\:translate-x-1,
    html[dir="rtl"] .hover\:translate-x-2 { --tw-translate-x: -0.25rem; }
    html[dir="rtl"] .hero-decorative { right: auto; left: 0; }
</style>
@* Structured data. One graph rather than a stack of unrelated blocks: the page points at the
   website, the website at the restaurant, and each job posting names that same restaurant, so the
   whole site describes one business instead of several with the same name. *@
<script type="application/ld+json">
@Html.Raw(StructuredData.Build(
    ViewData["Content"] as PageContent ?? new PageContent(null, null, 0, lang),
    lang,
    Urls.BaseUrl(Context.Request),
    canonicalUrl,
    pageTitle,
    metaDescription,
    ogImage,
    Urls.ForLanguage(Context.Request, lang, "/menu"),
    ViewData["Vacancies"] as IReadOnlyList<VacancyDto>))
</script>
@await RenderSectionAsync("Head", required: false)
