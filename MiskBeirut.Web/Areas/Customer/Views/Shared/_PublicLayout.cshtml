@{
    var dir = ViewData["Dir"] as string == "rtl" ? "rtl" : null;
    var lang = ViewData["Lang"] as string ?? "en";
    var metaDescription = ViewData["MetaDescription"] as string;
}
<!DOCTYPE html>
<html class="scroll-smooth" lang="@lang" dir="@dir">
<head>
<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0" name="viewport" />
<title>@ViewData["Title"]</title>
@if (!string.IsNullOrWhiteSpace(metaDescription))
{
    <meta name="description" content="@metaDescription" />
}
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@@0,400..800;1,400..800&family=Hanken+Grotesk:ital,wght@@0,100..900;1,100..900&display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@@100..700,0..1&display=swap" rel="stylesheet">
<script id="tailwind-config">
    tailwind.config = {
        darkMode: "class",
        theme: {
            extend: {
                "colors": {
                    "primary": "#355970",
                    "tertiary-fixed": "#e2e2e3",
                    "on-error": "#ffffff",
                    "outline": "#72787d",
                    "on-secondary-fixed-variant": "#7d2a2d",
                    "primary-fixed-dim": "#a6cbe5",
                    "primary-fixed": "#c6e7ff",
                    "on-tertiary-container": "#f1f1f2",
                    "on-primary-container": "#e5f3ff",
                    "secondary": "#9b4143",
                    "surface-container": "#eeeeef",
                    "on-background": "#1a1c1d",
                    "slate-blue": "#4E7289",
                    "surface-container-lowest": "#ffffff",
                    "on-tertiary-fixed": "#1a1c1d",
                    "surface-container-low": "#f4f3f5",
                    "on-secondary": "#ffffff",
                    "on-surface-variant": "#42474c",
                    "on-secondary-fixed": "#410007",
                    "secondary-fixed-dim": "#ffb3b1",
                    "inverse-primary": "#a6cbe5",
                    "on-secondary-container": "#762528",
                    "marble-white": "#F5F5F6",
                    "on-primary": "#ffffff",
                    "secondary-container": "#fd8e8d",
                    "surface-container-high": "#e8e8ea",
                    "primary-container": "#4e7289",
                    "error-container": "#ffdad6",
                    "surface": "#f9f9fb",
                    "on-tertiary": "#ffffff",
                    "on-primary-fixed": "#001e2d",
                    "surface-tint": "#3e6379",
                    "on-error-container": "#93000a",
                    "inverse-on-surface": "#f1f0f2",
                    "on-primary-fixed-variant": "#254b60",
                    "inverse-surface": "#2f3132",
                    "on-tertiary-fixed-variant": "#454748",
                    "outline-variant": "#c2c7cd",
                    "surface-container-highest": "#e2e2e4",
                    "tertiary-fixed-dim": "#c6c6c7",
                    "background": "#f9f9fb",
                    "secondary-fixed": "#ffdad8",
                    "surface-dim": "#dadadc",
                    "tertiary-container": "#6c6e6f",
                    "on-surface": "#1a1c1d",
                    "surface-variant": "#e2e2e4",
                    "surface-bright": "#f9f9fb",
                    "onyx-text": "#1A1A1A",
                    "brick-red": "#8F383A",
                    "error": "#ba1a1a",
                    "tertiary": "#545657"
                },
                "borderRadius": {
                    "DEFAULT": "0.125rem",
                    "lg": "0.25rem",
                    "xl": "0.5rem",
                    "full": "0.75rem"
                },
                "spacing": {
                    "margin-desktop": "80px",
                    "stack-md": "16px",
                    "stack-lg": "48px",
                    "stack-sm": "8px",
                    "margin-mobile": "20px",
                    "section-gap": "120px",
                    "gutter": "24px"
                },
                "fontFamily": {
                    "headline-lg-mobile": ["EB Garamond"],
                    "body-lg": ["Hanken Grotesk"],
                    "headline-lg": ["EB Garamond"],
                    "headline-md": ["EB Garamond"],
                    "display-lg": ["EB Garamond"],
                    "label-sm": ["Hanken Grotesk"],
                    "body-md": ["Hanken Grotesk"],
                    "label-lg": ["Hanken Grotesk"]
                },
                "fontSize": {
                    "headline-lg-mobile": ["clamp(22px,2.8vw,32px)", {"lineHeight": "1.25", "fontWeight": "500"}],
                    "body-lg": ["18px", {"lineHeight": "28px", "fontWeight": "400"}],
                    "headline-lg": ["clamp(28px,4vw,48px)", {"lineHeight": "1.17", "fontWeight": "500"}],
                    "headline-md": ["clamp(22px,2.8vw,32px)", {"lineHeight": "1.25", "fontWeight": "400"}],
                    "display-lg": ["clamp(36px,5vw,64px)", {"lineHeight": "1.125", "letterSpacing": "-0.02em", "fontWeight": "500"}],
                    "label-sm": ["12px", {"lineHeight": "16px", "letterSpacing": "0.05em", "fontWeight": "500"}],
                    "body-md": ["16px", {"lineHeight": "24px", "fontWeight": "400"}],
                    "label-lg": ["14px", {"lineHeight": "20px", "letterSpacing": "0.1em", "fontWeight": "600"}]
