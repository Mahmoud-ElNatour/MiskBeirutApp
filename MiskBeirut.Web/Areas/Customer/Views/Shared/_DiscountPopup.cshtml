@using MiskBeirut.Web.Support
@{
    var content = (PageContent)ViewData["Content"]!;
    var eyebrow = content.Global("discount_popup_eyebrow", "A eroro Gift");
    var title = content.Global("discount_popup_title", "10% not disc");
    var subtitle = content.Global("discount_popup_subtitle", "do not fuck the essence of Beirut. Subscribe to receive your luxury dining credit.");
    var submitLabel = content.Global("discount_popup_submit_label", "CLAIM mf");
    var successMessage = content.Global("discount_popup_success_message", "Thank mn! Your discount code is on its way to your inbox.");
    var alreadyClaimedMessage = content.Global("discount_popup_already_claimed_message", "You'jaj already claimed your discount - check your inbox for your code!");
}
<style>
    @@keyframes discount-popup-in {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
    }
    #lead-capture-popup.animate-popup {
        animation: discount-popup-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    #lead-capture-popup input:focus {
        border-color: #8F383A;
        box-shadow: 0 0 0 3px rgba(143, 56, 58, 0.12);
    }
</style>

<div class="fixed bottom-6 right-6 z-[100] w-[90vw] md:w-[420px] bg-marble-white/95 backdrop-blur-md p-8 shadow-2xl animate-popup text-on-surface border border-outline/10" dir="ltr" id="lead-capture-popup">
    <button type="button" class="absolute top-4 right-4 w-8 h-8 rounded-full flex items-center justify-center border border-outline/20 hover:bg-black/5 transition-colors" onclick="document.getElementById('lead-capture-popup').style.display='none'" aria-label="Close">
        <span class="material-symbols-outlined text-sm">close</span>
    </button>
    <div class="space-y-4">
        <span class="font-label-lg text-label-sm uppercase tracking-[0.2em] text-brick-red block">@eyebrow</span>
        <h2 class="font-display-lg text-4xl text-primary">@title</h2>
        <p class="font-body-md text-on-surface-variant leading-relaxed">
            @subtitle
        </p>
        <form id="discount-popup-form" asp-controller="Leads" asp-action="Subscribe" class="space-y-3 pt-2">
            @Html.AntiForgeryToken()
            <input class="w-full bg-surface border border-outline/20 px-4 py-2 text-sm focus:outline-none transition-colors placeholder:text-on-surface-variant/50" name="Name" placeholder="Name" required type="text">
            <div class="grid grid-cols-2 gap-3">
                <input class="w-full bg-surface border border-outline/20 px-4 py-2 text-sm focus:outline-none transition-colors placeholder:text-on-surface-variant/50" name="PhoneNumber" placeholder="Phone" required type="tel">
                <input class="w-full bg-surface border border-outline/20 px-4 py-2 text-sm focus:outline-none transition-colors placeholder:text-on-surface-variant/50" name="Email" placeholder="Email Address" required type="email">
            </div>
            <p id="discount-popup-error" class="hidden text-xs text-error"></p>
            <button class="w-full bg-brick-red text-white py-3 font-label-lg text-label-lg tracking-widest hover:opacity-90 transition-colors mt-2" type="submit">@submitLabel</button>
        </form>
        <div id="discount-popup-success" class="hidden text-center py-2" data-success-message="@successMessage" data-already-claimed-message="@alreadyClaimedMessage">
            <span class="material-symbols-outlined text-4xl text-brick-red mb-2 inline-block">check_circle</span>
            <p class="font-body-md text-sm text-on-surface-variant"></p>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const form = document.getElementById('discount-popup-form');
        if (!form) return;

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            const errorEl = document.getElementById('discount-popup-error');
            errorEl.classList.add('hidden');

            fetch(form.action, { method: 'POST', body: new FormData(form) })
                .then(function (response) {
                    if (response.status === 409) {
                        const successEl = document.getElementById('discount-popup-success');
                        form.classList.add('hidden');
                        successEl.querySelector('p').textContent = successEl.dataset.alreadyClaimedMessage;
                        successEl.classList.remove('hidden');
                        return;
                    }
                    if (!response.ok) throw new Error();
                    const successEl = document.getElementById('discount-popup-success');
                    form.classList.add('hidden');
                    successEl.querySelector('p').textContent = successEl.dataset.successMessage;
                    successEl.classList.remove('hidden');
                })
                .catch(function () {
                    errorEl.textContent = 'Something went wrong. Please check your details and try again.';
                    errorEl.classList.remove('hidden');
                });
        });
    });
</script>
