@using MiskBeirut.Application.Dtos.Contact
@using MiskBeirut.Core.Constants
@model MiskBeirut.Web.Support.PageContent
@{
    ViewData["Active"] = "contact";
    Layout = "_PublicLayout";
    // One source for the number, the address and the email — the Global page — so the Contact card,
    // the tel: link, the WhatsApp button, the footer and the Restaurant structured data can no longer
    // quote four different numbers at a visitor (or at Google, which reads the disagreement as four
    // near-identical businesses).
    var business = new BusinessProfile(Model);
    var callTel = business.PhoneLink;
    var emailValue = business.Email;
    var reasons = ViewData["Reasons"] as IReadOnlyList<InquiryReasonDto> ?? Array.Empty<InquiryReasonDto>();
    var isCmsPreview = ViewData["IsCmsPreview"] as bool? == true;

    var reasonPlaceholder = Model.Text("reason_placeholder", "Select a reason...", "اختر سبباً...");

    const string inputClass = "peer w-full bg-transparent border-0 border-b border-slate-blue/40 py-2 font-body-md text-on-surface placeholder-transparent focus:ring-0 focus:border-slate-blue transition-all";
    const string labelClass = "absolute left-0 -top-1 text-label-sm uppercase tracking-wider text-slate-blue transition-all peer-placeholder-shown:text-body-md peer-placeholder-shown:top-2 peer-placeholder-shown:text-tertiary peer-focus:-top-1 peer-focus:text-label-sm peer-focus:text-slate-blue";
    const string fieldErrorClass = "field-error hidden text-brick-red text-label-sm mt-1";
}
<main class="pt-24">
<!-- Hero Header -->
<section class="relative bg-primary-container/10 pt-[80px] pb-stack-lg px-6 md:px-margin-desktop">
<div class="max-w-[1280px] mx-auto">
<h1 class="font-headline-lg text-headline-lg md:text-display-lg text-onyx-text mb-6" data-cms-field="hero_title" data-cms-type="Text">@Model.Text("hero_title", "Get In Touch")</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl" data-cms-field="hero_subtitle" data-cms-type="Text">
                        @Model.Text("hero_subtitle", "Whether you are seeking a culinary escape, professional consultation, or have a general inquiry, our doors are always open.")
                    </p>
</div>
<!-- Decorative Element -->
<div class="hero-decorative absolute right-0 top-0 w-1/3 h-full opacity-40 pointer-events-none hidden lg:block">
<img class="w-full h-full object-cover" alt="" aria-hidden="true" data-cms-field="hero_image" data-cms-type="Image" src="@Model.Image("hero_image", "/img/cms-placeholder.svg")"/>
</div>
</section>
<!-- Main Content Section -->
<section class="py-[120px]">
<div class="max-w-[1280px] mx-auto px-[20px] md:px-[80px]">
<div class="grid grid-cols-1 md:grid-cols-12 gap-[24px] items-stretch">
<!-- Left: Info Squares -->
<div class="md:col-span-4 grid grid-rows-3 gap-[24px] reveal-on-scroll visible">
<a href="tel:@callTel" data-cms-field="info_call_tel_link" data-cms-type="Link" class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-[16px] p-stack-lg bg-surface-container-lowest shadow-sm border border-slate-blue/10 hover:shadow-md transition-shadow min-w-0 overflow-hidden">
<span class="material-symbols-outlined text-slate-blue text-4xl flex-shrink-0">call</span>
<div>
<h3 class="font-label-lg text-label-lg uppercase text-slate-blue mb-1" data-cms-field="info_call_title" data-cms-type="Text">@Model.Text("info_call_title", "Call Us")</h3>
@* One number, shown once. The card used to list two, neither of which matched the footer or the
   tel: link wrapping this very card. The value is edited on the Global page (contact_phone) so
   every surface that quotes it changes together. *@
<p class="font-body-md text-on-surface" dir="ltr" data-cms-field="contact_phone" data-cms-type="Text" data-cms-scope="global">@business.Phone</p>
</div>
</a>
<a href="mailto:@emailValue" data-cms-field="info_email_value" data-cms-type="Link" class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-[16px] p-stack-lg bg-surface-container-lowest shadow-sm border border-slate-blue/10 hover:shadow-md transition-shadow min-w-0 overflow-hidden">
<span class="material-symbols-outlined text-slate-blue text-4xl flex-shrink-0">mail</span>
<div>
<h3 class="font-label-lg text-label-lg uppercase text-slate-blue mb-1" data-cms-field="info_email_title" data-cms-type="Text">@Model.Text("info_email_title", "Email")</h3>
<p class="font-body-md text-on-surface break-words" data-cms-field="info_email_value" data-cms-type="Text">@emailValue</p>
</div>
</a>
<a href="@Model.Link("info_address_map_url", "https://www.google.com/maps/place/Misk+beirut")" data-cms-field="info_address_map_url" data-cms-type="Link" target="_blank" rel="noopener noreferrer" class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-[16px] p-stack-lg bg-surface-container-lowest shadow-sm border border-slate-blue/10 hover:shadow-md transition-shadow min-w-0 overflow-hidden">
<span class="material-symbols-outlined text-slate-blue text-4xl flex-shrink-0">location_on</span>
<div>
<h3 class="font-label-lg text-label-lg uppercase text-slate-blue mb-1" data-cms-field="info_address_title" data-cms-type="Text">@Model.Text("info_address_title", "Address")</h3>
<p class="font-body-md text-on-surface break-words" data-cms-field="address_line" data-cms-type="Text" data-cms-scope="global">@business.AddressLine</p>
</div>
</a>
</div>
<!-- Right: Contact Form -->
<div class="md:col-span-7 md:col-start-6 bg-white p-12 shadow-[0px_4px_20px_rgba(0,0,0,0.04)] reveal-on-scroll delay-100 visible">
@* rtl-form flips the floating labels and text alignment for Arabic — see _PublicLayout.cshtml. *@
<form id="contact-inquiry-form" class="rtl-form space-y-[48px]" novalidate
      data-cms-preview="@(isCmsPreview ? "1" : "0")"
      data-preview-message="@Model.Text("preview_notice", "Preview mode — inquiries are not submitted from the CMS.", "وضع المعاينة — لا تُرسل الطلبات من نظام إدارة المحتوى.")"
      data-reason-placeholder="@reasonPlaceholder"
      data-phone-pattern="@ValidationPatterns.PhoneNumber"
      data-email-pattern="@ValidationPatterns.Email"
      data-msg-name="@Model.Text("error_full_name", "Please enter your full name.", "يرجى إدخال اسمك الكامل.")"
      data-msg-phone="@Model.Text("error_phone", "Please enter a valid phone number — digits only, e.g. +961 3 123 456.", "يرجى إدخال رقم هاتف صحيح — أرقام فقط، مثال: +961 3 123 456.")"
      data-msg-email="@Model.Text("error_email", "Please enter a valid email address, e.g. name@example.com.", "يرجى إدخال بريد إلكتروني صحيح، مثال: name@example.com.")"
      data-msg-message="@Model.Text("error_message", "Please enter your message.", "يرجى كتابة رسالتك.")"
      data-msg-reason="@Model.Text("reason_error", "Please select a reason for contact.", "يرجى اختيار سبب التواصل.")"
      data-msg-generic="@Model.Text("error_generic", "Something went wrong. Please try again.", "حدث خطأ ما. يرجى المحاولة مرة أخرى.")"
      data-msg-offline="@Model.Text("error_offline", "Something went wrong. Please check your connection and try again.", "حدث خطأ ما. يرجى التحقق من اتصالك والمحاولة مرة أخرى.")">
@Html.AntiForgeryToken()
<div class="grid grid-cols-1 md:grid-cols-2 gap-[24px]">
<div class="relative pt-4">
<input class="@inputClass" id="name" name="FullName" placeholder="Full Name" required type="text" maxlength="@FieldLengths.Name">
<label class="@labelClass" for="name" data-cms-field="field_full_name" data-cms-type="Text">@Model.Text("field_full_name", "Full Name *")</label>
<p class="@fieldErrorClass" data-error-for="FullName"></p>
</div>
<div class="relative pt-4">
<input class="@inputClass" id="phone" name="PhoneNumber" placeholder="Phone Number" required type="tel" inputmode="tel" pattern="@ValidationPatterns.PhoneNumber" maxlength="@FieldLengths.PhoneNumber">
<label class="@labelClass" for="phone" data-cms-field="field_phone" data-cms-type="Text">@Model.Text("field_phone", "Phone Number *")</label>
<p class="@fieldErrorClass" data-error-for="PhoneNumber"></p>
</div>
</div>
<!-- Email Address -->
<div class="relative pt-4">
<input class="@inputClass" id="email" name="Email" placeholder="Email Address" type="email" inputmode="email" pattern="@ValidationPatterns.Email" maxlength="@FieldLengths.Email">
<label class="@labelClass" for="email" data-cms-field="field_email" data-cms-type="Text">@Model.Text("field_email", "Email Address (Optional)")</label>
<p class="@fieldErrorClass" data-error-for="Email"></p>
</div>
<!-- Reason for Contact -->
<div class="relative pt-4 group" id="custom-dropdown-container">
<input id="reason-input" name="ReasonId" type="hidden">
<label class="absolute left-0 -top-1 text-label-sm uppercase tracking-wider text-slate-blue" for="reason-trigger" data-cms-field="field_reason" data-cms-type="Text">@Model.Text("field_reason", "Reason for Contact *")</label>
<!-- Trigger -->
<div class="flex justify-between items-center w-full bg-transparent border-0 border-b border-slate-blue/20 py-2 font-body-md text-on-surface cursor-pointer transition-all" id="reason-trigger" role="button" tabindex="0" aria-haspopup="listbox" aria-expanded="false">
<span class="text-tertiary" id="trigger-text" data-cms-field="reason_placeholder" data-cms-type="Text">@reasonPlaceholder</span>
<span class="material-symbols-outlined text-slate-blue transition-transform duration-300" id="chevron-icon">expand_more</span>
</div>
<!-- Dropdown Panel -->
<ul class="absolute left-0 right-0 top-full mt-1 bg-white shadow-md rounded-sm z-10 hidden opacity-0 transition-opacity duration-200" id="dropdown-panel" role="listbox">
@foreach (var reason in reasons)
{
    <li class="py-3 px-4 font-body-md text-on-surface hover:bg-surface-container-low hover:text-primary cursor-pointer transition-colors" role="option" data-value="@reason.Id">@reason.Name</li>
}
</ul>
<!-- Error Message -->
<p class="@fieldErrorClass" data-error-for="ReasonId" id="dropdown-error"></p>
</div>
<!-- Message -->
<div class="relative pt-4">
<textarea class="@inputClass resize-none" id="message" name="Message" placeholder="Message" required rows="4" maxlength="@FieldLengths.Message"></textarea>
<label class="@labelClass" for="message" data-cms-field="field_message" data-cms-type="Text">@Model.Text("field_message", "Message *")</label>
<p class="@fieldErrorClass" data-error-for="Message"></p>
</div>
<p class="hidden text-brick-red text-label-sm" id="submit-error"></p>
<p class="hidden text-emerald-700 text-label-sm" id="submit-success" data-cms-field="success_message" data-cms-type="Text">@Model.Text("success_message", "Thank you for contacting us. We'll be in touch with you soon.", "شكراً لتواصلك معنا. سنعاود الاتصال بك قريباً.")</p>
<div class="flex justify-start">
<button class="group relative flex items-center gap-2 bg-slate-blue text-white font-label-lg text-label-lg uppercase tracking-widest px-8 py-4 overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1" type="submit">
<span class="relative z-10" data-cms-field="submit_label" data-cms-type="Text">@Model.Text("submit_label", "Send Inquiry")</span>
@* rtl-flip mirrors the paper plane so it points the way the text reads. *@
<span class="material-symbols-outlined relative z-10 rtl-flip transition-transform duration-300 group-hover:translate-x-1">send</span>
<div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-20 transition-opacity"></div>
</button>
</div>
</form>
</div>
</div>
<!-- Map (full width) -->
<div class="mt-[48px] w-full h-80 grayscale hover:grayscale-0 transition-all duration-700 overflow-hidden shadow-sm border border-slate-blue/10"><iframe allowfullscreen="" class="w-full h-full border-0" loading="lazy" data-cms-field="map_embed_url" data-cms-type="MapEmbed" src="@Model.MapEmbed("map_embed_url", "info_address_map_url", "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13248.847525287515!2d35.51091565!3d33.8966774!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x151f16f39369670f%3A0xc3b83c50937c050!2sBeirut%2C%20Lebanon!5e0!3m2!1sen!2sus!4v1715872145678!5m2!1sen!2sus")"></iframe></div>
</div>
</section>
</main>
<!-- Phone Floating Action Button -->
<a href="tel:@callTel" aria-label="Call us" class="fixed bottom-24 right-6 z-50 w-14 h-14 rounded-[50%] bg-slate-blue shadow-2xl flex items-center justify-center hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-white text-[28px]">call</span>
</a>
<!-- WhatsApp Floating Action Button -->
<a href="@business.WhatsAppUrl" data-cms-field="contact_whatsapp_url" data-cms-type="Link" data-cms-scope="global" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp" class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-[50%] bg-[#25D366] shadow-2xl flex items-center justify-center hover:scale-110 transition-transform">
<svg class="w-7 h-7" viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>

@section Scripts {
<script>
    (function() {
        const container = document.getElementById('custom-dropdown-container');
        const trigger = document.getElementById('reason-trigger');
        const panel = document.getElementById('dropdown-panel');
        const chevron = document.getElementById('chevron-icon');
        const input = document.getElementById('reason-input');
        const triggerText = document.getElementById('trigger-text');
        const form = document.getElementById('contact-inquiry-form');
        const d = form.dataset;

        const phonePattern = new RegExp(d.phonePattern);
        const emailPattern = new RegExp(d.emailPattern);

        function errorEl(field) {
            return form.querySelector('[data-error-for="' + field + '"]');
        }

        function showFieldError(field, message) {
            const el = errorEl(field);
            if (!el) return;
            el.textContent = message;
            el.classList.remove('hidden');
        }

        function clearFieldErrors() {
            form.querySelectorAll('.field-error').forEach(function (el) {
                el.textContent = '';
                el.classList.add('hidden');
            });
        }

        // Mirrors the [RegularExpression] rules on ContactInquiryRequest, so the visitor is told
        // which box is wrong and why BEFORE a round trip — the old form only ever said "please fill
        // in all required fields", which was actively misleading when every box was filled in and
        // the real problem was letters typed into the phone number.
        function validate() {
            const problems = {};
            const name = form.elements['FullName'].value.trim();
            const phone = form.elements['PhoneNumber'].value.trim();
            const email = form.elements['Email'].value.trim();
            const message = form.elements['Message'].value.trim();

            if (!name) problems.FullName = d.msgName;
            if (!phone || !phonePattern.test(phone)) problems.PhoneNumber = d.msgPhone;
            if (email && !emailPattern.test(email)) problems.Email = d.msgEmail;
            if (!input.value) problems.ReasonId = d.msgReason;
            if (!message) problems.Message = d.msgMessage;
            return problems;
        }

        const toggleDropdown = () => {
            const isOpen = !panel.classList.contains('hidden');
            if (isOpen) {
                panel.classList.add('opacity-0');
                setTimeout(() => panel.classList.add('hidden'), 200);
                chevron.style.transform = 'rotate(0deg)';
                trigger.setAttribute('aria-expanded', 'false');
            } else {
                panel.classList.remove('hidden');
                setTimeout(() => panel.classList.remove('opacity-0'), 10);
                chevron.style.transform = 'rotate(180deg)';
                trigger.setAttribute('aria-expanded', 'true');
            }
        };

        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleDropdown();
        });

        function resetReason() {
            input.value = '';
            // Read the placeholder back from the form's data attribute rather than baking it into
            // this script: a Razor value interpolated into a JS string literal arrives HTML-encoded,
            // which textContent then renders verbatim ("&#x627;&#x62E;...") for Arabic visitors.
            triggerText.textContent = d.reasonPlaceholder;
            triggerText.classList.remove('text-on-surface');
            triggerText.classList.add('text-tertiary');
        }

        panel.querySelectorAll('li').forEach(option => {
            option.addEventListener('click', () => {
                input.value = option.getAttribute('data-value');
                triggerText.textContent = option.textContent;
                triggerText.classList.remove('text-tertiary');
                triggerText.classList.add('text-on-surface');
                const el = errorEl('ReasonId');
                if (el) el.classList.add('hidden');
                toggleDropdown();
            });
        });

        document.addEventListener('click', (e) => {
            if (!container.contains(e.target)) {
                panel.classList.add('opacity-0');
                panel.classList.add('hidden');
                chevron.style.transform = 'rotate(0deg)';
                trigger.setAttribute('aria-expanded', 'false');
            }
        });

        // Re-check a field once the visitor leaves it, so a correction clears its message straight
        // away instead of surviving until the next submit.
        ['FullName', 'PhoneNumber', 'Email', 'Message'].forEach(function (field) {
            const control = form.elements[field];
            if (!control) return;
            control.addEventListener('blur', function () {
                const el = errorEl(field);
                if (!el || el.classList.contains('hidden')) return;
                if (!validate()[field]) el.classList.add('hidden');
            });
        });

        form.addEventListener('submit', (e) => {
            e.preventDefault();
            if (form.dataset.cmsPreview === '1') {
                alert(d.previewMessage);
                return;
            }

            const submitErrorEl = document.getElementById('submit-error');
            const submitSuccessEl = document.getElementById('submit-success');
            const submitBtn = form.querySelector('button[type="submit"]');
            submitErrorEl.classList.add('hidden');
            submitSuccessEl.classList.add('hidden');
            clearFieldErrors();

            const problems = validate();
            const problemFields = Object.keys(problems);
            if (problemFields.length > 0) {
                problemFields.forEach(function (field) { showFieldError(field, problems[field]); });
                const firstControl = form.elements[problemFields[0]];
                if (firstControl && firstControl.focus) firstControl.focus();
                return;
            }

            submitBtn.disabled = true;

            fetch('@Url.Action("Submit", "Contact", new { area = "Customer", lang = Model.LangCode })', { method: 'POST', body: new FormData(form) })
                .then(async response => {
                    if (response.ok) {
                        submitSuccessEl.classList.remove('hidden');
                        form.reset();
                        resetReason();
                        return;
                    }
                    const data = await response.json().catch(() => null);
                    if (data && data.errors) {
                        Object.keys(data.errors).forEach(function (field) { showFieldError(field, data.errors[field]); });
                    }
                    submitErrorEl.textContent = (data && data.message) || d.msgGeneric;
                    submitErrorEl.classList.remove('hidden');
                })
                .catch(() => {
                    submitErrorEl.textContent = d.msgOffline;
                    submitErrorEl.classList.remove('hidden');
                })
                .finally(() => {
                    submitBtn.disabled = false;
                });
        });
    })();
</script>
}
