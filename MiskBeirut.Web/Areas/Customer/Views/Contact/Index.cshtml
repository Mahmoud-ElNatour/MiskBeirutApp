@model MiskBeirut.Web.Support.PageContent
@{
    ViewData["Active"] = "contact";
    Layout = "_PublicLayout";
    var callTel = Model.Text("info_call_tel_link", "+9611123456");
    var emailValue = Model.Text("info_email_value", "hello@miskbeirut.com");
}
<main class="pt-24">
<!-- Hero Header -->
<section class="relative bg-primary-container/10 pt-[80px] pb-stack-lg px-6 md:px-margin-desktop">
<div class="max-w-[1280px] mx-auto">
<h1 class="font-headline-lg text-headline-lg md:text-display-lg text-onyx-text mb-6">@Model.Text("hero_title", "Get In Touch")</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">
                        @Model.Text("hero_subtitle", "Whether you are seeking a culinary escape, professional consultation, or have a general inquiry, our doors are always open.")
                    </p>
</div>
<!-- Decorative Element -->
<div class="hero-decorative absolute right-0 top-0 w-1/3 h-full opacity-10 pointer-events-none hidden lg:block">
<img class="w-full h-full object-cover" alt="Architectural detail of a modern Lebanese restaurant interior" src="@Model.Image("hero_image", "https://lh3.googleusercontent.com/aida-public/AB6AXuCrG1HU9jiVr-8Wn2Fm5iex47uAo0h1sHnHlW_uqvIOaesHotr02DT6PDsoSpz2QYySz1W_5Y6jl6ewWoMQGKjhrC0KxodVzbgdRAwS4w8h3FBNDuqvoYfON-hBiR7JuweJvXd8JZ98ruQbemyumsiTQZCwCUFCnoRUU_8oyGSn-yuWU62PZIcVclnmhAmZzexpp81ykRoz5QedPmzUaFaB7xwqdhH_8-iEaeCubM-5UY4gdjQD367JMPITI75ljnUHeXwoqPiil8I")"/>
</div>
</section>
<!-- Main Content Section -->
<section class="py-[120px]">
<div class="max-w-[1280px] mx-auto px-[20px] md:px-[80px]">
<div class="grid grid-cols-1 md:grid-cols-12 gap-[24px] items-stretch">
<!-- Left: Info Squares -->
<div class="md:col-span-4 grid grid-rows-3 gap-[24px] reveal-on-scroll visible">
<a href="tel:@callTel" class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-[16px] p-stack-lg bg-surface-container-lowest shadow-sm border border-slate-blue/10 hover:shadow-md transition-shadow min-w-0 overflow-hidden">
<span class="material-symbols-outlined text-slate-blue text-4xl flex-shrink-0">call</span>
<div>
<h3 class="font-label-lg text-label-lg uppercase text-slate-blue mb-1">@Model.Text("info_call_title", "Call Us")</h3>
<p class="font-body-md text-on-surface">@Model.Text("info_call_phone_1", "+961 1 123 456")</p>
<p class="font-body-md text-on-surface">@Model.Text("info_call_phone_2", "+961 3 987 654")</p>
</div>
</a>
<a href="mailto:@emailValue" class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-[16px] p-stack-lg bg-surface-container-lowest shadow-sm border border-slate-blue/10 hover:shadow-md transition-shadow min-w-0 overflow-hidden">
<span class="material-symbols-outlined text-slate-blue text-4xl flex-shrink-0">mail</span>
<div>
<h3 class="font-label-lg text-label-lg uppercase text-slate-blue mb-1">@Model.Text("info_email_title", "Email")</h3>
<p class="font-body-md text-on-surface break-words">@emailValue</p>
</div>
</a>
<a href="@Model.Link("info_address_map_url", "https://www.google.com/maps/search/Gemmayzeh,+Pasteur+Street,+Beirut")" target="_blank" rel="noopener noreferrer" class="grid grid-cols-[auto_minmax(0,1fr)] items-center gap-[16px] p-stack-lg bg-surface-container-lowest shadow-sm border border-slate-blue/10 hover:shadow-md transition-shadow min-w-0 overflow-hidden">
<span class="material-symbols-outlined text-slate-blue text-4xl flex-shrink-0">location_on</span>
<div>
<h3 class="font-label-lg text-label-lg uppercase text-slate-blue mb-1">@Model.Text("info_address_title", "Address")</h3>
<p class="font-body-md text-on-surface break-words">@Model.Text("info_address_value", "Gemmayzeh, Pasteur Street, Beirut")</p>
</div>
</a>
</div>
<!-- Right: Contact Form -->
<div class="md:col-span-7 md:col-start-6 bg-white p-12 shadow-[0px_4px_20px_rgba(0,0,0,0.04)] reveal-on-scroll delay-100 visible">
<form class="space-y-[48px]" onsubmit="event.preventDefault(); alert('@Model.Text("success_message", "Message sent successfully.")');">
<div class="grid grid-cols-1 md:grid-cols-2 gap-[24px]"><div class="relative pt-4"><input class="peer w-full bg-transparent border-0 border-b border-slate-blue/40 py-2 font-body-md text-on-surface placeholder-transparent focus:ring-0 focus:border-slate-blue transition-all" id="name" placeholder="Full Name" required type="text"><label class="absolute left-0 -top-1 text-label-sm uppercase tracking-wider text-slate-blue transition-all peer-placeholder-shown:text-body-md peer-placeholder-shown:top-2 peer-placeholder-shown:text-tertiary peer-focus:-top-1 peer-focus:text-label-sm peer-focus:text-slate-blue" for="name">@Model.Text("field_full_name", "Full Name *")</label></div><div class="relative pt-4"><input class="peer w-full bg-transparent border-0 border-b border-slate-blue/40 py-2 font-body-md text-on-surface placeholder-transparent focus:ring-0 focus:border-slate-blue transition-all" id="phone" placeholder="Phone Number" type="tel"><label class="absolute left-0 -top-1 text-label-sm uppercase tracking-wider text-slate-blue transition-all peer-placeholder-shown:text-body-md peer-placeholder-shown:top-2 peer-placeholder-shown:text-tertiary peer-focus:-top-1 peer-focus:text-label-sm peer-focus:text-slate-blue" for="phone">@Model.Text("field_phone", "Phone Number *")</label></div></div>
<!-- Email Address -->
<div class="relative pt-4">
<input class="peer w-full bg-transparent border-0 border-b border-slate-blue/40 py-2 font-body-md text-on-surface placeholder-transparent focus:ring-0 focus:border-slate-blue transition-all" id="email" placeholder="Email Address" type="email">
<label class="absolute left-0 -top-1 text-label-sm uppercase tracking-wider text-slate-blue transition-all peer-placeholder-shown:text-body-md peer-placeholder-shown:top-2 peer-placeholder-shown:text-tertiary peer-focus:-top-1 peer-focus:text-label-sm peer-focus:text-slate-blue" for="email">@Model.Text("field_email", "Email Address (Optional)")</label>
</div>
<!-- Reason for Contact -->
<div class="relative pt-4 group" id="custom-dropdown-container">
<input id="reason-input" name="reason" required type="hidden">
<label class="absolute left-0 -top-1 text-label-sm uppercase tracking-wider text-slate-blue" for="reason-trigger">@Model.Text("field_reason", "Reason for Contact *")</label>
<!-- Trigger -->
<div class="flex justify-between items-center w-full bg-transparent border-0 border-b border-slate-blue/20 py-2 font-body-md text-on-surface cursor-pointer transition-all" id="reason-trigger">
<span class="text-tertiary" id="trigger-text">@Model.Text("reason_placeholder", "Select a reason...")</span>
<span class="material-symbols-outlined text-slate-blue transition-transform duration-300" id="chevron-icon">expand_more</span>
</div>
<!-- Dropdown Panel -->
<ul class="absolute left-0 right-0 top-full mt-1 bg-white shadow-md rounded-sm z-10 hidden opacity-0 transition-opacity duration-200" id="dropdown-panel">
<li class="py-3 px-4 font-body-md text-on-surface hover:bg-surface-container-low hover:text-primary cursor-pointer transition-colors" data-value="Consulting">@Model.Text("reason_option_1", "Consulting")</li>
<li class="py-3 px-4 font-body-md text-on-surface hover:bg-surface-container-low hover:text-primary cursor-pointer transition-colors" data-value="Feedback">@Model.Text("reason_option_2", "Feedback")</li>
<li class="py-3 px-4 font-body-md text-on-surface hover:bg-surface-container-low hover:text-primary cursor-pointer transition-colors" data-value="Inquiry">@Model.Text("reason_option_3", "General Inquiry")</li>
</ul>
<!-- Error Message -->
<p class="hidden text-brick-red text-label-sm mt-1" id="dropdown-error">@Model.Text("reason_error", "Please select a reason for contact.")</p>
</div>
<!-- Message -->
<div class="relative pt-4">
<textarea class="peer w-full bg-transparent border-0 border-b border-slate-blue/40 py-2 font-body-md text-on-surface placeholder-transparent focus:ring-0 focus:border-slate-blue transition-all resize-none" id="message" placeholder="Message" required rows="4"></textarea>
<label class="absolute left-0 -top-1 text-label-sm uppercase tracking-wider text-slate-blue transition-all peer-placeholder-shown:text-body-md peer-placeholder-shown:top-2 peer-placeholder-shown:text-tertiary peer-focus:-top-1 peer-focus:text-label-sm peer-focus:text-slate-blue" for="message">@Model.Text("field_message", "Message *")</label>
</div>
<div class="flex justify-start">
<button class="group relative flex items-center gap-2 bg-slate-blue text-white font-label-lg text-label-lg uppercase tracking-widest px-8 py-4 overflow-hidden transition-all duration-300 hover:shadow-xl hover:-translate-y-1" type="submit">
<span class="relative z-10">@Model.Text("submit_label", "Send Inquiry")</span>
<span class="material-symbols-outlined relative z-10 transition-transform duration-300 group-hover:translate-x-1">send</span>
<div class="absolute inset-0 bg-primary opacity-0 group-hover:opacity-20 transition-opacity"></div>
</button>
</div>
</form>
</div>
</div>
<!-- Map (full width) -->
<div class="mt-[48px] w-full h-80 grayscale hover:grayscale-0 transition-all duration-700 overflow-hidden shadow-sm border border-slate-blue/10"><iframe allowfullscreen="" class="w-full h-full border-0" loading="lazy" src="@Model.Link("map_embed_url", "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d13248.847525287515!2d35.51091565!3d33.8966774!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x151f16f39369670f%3A0xc3b83c50937c050!2sBeirut%2C%20Lebanon!5e0!3m2!1sen!2sus!4v1715872145678!5m2!1sen!2sus")"></iframe></div>
</div>
</section>
</main>
<!-- Phone Floating Action Button -->
<a href="tel:@callTel" aria-label="Call us" class="fixed bottom-24 right-6 z-50 w-14 h-14 rounded-[50%] bg-slate-blue shadow-2xl flex items-center justify-center hover:scale-110 transition-transform">
<span class="material-symbols-outlined text-white text-[28px]">call</span>
</a>
<!-- WhatsApp Floating Action Button -->
<a href="@Model.Link("fab_whatsapp_url", "https://wa.me/9611123456")" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp" class="fixed bottom-6 right-6 z-50 w-14 h-14 rounded-[50%] bg-[#25D366] shadow-2xl flex items-center justify-center hover:scale-110 transition-transform">
<svg class="w-7 h-7" viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
</a>

@section Scripts {
<script>
    (function() {
        const container = document.getElementById('custom-dropdown-container');
        const trigger = document.getElementById('reason-trigger');
        const panel = document.getElementById('dropdown-panel');
        const chevron = document.getElementById('chevron-icon');
        const input = document.getElementById('reason-input');
        const triggerText = document.getElementById('trigger-text');
        const errorMsg = document.getElementById('dropdown-error');
        const form = container.closest('form');

        const toggleDropdown = () => {
            const isOpen = !panel.classList.contains('hidden');
            if (isOpen) {
                panel.classList.add('opacity-0');
                setTimeout(() => panel.classList.add('hidden'), 200);
                chevron.style.transform = 'rotate(0deg)';
            } else {
                panel.classList.remove('hidden');
                setTimeout(() => panel.classList.remove('opacity-0'), 10);
                chevron.style.transform = 'rotate(180deg)';
            }
        };

        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleDropdown();
        });

        panel.querySelectorAll('li').forEach(option => {
            option.addEventListener('click', () => {
                const val = option.getAttribute('data-value');
                const text = option.textContent;
                input.value = val;
                triggerText.textContent = text;
                triggerText.classList.remove('text-tertiary');
                triggerText.classList.add('text-on-surface');
                errorMsg.classList.add('hidden');
                toggleDropdown();
            });
        });

        document.addEventListener('click', (e) => {
            if (!container.contains(e.target)) {
                panel.classList.add('opacity-0');
                panel.classList.add('hidden');
                chevron.style.transform = 'rotate(0deg)';
            }
        });

        form.addEventListener('submit', (e) => {
            if (!input.value) {
                e.preventDefault();
                errorMsg.classList.remove('hidden');
            }
        });
    })();

    document.querySelectorAll('input, textarea, select').forEach(element => {
        element.addEventListener('blur', (e) => {
            if (e.target.value !== "") {
                e.target.classList.add('has-value');
            } else {
                e.target.classList.remove('has-value');
            }
        });
    });
</script>
}
