@model MiskBeirut.Web.Support.PageContent
@{
    ViewData["Active"] = "spaces";
    Layout = "_PublicLayout";

    var panels = new[]
    {
        (Id: "dining-shisha", DefaultTitle: "Dining & Shisha", DefaultBody: "Placeholder description — elegant dining spaces with authentic Lebanese hospitality, paired with a curated shisha experience. Final copy to be provided by the client.", Icons: new[] { "restaurant", "restaurant", "restaurant", "photo_library" }, Captions: new[] { "Dining Area", "Shisha Lounge", "Evening Ambiance", "More Photos" }),
        (Id: "indoor-outdoor", DefaultTitle: "Indoor & Outdoor Spaces", DefaultBody: "Placeholder description — versatile venues for any gathering, with stunning ambiance inside and out. Final copy to be provided by the client.", Icons: new[] { "location_city", "deck", "yard", "photo_library" }, Captions: new[] { "Indoor Salon", "Outdoor Terrace", "Garden Seating", "More Photos" }),
        (Id: "work-casual", DefaultTitle: "Work & Casual Meetings", DefaultBody: "Placeholder description — a calm environment for studying, working, and informal gatherings. Final copy to be provided by the client.", Icons: new[] { "business_center", "wifi", "coffee", "photo_library" }, Captions: new[] { "Quiet Corners", "Work-Friendly Seating", "Casual Meeting Tables", "More Photos" })
    };
    var tabDefaults = new[] { "Dining & Shisha", "Indoor & Outdoor Spaces", "Work & Casual Meetings" };
}
<!-- PAGE HEADER -->
<section class="relative mt-24 bg-primary-container/10 pt-[80px] pb-stack-lg px-6 md:px-margin-desktop" id="header">
<div class="max-w-[1280px] mx-auto">
<h1 class="font-headline-lg text-headline-lg md:text-display-lg text-onyx-text mb-6">@Model.Text("hero_title", "Our Spaces")</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl">@Model.Text("hero_subtitle", "A place for every moment — from long dinners to quiet mornings")</p>
</div>
<!-- Decorative Element -->
<div class="hero-decorative absolute right-0 top-0 w-1/3 h-full opacity-10 pointer-events-none hidden lg:block">
<img class="w-full h-full object-cover" alt="Architectural detail of a modern Lebanese restaurant interior" src="@Model.Image("hero_image", "https://lh3.googleusercontent.com/aida-public/AB6AXuCrG1HU9jiVr-8Wn2Fm5iex47uAo0h1sHnHlW_uqvIOaesHotr02DT6PDsoSpz2QYySz1W_5Y6jl6ewWoMQGKjhrC0KxodVzbgdRAwS4w8h3FBNDuqvoYfON-hBiR7JuweJvXd8JZ98ruQbemyumsiTQZCwCUFCnoRUU_8oyGSn-yuWU62PZIcVclnmhAmZzexpp81ykRoz5QedPmzUaFaB7xwqdhH_8-iEaeCubM-5UY4gdjQD367JMPITI75ljnUHeXwoqPiil8I")"/>
</div>
</section>

<!-- SPACE TABS -->
<div class="max-w-[1280px] mx-auto px-[20px] md:px-[80px]">
<div class="flex gap-[8px] md:gap-[32px] border-b border-outline/20 overflow-x-auto no-scrollbar" role="tablist" aria-label="Our Spaces">
@for (var i = 1; i <= panels.Length; i++)
{
    var p = panels[i - 1];
    var isFirst = i == 1;
    <button id="tab-@p.Id" role="tab" aria-controls="@p.Id" aria-selected="@(isFirst ? "true" : "false")" onclick="selectTab('@p.Id', true)" class="tab-btn whitespace-nowrap px-4 py-4 font-label-lg text-label-lg uppercase tracking-widest border-b-2 -mb-px transition-colors @(isFirst ? "border-brick-red text-primary font-bold" : "border-transparent text-on-surface-variant hover:text-primary")">@Model.Text($"tab_{i}_label", tabDefaults[i - 1])</button>
}
</div>

@for (var i = 1; i <= panels.Length; i++)
{
    var p = panels[i - 1];
    var isFirst = i == 1;
    <section id="@p.Id" role="tabpanel" aria-labelledby="tab-@p.Id" class="tab-panel py-[60px]@(isFirst ? "" : " hidden")">
        <h2 class="font-display-lg text-headline-lg text-primary mb-[16px]">@Model.Text($"panel_{i}_title", p.DefaultTitle)</h2>
        <!-- PLACEHOLDER: final copy pending from client -->
        <p class="font-body-lg text-body-lg text-on-surface-variant max-w-3xl mb-[48px]">@Model.Text($"panel_{i}_body", p.DefaultBody)</p>
        <div class="carousel-head flex items-center justify-between mb-[16px]">
            <div class="w-16 h-0.5 bg-brick-red"></div>

        </div>
        <div class="flex gap-[16px] overflow-x-auto pb-4 snap-x space-carousel">
        @for (var j = 1; j <= 30; j++)
        {
            var tileImage = Model.Image($"panel_{i}_gallery_{j}_image");
            var hasTile = j <= 3 || !string.IsNullOrEmpty(tileImage);
            if (!hasTile) { continue; }
            var captionDefault = j <= p.Captions.Length ? p.Captions[j - 1] : $"Photo {j}";
            var iconDefault = j <= p.Icons.Length ? p.Icons[j - 1] : p.Icons[p.Icons.Length - 1];
            var tileCaption = Model.Text($"panel_{i}_gallery_{j}_caption", captionDefault);
            <div class="w-[280px] h-[280px] md:w-[340px] md:h-[320px] flex-shrink-0 snap-start bg-slate-blue/10 border border-outline/20 flex items-center justify-center text-on-surface-variant bg-cover bg-center" style="@(string.IsNullOrEmpty(tileImage) ? "" : $"background-image:url('{tileImage}')")">
                @if (string.IsNullOrEmpty(tileImage))
                {
                    <span class="text-center"><span class="material-symbols-outlined text-4xl mb-2 block opacity-50">@iconDefault</span><p class="font-label-lg text-xs">PLACEHOLDER</p><p class="text-xs opacity-60">@tileCaption</p></span>
                }
                else
                {
                    <span class="sr-only">@tileCaption</span>
                }
            </div>
        }
        </div>
    </section>
}

<div class="text-center pb-[80px]">
<a asp-controller="Contact" asp-action="Index" class="bg-brick-red text-white px-12 py-5 font-label-lg text-label-lg uppercase tracking-widest hover:bg-opacity-90 transition-all inline-block">@Model.Text("cta_label", "Reserve a Table")</a>
</div>
</div>

@section Scripts {
<script>
    const SPACE_TABS = ['dining-shisha', 'indoor-outdoor', 'work-casual'];

    function selectTab(id, updateHash) {
        if (SPACE_TABS.indexOf(id) === -1) id = SPACE_TABS[0];
        SPACE_TABS.forEach(function(tabId) {
            const btn = document.getElementById('tab-' + tabId);
            const panel = document.getElementById(tabId);
            const isActive = tabId === id;
            panel.classList.toggle('hidden', !isActive);
            btn.setAttribute('aria-selected', isActive ? 'true' : 'false');
            btn.classList.toggle('border-brick-red', isActive);
            btn.classList.toggle('text-primary', isActive);
            btn.classList.toggle('font-bold', isActive);
            btn.classList.toggle('border-transparent', !isActive);
            btn.classList.toggle('text-on-surface-variant', !isActive);
            btn.classList.toggle('hover:text-primary', !isActive);
        });
        if (updateHash) {
            history.replaceState(null, '', '#' + id);
        }
    }

    function tabFromHash() {
        const hash = window.location.hash.replace('#', '');
        selectTab(hash, false);
    }

    document.addEventListener('DOMContentLoaded', tabFromHash);
    window.addEventListener('hashchange', tabFromHash);
</script>
}
