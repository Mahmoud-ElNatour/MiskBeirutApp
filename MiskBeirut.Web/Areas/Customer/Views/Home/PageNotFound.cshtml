@model MiskBeirut.Web.Support.PageContent
@{
    Layout = "_PublicLayout";
}
<main class="pt-24">
<section class="min-h-[60vh] flex items-center px-6 md:px-margin-desktop py-section-gap">
<div class="max-w-[1280px] mx-auto w-full">
    <p class="font-label-lg text-label-lg uppercase tracking-widest text-brick-red mb-[16px]">404</p>
    <h1 class="font-headline-lg text-headline-lg md:text-display-lg text-onyx-text mb-6">
        @Model.Global("not_found_heading", "This page has moved on", "هذه الصفحة لم تعد موجودة")
    </h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl mb-[48px]">
        @Model.Global("not_found_body", "The page you were looking for isn't here any more. The links below will take you back to the rest of the site.", "الصفحة التي تبحث عنها لم تعد متوفرة. يمكنك العودة إلى بقية الموقع من الروابط أدناه.")
    </p>
    <div class="flex flex-wrap gap-[16px]">
        <a asp-controller="Home" asp-action="Index" class="bg-brick-red text-white px-10 py-4 font-label-lg text-label-lg uppercase tracking-widest hover:bg-opacity-90 transition-all shadow-md">
            @Model.Global("not_found_home_label", "Back to Home", "العودة إلى الرئيسية")
        </a>
        <a asp-controller="Menu" asp-action="Index" class="border border-slate-blue text-slate-blue px-10 py-4 font-label-lg text-label-lg uppercase tracking-widest hover:bg-slate-blue hover:text-white transition-colors">
            @Model.Global("nav_menu", "Menu", "قائمة الطعام")
        </a>
        <a asp-controller="Contact" asp-action="Index" class="border border-slate-blue text-slate-blue px-10 py-4 font-label-lg text-label-lg uppercase tracking-widest hover:bg-slate-blue hover:text-white transition-colors">
            @Model.Global("nav_contact", "Reservations", "الحجوزات")
        </a>
    </div>
</div>
</section>
</main>
