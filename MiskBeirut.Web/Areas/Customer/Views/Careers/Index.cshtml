@using MiskBeirut.Application.Dtos.Careers
@using MiskBeirut.Core.Constants
@model MiskBeirut.Web.Support.PageContent
@{
    ViewData["Active"] = "careers";
    Layout = "_PublicLayout";

    var vacancies = ViewData["Vacancies"] as IReadOnlyList<VacancyDto> ?? Array.Empty<VacancyDto>();
    var isCmsPreview = ViewData["IsCmsPreview"] as bool? == true;
    var valueStrip = new[]
    {
        ("trending_up", "Career Growth"),
        ("diversity_3", "Diverse Culture"),
        ("payments", "Competitive Benefits"),
        ("restaurant", "Culinary Excellence")
    };

    const string applyInputClass = "w-full bg-transparent border-b border-slate-blue/30 py-2 form-input-focus transition-all";
    const string applyLabelClass = "font-label-lg text-label-lg uppercase block mb-1";
    const string applyErrorClass = "field-error hidden text-sm text-brick-red mt-1";
}
<main class="pt-24">
<!-- Hero Header -->
<section class="relative bg-primary-container/10 pt-[80px] pb-stack-lg px-6 md:px-margin-desktop">
<div class="max-w-[1280px] mx-auto">
    <h1 class="font-headline-lg text-headline-lg md:text-display-lg text-onyx-text mb-6" data-cms-field="hero_title" data-cms-type="Text">@Model.Text("hero_title", "Careers at Misk Beirut")</h1>
<p class="font-body-lg text-body-lg text-on-surface-variant max-w-2xl" data-cms-field="hero_subtitle" data-cms-type="Text">
                    @Model.Text("hero_subtitle", "Join a team dedicated to redefining Mediterranean hospitality. We seek visionaries, artisans, and professionals who share our passion for excellence and Levantine culture.")
                </p>
</div>
<!-- Decorative Element -->
<div class="hero-decorative absolute right-0 top-0 w-1/3 h-full opacity-40 pointer-events-none hidden lg:block">
<img class="w-full h-full object-cover" alt="Architectural detail of a modern Lebanese restaurant interior" data-cms-field="hero_image" data-cms-type="Image" src="@Model.Image("hero_image", "https://lh3.googleusercontent.com/aida-public/AB6AXuCrG1HU9jiVr-8Wn2Fm5iex47uAo0h1sHnHlW_uqvIOaesHotr02DT6PDsoSpz2QYySz1W_5Y6jl6ewWoMQGKjhrC0KxodVzbgdRAwS4w8h3FBNDuqvoYfON-hBiR7JuweJvXd8JZ98ruQbemyumsiTQZCwCUFCnoRUU_8oyGSn-yuWU62PZIcVclnmhAmZzexpp81ykRoz5QedPmzUaFaB7xwqdhH_8-iEaeCubM-5UY4gdjQD367JMPITI75ljnUHeXwoqPiil8I")"/>
</div>
</section>
<!-- Value Strip -->
<section class="py-stack-lg border-b border-on-surface/10 px-6 md:px-margin-desktop">
<div class="max-w-[1280px] mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-gutter">
@for (var i = 1; i <= valueStrip.Length; i++)
{
    var (icon, defaultLabel) = valueStrip[i - 1];
    <div class="flex flex-col items-center text-center p-6 backdrop-blur transition-colors duration-300">
        <span class="material-symbols-outlined text-brick-red text-4xl mb-4">@icon</span>
        <h3 class="font-label-lg text-label-lg uppercase" data-cms-field="value_strip_@(i)_label" data-cms-type="Text">@Model.Text($"value_strip_{i}_label", defaultLabel)</h3>
    </div>
}
</div>
</section>
<!-- Vacancies -->
<section class="py-section-gap px-6 md:px-margin-desktop bg-marble-white">
<div class="max-w-[1280px] mx-auto">
<div class="flex items-center gap-6 mb-stack-lg">
<h2 class="font-headline-md text-headline-md whitespace-nowrap" data-cms-field="vacancies_title" data-cms-type="Text">@Model.Text("vacancies_title", "Open Positions")</h2>
<div class="h-[1px] w-full bg-brick-red/20"></div>
</div>
<div class="grid grid-cols-1 gap-6">
@foreach (var v in vacancies)
{
    <div class="vacancy-item group">
        <div class="bg-white p-8 md:p-12 shadow-sm flex flex-col md:flex-row justify-between items-start md:items-center gap-6 hover:shadow-md transition-shadow">
            <div>
                <h3 class="font-headline-md text-headline-md mb-2">@v.Title</h3>
                <div class="flex flex-wrap gap-4 text-on-surface-variant font-label-sm uppercase tracking-wider">
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">@v.Icon</span> @v.Department</span>
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">location_on</span> @v.Location</span>
                    <span class="flex items-center gap-1"><span class="material-symbols-outlined text-sm">schedule</span> @v.EmploymentType</span>
                </div>
            </div>
            <button class="bg-slate-blue text-white px-8 py-3 font-label-lg text-label-lg uppercase tracking-widest hover:bg-brick-red transition-colors w-full md:w-auto" data-cms-field="apply_now_label" data-cms-type="Text" onclick="toggleApplication('@v.Slug')">@Model.Text("apply_now_label", "Apply Now")</button>
        </div>
        <div class="max-height-0 overflow-hidden opacity-0 transition-form bg-white px-8 md:px-12 border-t border-slate-blue/10" id="form-@v.Slug">
            @* rtl-form right-aligns the labels and inputs for Arabic — see _PublicLayout.cshtml. *@
            <form class="job-application-form rtl-form py-stack-lg space-y-8 max-w-3xl mx-auto" novalidate
                  data-vacancy-slug="@v.Slug"
                  data-cms-preview="@(isCmsPreview ? "1" : "0")"
                  data-phone-pattern="@ValidationPatterns.PhoneNumber"
                  data-email-pattern="@ValidationPatterns.Email"
                  data-preview-message="@Model.Text("preview_notice", "Preview mode — applications are not submitted from the CMS.", "وضع المعاينة — لا تُرسل الطلبات من نظام إدارة المحتوى.")"
                  data-msg-name="@Model.Text("error_full_name", "Please enter your full name.", "يرجى إدخال اسمك الكامل.")"
                  data-msg-phone="@Model.Text("error_phone", "Please enter a valid phone number — digits only, e.g. +961 3 123 456.", "يرجى إدخال رقم هاتف صحيح — أرقام فقط، مثال: +961 3 123 456.")"
                  data-msg-email="@Model.Text("error_email", "Please enter a valid email address.", "يرجى إدخال بريد إلكتروني صحيح.")"
                  data-msg-cv="@Model.Text("error_cv", "Please attach your CV as a PDF (5 MB or smaller).", "يرجى إرفاق سيرتك الذاتية بصيغة PDF (بحجم 5 ميغابايت أو أقل).")"
                  data-msg-generic="@Model.Text("error_generic", "Something went wrong. Please try again.", "حدث خطأ ما. يرجى المحاولة مرة أخرى.")"
                  data-msg-offline="@Model.Text("error_offline", "Something went wrong. Please check your connection and try again.", "حدث خطأ ما. يرجى التحقق من اتصالك والمحاولة مرة أخرى.")"
                  enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" name="VacancyId" value="@v.Id"/>
                <h4 class="font-headline-md text-headline-md mb-4"><span data-cms-field="apply_prefix_label" data-cms-type="Text">@Model.Text("apply_prefix_label", "Application for", "طلب توظيف لوظيفة")</span> @v.Title</h4>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="relative">
                        <label class="@applyLabelClass" data-cms-field="form_field_full_name" data-cms-type="Text">@Model.Text("form_field_full_name", "Full Name", "الاسم الكامل")</label>
                        <input class="@applyInputClass" data-cms-field="form_placeholder_name" data-cms-type="Placeholder" placeholder="@Model.Text("form_placeholder_name", "YOUR NAME", "اسمك")" name="Name" required type="text" maxlength="@FieldLengths.Name"/>
                        <p class="@applyErrorClass" data-error-for="Name"></p>
                    </div>
                    <div class="relative">
                        <label class="@applyLabelClass" data-cms-field="form_field_phone" data-cms-type="Text">@Model.Text("form_field_phone", "Phone Number", "رقم الهاتف")</label>
                        <input class="@applyInputClass" data-cms-field="form_placeholder_phone" data-cms-type="Placeholder" placeholder="@Model.Text("form_placeholder_phone", "+961 00 000 000")" name="PhoneNumber" required type="tel" inputmode="tel" pattern="@ValidationPatterns.PhoneNumber" maxlength="@FieldLengths.PhoneNumber"/>
                        <p class="@applyErrorClass" data-error-for="PhoneNumber"></p>
                    </div>
                </div>
                <div class="relative">
                    <label class="@applyLabelClass" data-cms-field="form_field_email" data-cms-type="Text">@Model.Text("form_field_email", "Email Address", "البريد الإلكتروني")</label>
                    <input class="@applyInputClass" data-cms-field="form_placeholder_email" data-cms-type="Placeholder" placeholder="@Model.Text("form_placeholder_email", "EMAIL@EXAMPLE.COM")" name="Email" required type="email" inputmode="email" pattern="@ValidationPatterns.Email" maxlength="@FieldLengths.Email"/>
                    <p class="@applyErrorClass" data-error-for="Email"></p>
                </div>
                <div class="relative">
                    <label class="@applyLabelClass" data-cms-field="form_field_address" data-cms-type="Text">@Model.Text("form_field_address", "Address", "العنوان")</label>
                    <input class="@applyInputClass" data-cms-field="form_placeholder_address" data-cms-type="Placeholder" placeholder="@Model.Text("form_placeholder_address", "YOUR ADDRESS", "عنوانك")" name="Address" type="text" maxlength="@FieldLengths.Address"/>
                    <p class="@applyErrorClass" data-error-for="Address"></p>
                </div>
                <div class="relative">
                    <label class="font-label-lg text-label-lg uppercase block mb-2" data-cms-field="form_field_upload_cv" data-cms-type="Text">@Model.Text("form_field_upload_cv", "Upload CV (PDF)", "تحميل السيرة الذاتية (PDF)")</label>
                    <input class="block w-full text-sm text-slate-blue file:mr-4 file:py-2 file:px-4 file:rounded-none file:border-0 file:text-sm file:font-label-lg file:bg-slate-blue/10 file:text-slate-blue hover:file:bg-slate-blue/20 cursor-pointer" name="Cv" accept="application/pdf" required type="file"/>
                    <p class="@applyErrorClass" data-error-for="Cv"></p>
                </div>
                <p class="application-error hidden text-sm text-brick-red"></p>
                <p class="application-success hidden text-sm text-emerald-700" data-cms-field="apply_success_message" data-cms-type="Text">@Model.Text("apply_success_message", "Thank you! Your application has been received.", "شكراً لك! تم استلام طلبك.")</p>
                <button class="bg-brick-red text-white px-12 py-4 font-label-lg text-label-lg uppercase tracking-widest hover:opacity-90 transition-opacity" data-cms-field="submit_label" data-cms-type="Text" type="submit">@Model.Text("submit_label", "Submit Application", "إرسال الطلب")</button>
            </form>
        </div>
    </div>
}
</div>
</div>
</section>
<!-- Newsletter / Culture Teaser -->
<section class="grid grid-cols-1 md:grid-cols-2 items-stretch">
<div class="bg-slate-blue text-white p-12 md:p-24 flex flex-col justify-center">
<h2 class="font-headline-lg text-headline-lg mb-6" data-cms-field="culture_title" data-cms-type="Text">@Model.Text("culture_title", "Our Culture")</h2>
<p class="font-body-lg text-body-lg mb-8 opacity-90" data-cms-field="culture_body" data-cms-type="Text">@Model.Text("culture_body", "At Misk Beirut, we believe the best experiences are built by those who value hospitality as an art form. We provide a space where talent is nurtured and culinary dreams are realized.")</p>
</div>
<div class="min-h-[400px]">
<img class="w-full h-full object-cover" alt="Culinary team collaborating in a modern luxury kitchen" data-cms-field="culture_image" data-cms-type="Image" src="@Model.Image("culture_image", "https://lh3.googleusercontent.com/aida-public/AB6AXuBm3jJoNgH5s_rjzKLIalc1OKH9G55ORI52lhD7OeGph-n2gcT5dekQLAYWRpwCa12EvucvrjYgo0cCAG4lDJlj96TyCKzg8f1jJQZQ3VlcJa6BHfZ5cU85A4Z6drunWobaEUcuTeigHzlJKfNOwoW1JK5Th93ZwxpQU9N_SGCu9992NM3FTarqoG2q5zLSNpDJ3MPGjG_8XcUdxCpAFMUPJy0lgcKypJMN5tDH2ca6Av5415pdZeIZGYMYl7u9kVHG2ppuQ0DY5vI")"/>
</div>
</section>
</main>

@section Scripts {
<script>
    function toggleApplication(id) {
        const form = document.getElementById('form-' + id);
        const allForms = document.querySelectorAll('.transition-form');

        allForms.forEach(f => {
            if (f.id !== 'form-' + id) {
                f.style.maxHeight = '0px';
                f.style.opacity = '0';
                f.classList.remove('py-stack-lg');
            }
        });

        if (form.style.maxHeight === '0px' || !form.style.maxHeight) {
            form.style.maxHeight = '2000px';
            form.style.opacity = '1';
            form.classList.add('py-stack-lg');
        } else {
            form.style.maxHeight = '0px';
            form.style.opacity = '0';
            form.classList.remove('py-stack-lg');
        }
        // CMS preview: the expand/collapse is animated, so reposition pencils once it settles.
        if (window.cmsRelayoutOverlay) setTimeout(window.cmsRelayoutOverlay, 550);
    }

    document.addEventListener('DOMContentLoaded', () => {
        const forms = document.querySelectorAll('.transition-form');
        forms.forEach(f => {
            f.style.maxHeight = '0px';
            f.style.opacity = '0';
        });

        const MAX_CV_BYTES = 5 * 1024 * 1024; // must match MaxCvSizeBytes in CareersController

        document.querySelectorAll('.job-application-form').forEach(form => {
            const d = form.dataset;
            const phonePattern = new RegExp(d.phonePattern);
            const emailPattern = new RegExp(d.emailPattern);

            function errorEl(field) {
                return form.querySelector('[data-error-for="' + field + '"]');
            }

            function showFieldError(field, message) {
                const el = errorEl(field);
                if (!el) return;
                el.textContent = message;
                el.classList.remove('hidden');
            }

            function clearFieldErrors() {
                form.querySelectorAll('.field-error').forEach(function (el) {
                    el.textContent = '';
                    el.classList.add('hidden');
                });
            }

            // Same rules as JobApplicationRequest server-side, so a mistyped phone number or a CV
            // that is too large is named on the field itself instead of coming back as one generic
            // sentence under the whole form.
            function validate() {
                const problems = {};
                const name = form.elements['Name'].value.trim();
                const phone = form.elements['PhoneNumber'].value.trim();
                const email = form.elements['Email'].value.trim();
                const cv = form.elements['Cv'].files[0];

                if (!name) problems.Name = d.msgName;
                if (!phone || !phonePattern.test(phone)) problems.PhoneNumber = d.msgPhone;
                if (!email || !emailPattern.test(email)) problems.Email = d.msgEmail;
                if (!cv || cv.size === 0 || cv.size > MAX_CV_BYTES) problems.Cv = d.msgCv;
                return problems;
            }

            ['Name', 'PhoneNumber', 'Email', 'Cv'].forEach(function (field) {
                const control = form.elements[field];
                if (!control) return;
                const revalidate = function () {
                    const el = errorEl(field);
                    if (!el || el.classList.contains('hidden')) return;
                    if (!validate()[field]) el.classList.add('hidden');
                };
                control.addEventListener('blur', revalidate);
                control.addEventListener('change', revalidate);
            });

            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (form.dataset.cmsPreview === '1') {
                    alert(d.previewMessage);
                    return;
                }
                const errorBox = form.querySelector('.application-error');
                const successEl = form.querySelector('.application-success');
                const submitBtn = form.querySelector('button[type="submit"]');
                errorBox.classList.add('hidden');
                successEl.classList.add('hidden');
                clearFieldErrors();

                const problems = validate();
                const problemFields = Object.keys(problems);
                if (problemFields.length > 0) {
                    problemFields.forEach(function (field) { showFieldError(field, problems[field]); });
                    const firstControl = form.elements[problemFields[0]];
                    if (firstControl && firstControl.focus) firstControl.focus();
                    return;
                }

                submitBtn.disabled = true;

                fetch('@Url.Action("Apply", "Careers")', { method: 'POST', body: new FormData(form) })
                    .then(async response => {
                        if (response.ok) {
                            successEl.classList.remove('hidden');
                            form.reset();
                            return;
                        }
                        const data = await response.json().catch(() => null);
                        if (data && data.errors) {
                            Object.keys(data.errors).forEach(function (field) { showFieldError(field, data.errors[field]); });
                        }
                        errorBox.textContent = (data && data.message) || d.msgGeneric;
                        errorBox.classList.remove('hidden');
                    })
                    .catch(() => {
                        errorBox.textContent = d.msgOffline;
                        errorBox.classList.remove('hidden');
                    })
                    .finally(() => {
                        submitBtn.disabled = false;
                    });
            });
        });
    });
</script>
}
