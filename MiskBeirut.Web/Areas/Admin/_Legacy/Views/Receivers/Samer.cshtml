@model IEnumerable<MiskBeirut.Application.DTOs.SamerExpenseReceiversDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Samer Receivers Management";
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Samer Receivers Management</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-1">Manage and view all Samer payment recipients.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto pb-2">
        <a href="/System/ControlPanel" class="inline-flex justify-center items-center gap-2 px-4 py-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors w-full sm:w-auto">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back
        </a>
        <button type="button" data-bs-toggle="modal" data-bs-target="#addSamerReceiverModal" class="inline-flex justify-center items-center gap-2 px-4 py-2 bg-primary hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-colors shadow-sm shadow-primary/30 w-full sm:w-auto">
            <span class="material-symbols-outlined text-sm">person_add</span>
            Add Receiver
        </button>
    </div>
</div>

<!-- Receivers Table -->
<div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden mb-6">
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm whitespace-nowrap">
            <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400">
                <tr>
                    <th class="px-6 py-4 font-semibold w-24" data-sort="number">ID</th>
                    <th class="px-6 py-4 font-semibold" data-sort="text">Name</th>
                    <th class="px-6 py-4 font-semibold text-right" data-sort="number">All-Time Record</th>
                    <th class="px-6 py-4 font-semibold text-center w-28">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200 dark:divide-slate-800 font-medium">
                @if (Model != null && Model.Any())
                {
                    @foreach (var receiver in Model)
                    {
                        <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                            <td class="px-6 py-4 text-slate-500 dark:text-slate-400 font-mono">#@receiver.Id.ToString("D4")</td>
                            <td class="px-6 py-4 text-slate-900 dark:text-white font-semibold flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700 shrink-0">
                                    <span class="material-symbols-outlined text-sm">person</span>
                                </div>
                                @receiver.Name
                            </td>
                            <td class="px-6 py-4 text-right">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-slate-50 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400 border border-transparent font-mono text-xs">
                                    <span class="text-slate-400">$</span>@receiver.PaidAmount.ToString("F2")
                                </span>
                            </td>
                            <td class="px-6 py-4 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <button onclick="editSamerReceiver('@receiver.Id')" class="p-1.5 text-blue-600 hover:bg-blue-50 dark:text-blue-400 dark:hover:bg-blue-900/20 rounded transition-colors" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </button>
                                    <button onclick="deleteSamerReceiver('@receiver.Id')" class="p-1.5 text-red-600 hover:bg-red-50 dark:text-red-400 dark:hover:bg-red-900/20 rounded transition-colors" title="Delete">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400 border-t border-slate-200 dark:border-slate-800">
                            <div class="flex flex-col items-center justify-center">
                                <span class="material-symbols-outlined text-4xl mb-3 text-slate-300 dark:text-slate-600">group_off</span>
                                <p class="text-base font-medium">No receivers found</p>
                                <p class="text-sm mt-1">Register a new Samer receiver to start tracking payments.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Receiver Modal -->
<div class="modal fade" id="addSamerReceiverModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-white dark:bg-slate-900 border-none rounded-2xl shadow-2xl overflow-hidden">
            <div class="modal-header border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 px-6 py-4">
                <h5 class="modal-title text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">person_add</span>
                    Add New Samer Receiver
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="addSamerReceiverForm">
                <div class="modal-body px-6 py-6 space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Receiver Name</label>
                        <input type="text" name="name" required placeholder="Enter name..." class="w-full rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-primary focus:border-primary text-sm px-4 py-2" />
                    </div>
                </div>
                <div class="modal-footer border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 px-6 py-4">
                    <button type="button" class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary/95 text-white rounded-lg text-sm font-medium transition-colors shadow-sm shadow-primary/20">Add Receiver</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Receiver Modal -->
<div class="modal fade" id="editSamerReceiverModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-white dark:bg-slate-900 border-none rounded-2xl shadow-2xl overflow-hidden">
            <div class="modal-header border-b border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 px-6 py-4">
                <h5 class="modal-title text-lg font-bold text-slate-900 dark:text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">edit</span>
                    Edit Samer Receiver
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="editSamerReceiverForm">
                <input type="hidden" name="id" id="edit-samer-receiver-id">
                <div class="modal-body px-6 py-6 space-y-5">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Receiver Name</label>
                        <input type="text" name="name" id="edit-samer-receiver-name" required class="w-full rounded-lg border-slate-200 dark:border-slate-700 dark:bg-slate-800 text-slate-900 dark:text-white focus:ring-primary focus:border-primary text-sm px-4 py-2" />
                    </div>
                </div>
                <div class="modal-footer border-t border-slate-100 dark:border-slate-800 bg-slate-50/50 dark:bg-slate-800/50 px-6 py-4">
                    <button type="button" class="px-4 py-2 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary/95 text-white rounded-lg text-sm font-medium transition-colors shadow-sm shadow-primary/20">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.getElementById('addSamerReceiverForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const submitBtn = this.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        const data = Object.fromEntries(new FormData(this));
        data.paidAmount = 0;

        fetch('/api/samer-receivers', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(res => {
            if (res.status === 'success') location.reload();
            else { alert('Error: ' + (res.message || res.error)); submitBtn.disabled = false; }
        })
        .catch(() => { alert('Error adding receiver'); submitBtn.disabled = false; });
    });

    function editSamerReceiver(id) {
        fetch(`/api/Receivers/samer/${id}`)
        .then(r => r.json())
        .then(data => {
            document.getElementById('edit-samer-receiver-id').value = data.id;
            document.getElementById('edit-samer-receiver-name').value = data.name;
            new bootstrap.Modal(document.getElementById('editSamerReceiverModal')).show();
        })
        .catch(() => alert('Error loading receiver data'));
    }

    document.getElementById('editSamerReceiverForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const submitBtn = this.querySelector('button[type="submit"]');
        submitBtn.disabled = true;
        const id = document.getElementById('edit-samer-receiver-id').value;
        const data = Object.fromEntries(new FormData(this));
        data.id = parseInt(id);

        fetch(`/api/samer-receivers/${id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
        })
        .then(r => r.json())
        .then(res => {
            if (res.status === 'success') location.reload();
            else { alert('Error: ' + (res.message || res.error)); submitBtn.disabled = false; }
        })
        .catch(() => { alert('Error updating receiver'); submitBtn.disabled = false; });
    });

    async function deleteSamerReceiver(id) {
        if (!confirm('Are you sure you want to delete this receiver?')) return;
        try {
            const res = await fetch(`/api/samer-receivers/${id}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' }
            });
            const result = await res.json();
            if (result.status === 'success') location.reload();
            else alert(result.message || 'Failed to delete receiver');
        } catch { alert('An error occurred'); }
    }
</script>
}
