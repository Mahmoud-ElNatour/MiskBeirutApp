@model IEnumerable<MiskBeirut.Application.DTOs.MenuCategoryDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Menu";
    var phoneTel = ViewData["PhoneTel"] as string ?? "";
    var whatsappDigits = ViewData["WhatsappDigits"] as string ?? "";
    var instagramUrl = ViewData["InstagramUrl"] as string ?? "";
    var mapsUrl = ViewData["MapsUrl"] as string ?? "";
    var address = ViewData["Address"] as string ?? "Beirut, Coastal Road, Lebanon";
}

@section ExtraHead {
<style>
    .hide-scrollbar::-webkit-scrollbar {
        display: none;
    }

    .hide-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

    .sticky-nav {
        backdrop-filter: blur(8px);
        background-color: rgba(255, 255, 255, 0.9);
    }
    
    .dark .sticky-nav {
        background-color: rgba(18, 21, 32, 0.9);
    }
</style>
}

<!-- Header Section -->
<section class="bg-sky-50 dark:bg-slate-900/40 py-16 px-4 text-center rounded-2xl border border-sky-100/50 dark:border-slate-800 mb-10">
    <div class="max-w-3xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 dark:text-blue-400 mb-4 font-display">Our Menu</h1>
        <p class="text-slate-600 dark:text-slate-400 text-lg mb-8 italic">Experience the authentic flavors of Beirut in every bite.</p>
        <div class="flex flex-wrap justify-center gap-4">
            <a class="flex items-center gap-2 bg-white dark:bg-slate-800 border border-blue-900/10 px-5 py-2.5 rounded-full text-blue-900 dark:text-blue-400 font-medium hover:bg-blue-900 hover:text-white dark:hover:bg-blue-800 dark:hover:text-white transition"
               href="tel:@(string.IsNullOrEmpty(phoneTel) ? "+9611234567" : phoneTel)">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                </svg>
                Call Us
            </a>
            <a class="flex items-center gap-2 bg-white dark:bg-slate-800 border border-blue-900/10 px-5 py-2.5 rounded-full text-blue-900 dark:text-blue-400 font-medium hover:bg-blue-900 hover:text-white dark:hover:bg-blue-800 dark:hover:text-white transition"
               href="https://wa.me/@(string.IsNullOrEmpty(whatsappDigits) ? "9611234567" : whatsappDigits)" target="_blank">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 448 512">
                    <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-5.5-2.8-23.4-8.6-44.6-27.5-16.4-14.7-27.5-32.8-30.7-38.4-3.2-5.5-.3-8.6 2.5-11.3 2.5-2.5 5.5-6.5 8.3-9.8 2.8-3.3 3.7-5.5 5.5-9.3 1.9-3.7.9-6.9-.5-9.8-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 13.2 5.8 23.5 9.2 31.5 11.8 13.3 4.2 25.4 3.6 35 2.2 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"></path>
                </svg>
                WhatsApp
            </a>
            <a class="flex items-center gap-2 bg-white dark:bg-slate-800 border border-blue-900/10 px-5 py-2.5 rounded-full text-blue-900 dark:text-blue-400 font-medium hover:bg-blue-900 hover:text-white dark:hover:bg-blue-800 dark:hover:text-white transition"
               href="@(string.IsNullOrEmpty(mapsUrl) ? "#" : mapsUrl)" @(string.IsNullOrEmpty(mapsUrl) ? "" : "target=\"_blank\"")>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                    <path d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path>
                </svg>
                Directions
            </a>
            <a class="flex items-center gap-2 bg-white dark:bg-slate-800 border border-blue-900/10 px-5 py-2.5 rounded-full text-blue-900 dark:text-blue-400 font-medium hover:bg-blue-900 hover:text-white dark:hover:bg-blue-800 dark:hover:text-white transition"
               href="@(string.IsNullOrEmpty(instagramUrl) ? "#" : instagramUrl)" @(string.IsNullOrEmpty(instagramUrl) ? "" : "target=\"_blank\"")>
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 448 512">
                    <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12.2 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"></path>
                </svg>
                Instagram
            </a>
        </div>
    </div>
</section>

<!-- Search & Filter -->
<section class="mb-8" data-purpose="search-filters">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-slate-200 dark:border-slate-800 pb-6">
        <div class="relative w-full md:max-w-md">
            <input id="searchInput"
                   class="w-full pl-12 pr-4 py-3 rounded-xl border-slate-200 dark:border-slate-800 dark:bg-slate-900 text-slate-800 dark:text-slate-100 focus:ring-primary focus:border-primary text-sm"
                   placeholder="Search for dishes..." type="text" />
            <div class="absolute left-4 top-3.5 text-slate-400">
                <span class="material-symbols-outlined text-xl">search</span>
            </div>
        </div>
    </div>
</section>

<!-- Category Navigation -->
<section class="sticky top-16 bg-white/80 dark:bg-background-dark/80 backdrop-blur-md z-40 border-b border-slate-200 dark:border-slate-800 py-4 mb-10 overflow-x-auto hide-scrollbar" data-purpose="category-tabs">
    <div class="flex items-center gap-3">
        @foreach (var category in Model.OrderBy(c => c.SortOrder))
        {
            @if (category.IsActive && category.Items != null && category.Items.Any(i => i.IsActive))
            {
                <a class="whitespace-nowrap px-6 py-2 rounded-full border border-sky-200 dark:border-slate-800 bg-sky-50/50 dark:bg-slate-800/40 text-blue-900 dark:text-blue-400 text-sm font-semibold hover:bg-sky-100 transition-colors"
                   href="#cat-@category.Id">
                    @category.Name
                </a>
            }
        }
    </div>
</section>

<!-- Menu Items Content -->
<section class="py-4" data-purpose="menu-grid">
    @{
        var hasActiveItems = Model.Any(c => c.IsActive && c.Items != null && c.Items.Any(i => i.IsActive));
    }

    @if (hasActiveItems)
    {
        @foreach (var category in Model.Where(c => c.IsActive).OrderBy(c => c.SortOrder))
        {
            @if (category.Items != null && category.Items.Any(i => i.IsActive))
            {
                <div class="mb-16 scroll-mt-32" id="cat-@category.Id">
                    <div class="flex items-center gap-4 mb-6">
                        <h2 class="text-2xl font-bold text-slate-900 dark:text-white font-display">@category.Name</h2>
                        <div class="h-px flex-grow bg-slate-200 dark:bg-slate-800"></div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        @foreach (var item in category.Items.Where(i => i.IsActive).OrderBy(i => i.SortOrder))
                        {
                            <!-- Menu Item Card -->
                            <div class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 overflow-hidden shadow-sm flex flex-col hover:-translate-y-1 hover:shadow-md transition-all duration-300"
                                 data-purpose="menu-item" data-name="@item.Name.ToLower()"
                                 data-available="@(item.IsAvailable ? "true" : "false")">
                                <!-- Item Image -->
                                <div class="aspect-video overflow-hidden bg-slate-100 dark:bg-slate-800 relative">
                                    <img alt="@item.Name" class="w-full h-full object-cover"
                                         src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://lh3.googleusercontent.com/aida-public/AB6AXuAEtCK8DL0gJewSfUR3ClcXz4jItGX0Ayx7whDU9z7ta6FO60biwd7y2lZ_HuCDn_FaPgC30a6gU4MHIWR0KDvotsQ1aIQd0b35O9bVvg6NNdQrp-FP2RbpEQBdtqJrDq2_5ZN6B6gXuJSXu2vZx0bTX6XSBwpVG25Tm1fjXTsFg4j9GQ6wnuwIp9oV-JZikHZuIZZUhztRRCBGxA_owdKxBfNAXHHsPxXWPw8h8Lhw3jVMpL5j8a2mqs8_Fdc_y_dW7DZRLE704NM" : item.ImageUrl)" />
                                    <!-- Status Badge -->
                                    <div class="absolute top-4 right-4">
                                        @if (item.IsAvailable)
                                        {
                                            <span class="bg-green-100 dark:bg-green-950/40 text-green-700 dark:text-green-400 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-md border border-green-200 dark:border-green-800/50">AVAILABLE</span>
                                        }
                                        else
                                        {
                                            <span class="bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 text-[10px] font-bold uppercase tracking-widest px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700">SOLD OUT</span>
                                        }
                                    </div>
                                </div>
                                <!-- Item Details -->
                                <div class="p-6 flex flex-col flex-grow">
                                    <div class="flex justify-between items-start mb-2 gap-4">
                                        <h3 class="text-lg font-bold text-slate-900 dark:text-white leading-tight">@item.Name</h3>
                                        <span class="text-primary dark:text-blue-400 font-extrabold text-lg shrink-0">$@item.Price.ToString("F2")</span>
                                    </div>
                                    <p class="text-slate-500 dark:text-slate-400 text-sm leading-relaxed mb-4 flex-grow">
                                        @item.Description
                                    </p>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }
    else
    {
        <!-- Empty State -->
        <div class="text-center py-24 bg-slate-50 dark:bg-slate-900/50 rounded-3xl border-2 border-dashed border-slate-200 dark:border-slate-800"
             data-purpose="empty-menu-state">
            <div class="mb-6">
                <span class="material-symbols-outlined text-5xl text-slate-300 dark:text-slate-700">restaurant_menu</span>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Menu coming soon</h3>
            <p class="text-slate-500 dark:text-slate-400 max-w-sm mx-auto">We're currently updating our selections. Check back shortly for new flavors!</p>
        </div>
    }
</section>

@section Scripts {
<script>
    // Smooth scrolling for category links
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            if (this.getAttribute('href') === '#') return;
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
                target.scrollIntoView({
                    behavior: 'smooth'
                });
            }
        });
    });

    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('searchInput');

        const filterItems = (searchTerm) => {
            document.querySelectorAll('[data-purpose="menu-item"]').forEach(item => {
                const itemName = item.getAttribute('data-name') || '';

                if (itemName.includes(searchTerm)) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });

            // Hide category headings if empty
            document.querySelectorAll('.scroll-mt-32').forEach(cat => {
                const visibleItems = Array.from(cat.querySelectorAll('[data-purpose="menu-item"]'))
                    .filter(item => item.style.display !== 'none');
                if (visibleItems.length === 0) {
                    cat.style.display = 'none';
                } else {
                    cat.style.display = 'block';
                }
            });
        };

        if (searchInput) {
            searchInput.addEventListener('input', (e) => {
                filterItems(e.target.value.toLowerCase());
            });
        }
    });
</script>
}
