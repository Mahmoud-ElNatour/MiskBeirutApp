@model (List<MiskBeirut.Core.Entities.Advances> Advances, List<MiskBeirut.Core.Entities.Deductions> Deductions)
@{
    Layout = "_Layout";
    ViewData["Title"] = "Deductions & Advances";
    var currentMonth = ViewData["CurrentMonth"] as int? ?? DateTime.UtcNow.Month;
    var currentYear = ViewData["CurrentYear"] as int? ?? DateTime.UtcNow.Year;
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-8">
    <div>
        <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Deductions & Advances</h1>
        <p class="text-slate-500 dark:text-slate-400 mt-1">Itemized list of all employee salary adjustments.</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto pb-2">
        <a href="/System/ControlPanel"
            class="inline-flex justify-center items-center gap-2 px-4 py-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back
        </a>
        <select id="filterMonth"
            class="rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm focus:ring-primary focus:border-primary text-slate-700 dark:text-slate-300">
            <option value="">All Months</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == currentMonth ? "selected" : null)">
                    @(new DateTime(2000, m, 1).ToString("MMMM"))
                </option>
            }
        </select>
        <select id="filterYear"
            class="rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 text-sm focus:ring-primary focus:border-primary text-slate-700 dark:text-slate-300">
            <option value="">All Years</option>
            @for (int y = 2023; y <= 2030; y++)
            {
                <option value="@y" selected="@(y == currentYear ? "selected" : null)">@y</option>
            }
        </select>
        <button onclick="applyFilters()"
            class="inline-flex justify-center items-center gap-2 px-4 py-2 bg-white dark:bg-slate-800 border border-slate-300 dark:border-slate-700 rounded-lg text-sm font-medium text-slate-700 dark:text-slate-300 hover:bg-slate-50 dark:hover:bg-slate-700/50 transition-colors">
            <span class="material-symbols-outlined text-sm">filter_list</span>
            Filter
        </button>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
    <!-- Advances Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden flex flex-col h-full">
        <div class="bg-primary px-6 py-4 flex justify-between items-center shrink-0">
            <h5 class="text-white font-semibold m-0 flex items-center gap-2">
                <span class="material-symbols-outlined">payments</span>
                Advances
            </h5>
            <span class="bg-white/20 text-white text-xs font-medium px-2.5 py-1 rounded-full border border-white/20">@Model.Advances.Count() Records</span>
        </div>
        <div class="overflow-x-auto flex-1 h-full">
            <table class="w-full text-left text-sm whitespace-nowrap h-full">
                <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 sticky top-0">
                    <tr>
                        <th class="px-6 py-3 font-semibold" data-sort="date">Date</th>
                        <th class="px-6 py-3 font-semibold" data-sort="text">Employee</th>
                        <th class="px-6 py-3 font-semibold text-right" data-sort="number">Amount</th>
                        <th class="px-6 py-3 font-semibold flex-1">Note</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800 align-top">
                    @if (Model.Advances.Any())
                    {
                        foreach (var adv in Model.Advances)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                <td class="px-6 py-3 text-slate-500 dark:text-slate-400 font-medium">@adv.Date.ToString("yyyy-MM-dd")</td>
                                <td class="px-6 py-3 text-slate-900 dark:text-white font-medium">@(adv.Employee?.Name ?? "Unknown")</td>
                                <td class="px-6 py-3 text-right font-medium text-red-600 dark:text-red-400">-$@adv.Amount.ToString("F2")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-400">
                                    @if (!string.IsNullOrEmpty(adv.Note))
                                    {
                                        <span title="@adv.Note" class="block max-w-[150px] truncate">@adv.Note</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 dark:text-slate-500">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400">
                                <div class="flex flex-col items-center justify-center">
                                    <span class="material-symbols-outlined text-4xl mb-3 text-slate-300 dark:text-slate-600">receipt_long</span>
                                    <p class="text-base font-medium">No advances found for this period</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Deductions Table -->
    <div class="bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-sm overflow-hidden flex flex-col h-full">
        <div class="bg-red-600 dark:bg-red-700 px-6 py-4 flex justify-between items-center shrink-0">
            <h5 class="text-white font-semibold m-0 flex items-center gap-2">
                <span class="material-symbols-outlined">money_off</span>
                Deductions
            </h5>
            <span class="bg-white/20 text-white text-xs font-medium px-2.5 py-1 rounded-full border border-white/20">@Model.Deductions.Count() Records</span>
        </div>
        <div class="overflow-x-auto flex-1 h-full">
            <table class="w-full text-left text-sm whitespace-nowrap h-full">
                <thead class="bg-slate-50 dark:bg-slate-800/50 border-b border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 sticky top-0">
                    <tr>
                        <th class="px-6 py-3 font-semibold" data-sort="date">Date</th>
                        <th class="px-6 py-3 font-semibold" data-sort="text">Employee</th>
                        <th class="px-6 py-3 font-semibold text-right" data-sort="number">Amount</th>
                        <th class="px-6 py-3 font-semibold flex-1">Note</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200 dark:divide-slate-800 align-top">
                    @if (Model.Deductions.Any())
                    {
                        foreach (var ded in Model.Deductions)
                        {
                            <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition-colors">
                                <td class="px-6 py-3 text-slate-500 dark:text-slate-400 font-medium">@ded.Date.ToString("yyyy-MM-dd")</td>
                                <td class="px-6 py-3 text-slate-900 dark:text-white font-medium">@(ded.Employee?.Name ?? "Unknown")</td>
                                <td class="px-6 py-3 text-right font-medium text-red-600 dark:text-red-400">-$@ded.Amount.ToString("F2")</td>
                                <td class="px-6 py-3 text-slate-600 dark:text-slate-400">
                                    @if (!string.IsNullOrEmpty(ded.Note))
                                    {
                                        <span title="@ded.Note" class="block max-w-[150px] truncate">@ded.Note</span>
                                    }
                                    else
                                    {
                                        <span class="text-slate-400 dark:text-slate-500">-</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="px-6 py-12 text-center text-slate-500 dark:text-slate-400">
                                <div class="flex flex-col items-center justify-center">
                                    <span class="material-symbols-outlined text-4xl mb-3 text-slate-300 dark:text-slate-600">money_off</span>
                                    <p class="text-base font-medium">No deductions found for this period</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function applyFilters() {
        const month = document.getElementById('filterMonth').value;
        const year = document.getElementById('filterYear').value;
        let url = '/control-panel/deductions-advances';
        const params = new URLSearchParams();
        if (month) params.append('month', month);
        if (year) params.append('year', year);
        if (params.toString()) url += '?' + params.toString();
        window.location.href = url;
    }

    document.addEventListener('DOMContentLoaded', function () {
        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.has('month')) document.getElementById('filterMonth').value = urlParams.get('month');
        if (urlParams.has('year')) document.getElementById('filterYear').value = urlParams.get('year');
    });
</script>
}
