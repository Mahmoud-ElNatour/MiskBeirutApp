@model IEnumerable<MiskBeirut.Application.DTOs.SiteGalleryImagesDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = ViewData["BrandName"] as string ?? "Misk Beirut";
    var brandName = ViewData["BrandName"] as string ?? "Misk Beirut";
    var address = ViewData["Address"] as string ?? "Beirut, Coastal Road, Lebanon";
    var hours = ViewData["Hours"] as string ?? "Mon-Sun: 8:00 AM - 12:00 AM";
    var phoneDisplay = ViewData["PhoneDisplay"] as string ?? "+961 1 000 000";
    var phoneTel = ViewData["PhoneTel"] as string ?? "";
    var whatsappDigits = ViewData["WhatsappDigits"] as string ?? "";
    var instagramUrl = ViewData["InstagramUrl"] as string ?? "";
    var mapsUrl = ViewData["MapsUrl"] as string ?? "";
    var menuUrl = ViewData["MenuUrl"] as string ?? "";
    var isAdmin = ViewData["IsAdmin"] as bool? ?? false;
}

<!-- Hero Section -->
<section class="relative bg-slate-50 dark:bg-slate-900/40 py-20 lg:py-32 overflow-hidden rounded-3xl border border-slate-200/50 dark:border-slate-800 mb-12" data-purpose="hero">
    <div class="max-w-3xl mx-auto text-center px-4 relative z-10">
        <h1 class="text-4xl lg:text-6xl font-black text-slate-900 dark:text-white leading-tight mb-6 font-display">
            @brandName — <span class="text-primary dark:text-blue-400 italic font-serif">A Cozy Resto-Café</span> by the Sea
        </h1>
        <p class="text-lg lg:text-xl text-slate-600 dark:text-slate-400 mb-10 leading-relaxed max-w-2xl mx-auto">
            Fresh flavors, comforting dishes, and a relaxed Beirut atmosphere — any time of day. Join us for an authentic coastal dining experience.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <div class="relative inline-block w-full sm:w-auto">
                <a class="inline-flex justify-center items-center px-8 py-4 bg-primary hover:bg-blue-700 text-white font-bold rounded-xl transition-all text-lg w-full sm:w-auto shadow-lg shadow-primary/20"
                   href="/Menu">
                    View Menu
                </a>
                @if (isAdmin && string.IsNullOrEmpty(menuUrl))
                {
                    <a href="/control-panel/site-settings"
                       class="absolute -top-3 -right-3 bg-rose-100 dark:bg-rose-950 text-rose-600 dark:text-rose-400 text-[10px] font-bold px-2 py-0.5 rounded shadow border border-rose-200 dark:border-rose-800 z-50 hover:bg-rose-200 dark:hover:bg-rose-900 whitespace-nowrap">
                        Add Menu PDF/Link
                    </a>
                }
            </div>
            <a class="inline-flex justify-center items-center px-8 py-4 border-2 border-primary text-primary hover:bg-primary hover:text-white font-bold rounded-xl transition-all text-lg w-full sm:w-auto dark:border-blue-400 dark:text-blue-400 dark:hover:bg-blue-400 dark:hover:text-slate-950"
               href="@(string.IsNullOrEmpty(mapsUrl) ? "#" : mapsUrl)" @(string.IsNullOrEmpty(mapsUrl) ? "" : "target=\"_blank\"")>
                Get Directions
            </a>
        </div>
    </div>
</section>

<!-- About Section -->
<section class="py-16 bg-white dark:bg-slate-900 rounded-3xl border border-slate-200/50 dark:border-slate-800 p-8 text-center mb-12" data-purpose="about-text" id="about">
    <div class="max-w-4xl mx-auto">
        <span class="text-primary dark:text-blue-400 font-black tracking-widest uppercase text-sm mb-3 block">Our Story</span>
        <h2 class="text-3xl lg:text-4xl font-bold mb-6 text-slate-900 dark:text-white font-display">A Taste of Coastal Comfort</h2>
        <p class="text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
            Inspired by the vibrant yet laid-back spirit of Beirut's coastline, @brandName is your all-day destination for warmth and flavor. We blend traditional hospitality with a contemporary café feel, serving everything from morning staples to hearty evening meals in a space designed for relaxation.
        </p>
    </div>
</section>

<!-- Menu Preview -->
<section class="py-16 mb-12" data-purpose="menu-preview" id="menu">
    <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-slate-900 dark:text-white mb-3 font-display">On The Menu</h2>
        <p class="text-slate-500 dark:text-slate-400 max-w-xl mx-auto">Explore our diverse selection of all-day favorites, crafted with care.</p>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <!-- Categories -->
        <div class="relative group overflow-hidden rounded-2xl h-48 flex items-center justify-center border border-slate-200 dark:border-slate-800">
            <div class="absolute inset-0 bg-slate-950/40 group-hover:bg-slate-950/50 transition-colors z-10"></div>
