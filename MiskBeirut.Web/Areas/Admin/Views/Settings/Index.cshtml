@model MiskBeirut.Web.Areas.Admin.Models.Settings.SettingsViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Settings";
    var content = (MiskBeirut.Web.Support.BackofficePageContent)ViewData["Content"]!;
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-stack-lg">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-xs">@content.Text("title", "Settings")</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">@content.Text("subtitle", "Manage your account and application preferences.")</p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-gutter mb-stack-lg">
    <!-- Profile Settings Form -->
    <div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden flex flex-col">
        <div class="bg-surface-bright border-b border-surface-container-high px-stack-md py-4 flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">person</span>
            <h3 class="font-headline-sm text-headline-sm text-on-surface m-0">Profile Settings</h3>
        </div>
        <div class="p-stack-md flex-grow">
            <form asp-controller="Settings" asp-action="Update" method="post" class="space-y-stack-md h-full flex flex-col">
                <div>
                    <label for="username" class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Username</label>
                    <input type="text" id="username" name="username" value="@Model.User.UserName"
                           class="block w-full rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-slate-blue focus:border-slate-blue text-on-surface py-2.5 px-3"
                           required>
                </div>
                <div>
                    <label for="email" class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Email</label>
                    <input type="email" id="email" name="email" value="@Model.User.Email"
                           class="block w-full rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-slate-blue focus:border-slate-blue text-on-surface py-2.5 px-3"
                           required>
                </div>
                <div class="pt-4 border-t border-surface-container-high mt-auto">
                    <button type="submit"
                            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 px-5 py-2.5 bg-primary hover:bg-primary-container text-white rounded-DEFAULT font-label-md text-label-md transition-colors">
                        <span class="material-symbols-outlined text-sm">save</span>
                        Save Profile Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Password Settings Form -->
    <div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden flex flex-col">
        <div class="bg-surface-bright border-b border-surface-container-high px-stack-md py-4 flex items-center gap-3">
            <span class="material-symbols-outlined text-primary">lock</span>
            <h3 class="font-headline-sm text-headline-sm text-on-surface m-0">Change Password</h3>
        </div>
        <div class="p-stack-md flex-grow">
            <form asp-controller="Settings" asp-action="Update" method="post" class="space-y-stack-md h-full flex flex-col">
                <div>
                    <label for="current_password" class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Current Password</label>
                    <input type="password" id="current_password" name="CurrentPassword"
                           class="block w-full rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-slate-blue focus:border-slate-blue text-on-surface py-2.5 px-3"
                           required>
                </div>
                <div>
                    <label for="new_password" class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">New Password</label>
                    <input type="password" id="new_password" name="NewPassword"
                           class="block w-full rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-slate-blue focus:border-slate-blue text-on-surface py-2.5 px-3"
                           required>
                </div>
                <div>
                    <label for="confirm_password" class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Confirm New Password</label>
                    <input type="password" id="confirm_password" name="ConfirmPassword"
                           class="block w-full rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-slate-blue focus:border-slate-blue text-on-surface py-2.5 px-3"
                           required>
                </div>
                <div class="pt-4 border-t border-surface-container-high mt-auto">
                    <button type="submit"
                            class="w-full sm:w-auto inline-flex justify-center items-center gap-2 px-5 py-2.5 bg-on-surface hover:opacity-90 text-white rounded-DEFAULT font-label-md text-label-md transition-colors">
                        <span class="material-symbols-outlined text-sm">key</span>
                        Update Password
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Database & System Info -->
<div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
    <div class="bg-surface-bright border-b border-surface-container-high px-stack-md py-4 flex items-center gap-3">
        <span class="material-symbols-outlined text-on-surface-variant">dns</span>
        <h3 class="font-headline-sm text-headline-sm text-on-surface m-0">Database & Account Information</h3>
    </div>
    <div class="p-stack-md">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-gutter">
            <div class="space-y-stack-md">
                <div class="flex items-start">
                    <div class="shrink-0 w-32 font-body-md text-body-md text-on-surface-variant font-medium">Database Type</div>
                    <div class="font-body-md text-body-md text-on-surface font-medium flex-1">Microsoft SQL Server</div>
                </div>
                <div class="flex items-start">
                    <div class="shrink-0 w-32 font-body-md text-body-md text-on-surface-variant font-medium">Connection</div>
                    <div class="text-sm font-mono text-on-surface flex-1 bg-surface-bright px-2 py-0.5 rounded-DEFAULT border border-border-subtle inline-block w-fit">
                        MiskBeirutDb
                    </div>
                </div>
                <div class="flex items-start">
                    <div class="shrink-0 w-32 font-body-md text-body-md text-on-surface-variant font-medium">Date Created</div>
                    <div class="font-body-md text-body-md text-on-surface flex-1">
                        @Model.User.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")
                    </div>
                </div>
            </div>
            <div class="space-y-stack-md">
                <div class="flex items-start">
                    <div class="shrink-0 w-32 font-body-md text-body-md text-on-surface-variant font-medium">Account Info</div>
                    <div class="font-body-md text-body-md text-on-surface flex-1">@Model.User.UserName (@(Model.User.Email ?? "No email set"))</div>
                </div>
                <div class="flex items-start">
                    <div class="shrink-0 w-32 font-body-md text-body-md text-on-surface-variant font-medium">Status</div>
                    <div class="flex-1">
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-medium bg-[#E8F5E9] text-status-success">
                            <span class="w-1.5 h-1.5 rounded-full bg-status-success"></span>
                            Active
                        </span>
                    </div>
                </div>
                <div class="flex items-start">
                    <div class="shrink-0 w-32 font-body-md text-body-md text-on-surface-variant font-medium">System Role@(Model.Roles.Count == 1 ? "" : "s")</div>
                    <div class="font-body-md text-body-md text-on-surface flex-1 flex items-center gap-1.5 flex-wrap">
                        <span class="material-symbols-outlined text-[16px] text-status-pending">shield_person</span>
                        @(Model.Roles.Count > 0 ? string.Join(", ", Model.Roles) : "User")
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Password confirmation validation
    const confirmPasswordObj = document.getElementById('confirm_password');
    if (confirmPasswordObj) {
        confirmPasswordObj.addEventListener('input', function () {
            const newPassword = document.getElementById('new_password').value;
            const confirmPassword = this.value;

            if (newPassword !== confirmPassword) {
                this.setCustomValidity('Passwords do not match');
            } else {
                this.setCustomValidity('');
            }
        });
    }
</script>
}
