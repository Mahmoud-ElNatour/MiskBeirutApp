@model LoginRequest
@{
    ViewData["Title"] = "Log In";
}

<div class="max-w-md mx-auto bg-white dark:bg-slate-900 border border-primary/10 rounded-xl p-8 shadow-sm">
    <div class="text-center mb-8">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Admin Log In</h2>
        <p class="text-slate-500 mt-2">Access the MiskBeirut management console</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-rose-600 dark:text-rose-400"></div>

    <form asp-area="Admin" asp-controller="Auth" asp-action="Login" method="post" class="space-y-6">
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Username</label>
            <input asp-for="Username" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" autofocus />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Password</label>
            <input asp-for="Password" type="password" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <button type="submit" class="w-full py-3 bg-primary hover:bg-primary/95 text-white font-bold rounded-lg transition-colors">Log In</button>
    </form>
</div>
