@model IEnumerable<CustomerDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Customers Management";
    var startDate = ViewData["StartDate"] as string;
    var endDate = ViewData["EndDate"] as string;
    var content = (MiskBeirut.Web.Support.BackofficePageContent)ViewData["Content"]!;
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-stack-lg">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-xs">@content.Text("title", "Customers Management")</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">@content.Text("subtitle", "Manage customer information and account balances.")</p>
    </div>
    <div class="flex flex-wrap gap-3 w-full md:w-auto">
        <div class="flex items-center gap-2 bg-surface-container-lowest border border-border-subtle rounded-DEFAULT px-3 py-1.5 self-stretch md:self-auto">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">From</span>
            <input type="date" id="start_date" value="@startDate" class="border-0 p-0 bg-transparent font-body-md text-body-md focus:ring-0 text-on-surface w-32" />
        </div>
        <div class="flex items-center gap-2 bg-surface-container-lowest border border-border-subtle rounded-DEFAULT px-3 py-1.5 self-stretch md:self-auto">
            <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">To</span>
            <input type="date" id="end_date" value="@endDate" class="border-0 p-0 bg-transparent font-body-md text-body-md focus:ring-0 text-on-surface w-32" />
        </div>
        <button onclick="filterByDate()" class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">filter_alt</span>
            Filter
        </button>
        <a href="/System/ControlPanel" class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back
        </a>
        <button data-bs-toggle="modal" data-bs-target="#addCustomerModal" class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-primary hover:bg-primary-container text-white rounded-DEFAULT font-label-md text-label-md uppercase tracking-wider transition-colors">
            <span class="material-symbols-outlined text-sm">add</span>
            @content.Text("add_button_label", "Add Customer")
        </button>
    </div>
</div>

<!-- Customers Table -->
<div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
            <thead>
                <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                    <th class="py-3 px-stack-md" data-sort="number">ID</th>
                    <th class="py-3 px-stack-md" data-sort="text">Username</th>
                    <th class="py-3 px-stack-md" data-sort="text">Phone Number</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Balance</th>
                    <th class="py-3 px-stack-md text-center w-24">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var customer in Model)
                    {
                        <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors">
                            <td class="py-4 px-stack-md text-on-surface-variant">@customer.Id</td>
                            <td class="py-4 px-stack-md font-medium text-on-surface">@customer.Name</td>
                            <td class="py-4 px-stack-md text-on-surface-variant">@(customer.PhoneNumber ?? "N/A")</td>
                            <td class="py-4 px-stack-md text-right">
                                @if (customer.Balance < 0)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-error-container text-on-error-container whitespace-nowrap">
                                        $@customer.Balance.ToString("F2")
                                    </span>
                                }
                                else if (customer.Balance > 0)
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-[#E8F5E9] text-status-success whitespace-nowrap">
                                        $@customer.Balance.ToString("F2")
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold bg-surface-container-high text-on-surface-variant whitespace-nowrap">
                                        $@customer.Balance.ToString("F2")
                                    </span>
                                }
                            </td>
                            <td class="py-4 px-stack-md text-center">
                                <div class="flex items-center justify-center gap-3">
                                    <button onclick="openCustomerHistory('@customer.Id', '@customer.Name')" class="text-status-success hover:opacity-80 inline-flex items-center" title="Transaction History">
                                        <span class="material-symbols-outlined text-sm">history</span>
                                    </button>
                                    <button onclick="editCustomer('@customer.Id')" class="text-slate-blue hover:text-primary inline-flex items-center" title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </button>
                                    <button onclick="deleteCustomer('@customer.Id')" class="text-brick-red hover:opacity-80 inline-flex items-center" title="Delete">
                                        <span class="material-symbols-outlined text-sm">delete</span>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-12 px-stack-md text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center">
                                <span class="material-symbols-outlined text-4xl mb-3 text-on-surface-variant/40">group_off</span>
                                <p class="font-body-lg text-body-lg font-medium">@content.Text("empty_title", "No customers found")</p>
                                <p class="font-body-md text-body-md mt-1">@content.Text("empty_body", "Click 'Add Customer' to create your first record.")</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@await Html.PartialAsync("_AddModal")
@await Html.PartialAsync("_EditModal")

<!-- Customer History Modal -->
<div class="modal fade" id="customerHistoryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content overflow-hidden">
            <div class="modal-header">
                <h5 class="modal-title flex items-center gap-2">
                    <span class="material-symbols-outlined text-primary">history</span>
                    Transaction History — <span id="history-customer-name" class="text-primary"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="history-customer-id">
                <div class="flex flex-wrap items-center gap-3 mb-stack-lg">
                    <div class="flex items-center gap-2 bg-surface-bright border border-border-subtle rounded-DEFAULT px-3 py-2">
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">From</span>
                        <input type="date" id="history-from" class="border-0 p-0 bg-transparent font-body-md text-body-md focus:ring-0 text-on-surface w-32" />
                    </div>
                    <div class="flex items-center gap-2 bg-surface-bright border border-border-subtle rounded-DEFAULT px-3 py-2">
                        <span class="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">To</span>
                        <input type="date" id="history-to" class="border-0 p-0 bg-transparent font-body-md text-body-md focus:ring-0 text-on-surface w-32" />
                    </div>
                    <button onclick="loadCustomerHistory()" class="inline-flex items-center gap-2 px-stack-md py-2 bg-primary hover:bg-primary-container text-white rounded-DEFAULT font-label-md text-label-md transition-colors">
                        <span class="material-symbols-outlined text-sm">search</span>
                        Load
                    </button>
                </div>
                <div id="history-loading" class="hidden text-center py-6 text-on-surface-variant">
                    <span class="material-symbols-outlined animate-spin text-2xl">progress_activity</span>
                </div>
                <div id="history-results" class="hidden space-y-stack-lg">
                    <div class="flex gap-4 mb-stack-xs">
                        <div class="flex-1 bg-error-container border border-status-urgent/20 rounded-DEFAULT px-4 py-3">
                            <p class="font-label-sm text-label-sm text-on-error-container uppercase tracking-wider">Total Credits</p>
                            <p class="font-headline-sm text-headline-sm text-on-error-container mt-1">$<span id="history-total-credits">0.00</span></p>
                        </div>
                        <div class="flex-1 bg-[#E8F5E9] border border-status-success/20 rounded-DEFAULT px-4 py-3">
                            <p class="font-label-sm text-label-sm text-status-success uppercase tracking-wider">Total Cashbacks</p>
                            <p class="font-headline-sm text-headline-sm text-status-success mt-1">$<span id="history-total-cashbacks">0.00</span></p>
                        </div>
                    </div>
                    <div>
                        <h6 class="font-label-md text-label-md text-on-surface-variant mb-stack-xs">Credits</h6>
                        <div class="rounded-DEFAULT border border-surface-container-high overflow-hidden">
                            <table id="history-credits-table" class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
                                <thead class="bg-surface-bright text-on-surface-variant">
                                    <tr>
                                        <th class="px-4 py-2 font-semibold" data-sort="date">Date</th>
                                        <th class="px-4 py-2 font-semibold text-right" data-sort="number">Amount</th>
                                        <th class="px-4 py-2 font-semibold">Note</th>
                                    </tr>
                                </thead>
                                <tbody id="history-credits-body"></tbody>
                            </table>
                        </div>
                    </div>
                    <div>
                        <h6 class="font-label-md text-label-md text-on-surface-variant mb-stack-xs">Cashbacks</h6>
                        <div class="rounded-DEFAULT border border-surface-container-high overflow-hidden">
                            <table id="history-cashbacks-table" class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
                                <thead class="bg-surface-bright text-on-surface-variant">
                                    <tr>
                                        <th class="px-4 py-2 font-semibold" data-sort="date">Date</th>
                                        <th class="px-4 py-2 font-semibold text-right" data-sort="number">Amount</th>
                                        <th class="px-4 py-2 font-semibold">Note</th>
                                    </tr>
                                </thead>
                                <tbody id="history-cashbacks-body"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function openCustomerHistory(id, name) {
        document.getElementById('history-customer-id').value = id;
        document.getElementById('history-customer-name').textContent = name;
        document.getElementById('history-results').classList.add('hidden');
        document.getElementById('history-loading').classList.add('hidden');
        // Default to current month
        const now = new Date();
        const firstDay = new Date(now.getFullYear(), now.getMonth(), 1).toISOString().split('T')[0];
        const today = now.toISOString().split('T')[0];
        document.getElementById('history-from').value = firstDay;
        document.getElementById('history-to').value = today;
        new bootstrap.Modal(document.getElementById('customerHistoryModal')).show();
    }

    function loadCustomerHistory() {
        const id = document.getElementById('history-customer-id').value;
        const from = document.getElementById('history-from').value;
        const to = document.getElementById('history-to').value;
        if (!from || !to) { alert('Please select both dates.'); return; }

        document.getElementById('history-loading').classList.remove('hidden');
        document.getElementById('history-results').classList.add('hidden');

        fetch(`/api/customers/${id}/history?from=${from}&to=${to}`)
        .then(r => r.json())
        .then(data => {
            document.getElementById('history-loading').classList.add('hidden');
            document.getElementById('history-total-credits').textContent = (data.totalCredits || 0).toFixed(2);
            document.getElementById('history-total-cashbacks').textContent = (data.totalCashbacks || 0).toFixed(2);

            const creditsBody = document.getElementById('history-credits-body');
            creditsBody.innerHTML = data.credits.length
                ? data.credits.map(c => `<tr class="border-b border-surface-container-high last:border-b-0 hover:bg-surface-bright"><td class="px-4 py-2 text-on-surface-variant">${c.date}</td><td class="px-4 py-2 text-right font-medium text-brick-red">$${c.amount.toFixed(2)}</td><td class="px-4 py-2 text-on-surface-variant">${c.note || '—'}</td></tr>`).join('')
                : '<tr><td colspan="3" class="px-4 py-4 text-center text-on-surface-variant">No credits in this range</td></tr>';

            const cashbacksBody = document.getElementById('history-cashbacks-body');
            cashbacksBody.innerHTML = data.cashbacks.length
                ? data.cashbacks.map(c => `<tr class="border-b border-surface-container-high last:border-b-0 hover:bg-surface-bright"><td class="px-4 py-2 text-on-surface-variant">${c.date}</td><td class="px-4 py-2 text-right font-medium text-status-success">$${c.amount.toFixed(2)}</td><td class="px-4 py-2 text-on-surface-variant">${c.note || '—'}</td></tr>`).join('')
                : '<tr><td colspan="3" class="px-4 py-4 text-center text-on-surface-variant">No cashbacks in this range</td></tr>';

            document.getElementById('history-results').classList.remove('hidden');
            window.wireTablePagination(document.getElementById('history-credits-table'));
            window.wireTablePagination(document.getElementById('history-cashbacks-table'));
        })
        .catch(() => {
            document.getElementById('history-loading').classList.add('hidden');
            alert('Error loading history data.');
        });
    }

    function filterByDate() {
        const start = document.getElementById('start_date').value;
        const end = document.getElementById('end_date').value;
        if (!start || !end) {
            alert('Please select both start and end dates');
            return;
        }
        window.location.href = `/Customers?start_date=${start}&end_date=${end}`;
    }

    // Add Customer Form Handler
    document.getElementById('addCustomerForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const formData = new FormData(this);
        const data = Object.fromEntries(formData);
        data.balance = parseFloat(data.balance) || 0;

        const submitBtn = this.querySelector('button[type="submit"]');
        submitBtn.disabled = true;

        fetch('/api/customers', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                location.reload();
            } else {
                alert('Error adding customer: ' + (data.message || data.error));
                submitBtn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error adding customer');
            submitBtn.disabled = false;
        });
    });

    function editCustomer(id) {
        fetch(`/api/customers/${id}`)
        .then(response => response.json())
        .then(data => {
            document.getElementById('edit-customer-id').value = data.id;
            document.getElementById('edit-customer-username').value = data.username;
            document.getElementById('edit-customer-phone').value = data.phoneNumber || '';
            document.getElementById('edit-customer-balance').value = data.balance || 0;
            const modal = new bootstrap.Modal(document.getElementById('editCustomerModal'));
            modal.show();
        })
        .catch(err => {
            console.error('Error fetching customer', err);
            alert('Error loading customer data');
        });
    }

    document.getElementById('editCustomerForm').addEventListener('submit', function (e) {
        e.preventDefault();
        const id = document.getElementById('edit-customer-id').value;
        const formData = new FormData(this);
        const data = Object.fromEntries(formData);
        data.id = parseInt(id);
        data.balance = parseFloat(data.balance) || 0;

        const submitBtn = this.querySelector('button[type="submit"]');
        submitBtn.disabled = true;

        fetch(`/api/customers/${id}`, {
            method: 'PUT',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(data)
        })
        .then(response => response.json())
        .then(data => {
            if (data.status === 'success') {
                location.reload();
            } else {
                alert('Error updating customer: ' + (data.message || data.error));
                submitBtn.disabled = false;
            }
        })
        .catch(error => {
            console.error('Error:', error);
            alert('Error updating customer');
            submitBtn.disabled = false;
        });
    });

    async function deleteCustomer(id) {
        if (confirm('Are you sure you want to delete this customer?')) {
            try {
                const response = await fetch(`/api/customers/${id}`, {
                    method: 'DELETE',
                    headers: { 'Content-Type': 'application/json' }
                });
                const result = await response.json();

                if (result.status === 'success') {
                    location.reload();
                } else {
                    alert(result.message || 'Failed to delete customer');
                }
            } catch (error) {
                console.error('Error:', error);
                alert('An error occurred while deleting the customer.');
            }
        }
    }
</script>
}
