@model EmployeeFormViewModel
@using MiskBeirut.Web.Areas.Admin.Models.Employees
@{
    ViewData["Title"] = "New Employee";
}

<div class="max-w-lg mx-auto bg-white dark:bg-slate-900 border border-primary/10 rounded-xl p-8 shadow-sm">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">New Employee</h2>
    <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-rose-600 dark:text-rose-400"></div>
    <form asp-action="Create" method="post" class="space-y-6">
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Name</label>
            <input asp-for="Name" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Position</label>
            <input asp-for="Position" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Phone Number</label>
            <input asp-for="PhoneNumber" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Base Salary</label>
            <input asp-for="BaseSalary" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <button type="submit" class="w-full py-3 bg-primary hover:bg-primary/95 text-white font-bold rounded-lg transition-colors">Create Employee</button>
    </form>
</div>
