@model (IReadOnlyList<MiskBeirut.Application.Dtos.Employees.EmployeeLedgerReportEntryDto> Advances, IReadOnlyList<MiskBeirut.Application.Dtos.Employees.EmployeeLedgerReportEntryDto> Deductions)
@{
    Layout = "_Layout";
    ViewData["Title"] = "Deductions & Advances";
    var currentMonth = ViewData["CurrentMonth"] as int?;
    var currentYear = ViewData["CurrentYear"] as int?;
    var content = (MiskBeirut.Web.Support.BackofficePageContent)ViewData["Content"]!;
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-stack-lg">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-xs">@content.Text("title", "Deductions & Advances")</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">@content.Text("subtitle", "View and filter employee advances and deductions.")</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <a asp-area="Admin" asp-controller="System" asp-action="ControlPanel"
            class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back
        </a>
        <select id="recordMonth"
            class="rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-1 focus:ring-slate-blue focus:border-slate-blue text-on-surface">
            <option value="">All Months</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == currentMonth ? "selected" : null)">
                    @(new DateTime(2000, m, 1).ToString("MMMM"))
                </option>
            }
        </select>
        <select id="recordYear"
            class="rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-1 focus:ring-slate-blue focus:border-slate-blue text-on-surface">
            <option value="">All Years</option>
            @for (int y = 2023; y <= 2030; y++)
            {
                <option value="@y" selected="@(y == currentYear ? "selected" : null)">@y</option>
            }
        </select>
        <button onclick="filterRecords()"
            class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">filter_list</span>
            Filter
        </button>
    </div>
</div>

<!-- Statistics Summary -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-gutter mb-stack-lg">
    <div class="bg-status-pending text-white rounded-DEFAULT p-stack-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 transform translate-x-1/4 -translate-y-1/4">
            <span class="material-symbols-outlined text-8xl">account_balance_wallet</span>
        </div>
        <div class="relative z-10">
            <h6 class="font-label-sm text-label-sm uppercase tracking-wider mb-stack-sm opacity-80">Total Advances</h6>
            <h3 class="font-headline-lg text-headline-lg">$@Math.Abs(Model.Advances.Sum(a => a.Amount)).ToString("F2")</h3>
            <p class="font-label-sm text-label-sm mt-1 opacity-80">@Model.Advances.Count() record(s)</p>
        </div>
    </div>

    <div class="bg-brick-red text-white rounded-DEFAULT p-stack-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 transform translate-x-1/4 -translate-y-1/4">
            <span class="material-symbols-outlined text-8xl">money_off</span>
        </div>
        <div class="relative z-10">
            <h6 class="font-label-sm text-label-sm uppercase tracking-wider mb-stack-sm opacity-80">Total Deductions</h6>
            <h3 class="font-headline-lg text-headline-lg">$@Math.Abs(Model.Deductions.Sum(d => d.Amount)).ToString("F2")</h3>
            <p class="font-label-sm text-label-sm mt-1 opacity-80">@Model.Deductions.Count() record(s)</p>
        </div>
    </div>
</div>

<!-- Advances Table -->
<h3 class="font-headline-sm text-headline-sm text-on-surface mb-stack-sm">Advances</h3>
<div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden mb-stack-lg">
    <div class="overflow-x-auto">
        <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
            <thead>
                <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                    <th class="py-3 px-stack-md" data-sort="date">Date</th>
                    <th class="py-3 px-stack-md" data-sort="text">Employee</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Amount</th>
                    <th class="py-3 px-stack-md">Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Advances)
                {
                    <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors">
                        <td class="py-4 px-stack-md font-medium text-on-surface">@record.Date.ToString("yyyy-MM-dd")</td>
                        <td class="py-4 px-stack-md text-on-surface-variant">@record.EmployeeName</td>
                        <td class="py-4 px-stack-md text-right font-medium text-status-pending">-$@Math.Abs(record.Amount).ToString("F2")</td>
                        <td class="py-4 px-stack-md text-on-surface-variant">@(record.Note ?? "N/A")</td>
                    </tr>
                }
                @if (!Model.Advances.Any())
                {
                    <tr>
                        <td colspan="4" class="py-12 px-stack-md text-center text-on-surface-variant">@content.Text("empty_advances", "No advance records found")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Deductions Table -->
<h3 class="font-headline-sm text-headline-sm text-on-surface mb-stack-sm">Deductions</h3>
<div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
            <thead>
                <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                    <th class="py-3 px-stack-md" data-sort="date">Date</th>
                    <th class="py-3 px-stack-md" data-sort="text">Employee</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Amount</th>
                    <th class="py-3 px-stack-md">Note</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model.Deductions)
                {
                    <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors">
                        <td class="py-4 px-stack-md font-medium text-on-surface">@record.Date.ToString("yyyy-MM-dd")</td>
                        <td class="py-4 px-stack-md text-on-surface-variant">@record.EmployeeName</td>
                        <td class="py-4 px-stack-md text-right font-medium text-brick-red">-$@Math.Abs(record.Amount).ToString("F2")</td>
                        <td class="py-4 px-stack-md text-on-surface-variant">@(record.Note ?? "N/A")</td>
                    </tr>
                }
                @if (!Model.Deductions.Any())
                {
                    <tr>
                        <td colspan="4" class="py-12 px-stack-md text-center text-on-surface-variant">@content.Text("empty_deductions", "No deduction records found")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function filterRecords() {
        const month = document.getElementById('recordMonth').value;
        const year = document.getElementById('recordYear').value;
        const params = new URLSearchParams();
        if (month) params.append('month', month);
        if (year) params.append('year', year);
        window.location.href = `?${params.toString()}`;
    }
</script>
}
