<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MiskBeirut Admin</title>
    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <script id="tailwind-config">
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        "primary": "#1e3fae",
                        "background-light": "#f6f6f8",
                        "background-dark": "#121520",
                    },
                    fontFamily: {
                        "display": ["Inter", "sans-serif"]
                    },
                },
            },
        }
    </script>
    <script>
        (function () {
            try {
                var stored = localStorage.getItem('theme');
                var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                if (stored === 'dark' || (!stored && prefersDark)) {
                    document.documentElement.classList.add('dark');
                }
            } catch (e) { }
        })();
    </script>
    <style>
        body { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="font-display bg-background-light dark:bg-background-dark text-slate-900 dark:text-slate-100 min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 w-full bg-white/80 dark:bg-background-dark/80 backdrop-blur-md border-b border-slate-200 dark:border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                <div class="flex items-center gap-8">
                    <a asp-area="Admin" asp-controller="Home" asp-action="Index" class="flex items-center gap-2 group cursor-pointer hover:opacity-90 transition-opacity">
                        <div class="bg-primary p-1.5 rounded-lg text-white">
                            <span class="material-symbols-outlined text-2xl">account_balance_wallet</span>
                        </div>
                        <span class="text-xl font-bold tracking-tight text-slate-900 dark:text-white hidden sm:inline">MiskBeirut Admin</span>
                    </a>
                    <nav class="hidden md:flex items-center gap-1">
                        @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Supervisor))
                        {
                            <a asp-area="Admin" asp-controller="DailyClosing" asp-action="Index" class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors">Daily Closing</a>
                        }
                        else if (User.IsInRole(RoleNames.Employee))
                        {
                            <a asp-area="Admin" asp-controller="DailyClosing" asp-action="Create" class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors">Submit Closing</a>
                        }
                        @if (User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Supervisor))
                        {
                            <a asp-area="Admin" asp-controller="Customers" asp-action="Index" class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors">Customers</a>
                            <a asp-area="Admin" asp-controller="Payroll" asp-action="Index" class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors">Payroll</a>
                        }
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <a asp-area="Admin" asp-controller="Employees" asp-action="Index" class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors">Employees</a>
                            <a asp-area="Admin" asp-controller="Receivers" asp-action="Index" class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors">Receivers</a>
                        }
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <a asp-area="Admin" asp-controller="Users" asp-action="Index" class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors">Users</a>
                            <a asp-area="Admin" asp-controller="AuditLogs" asp-action="Index" class="px-3 py-2 text-sm font-medium text-slate-600 dark:text-slate-400 hover:text-primary dark:hover:text-primary transition-colors">Audit Logs</a>
                        }
                    </nav>
                </div>

                <div class="flex items-center gap-4">
                    <button type="button" id="themeToggle" aria-label="Toggle dark mode" class="size-10 rounded-full flex items-center justify-center text-slate-500 dark:text-slate-400 hover:text-primary dark:hover:text-primary hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors">
                        <span class="material-symbols-outlined hidden dark:inline">light_mode</span>
                        <span class="material-symbols-outlined inline dark:hidden">dark_mode</span>
                    </button>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="flex items-center gap-3 pl-4 border-l border-slate-200 dark:border-slate-800">
                            <div class="text-right hidden sm:block">
                                <p class="text-sm font-bold leading-none text-slate-900 dark:text-white">@User.Identity.Name</p>
                                <p class="text-xs text-slate-500 mt-1 uppercase tracking-wider font-semibold">@User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value</p>
                            </div>
                            <a asp-area="Admin" asp-controller="Auth" asp-action="Logout" class="flex items-center gap-2 px-3 py-2 text-sm font-medium text-red-600 hover:bg-red-50 dark:hover:bg-red-900/10 rounded-lg transition-colors">
                                <span class="material-symbols-outlined text-lg">logout</span>
                                Logout
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full">
        @if (TempData["Success"] != null)
        {
            <div class="mb-6 p-4 bg-emerald-50 dark:bg-emerald-950/30 text-emerald-800 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50 rounded-xl text-sm">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-6 p-4 bg-rose-50 dark:bg-rose-950/30 text-rose-800 dark:text-rose-400 border border-rose-200 dark:border-rose-800/50 rounded-xl text-sm">@TempData["Error"]</div>
        }
        @RenderBody()
    </main>

    <footer class="bg-white dark:bg-slate-900 border-t border-slate-200 dark:border-slate-800 py-6">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center text-sm text-slate-500">
            &copy; @DateTime.UtcNow.Year MiskBeirut Management System. All rights reserved.
        </div>
    </footer>

    <script>
        document.getElementById('themeToggle')?.addEventListener('click', () => {
            const isDark = document.documentElement.classList.toggle('dark');
            try { localStorage.setItem('theme', isDark ? 'dark' : 'light'); } catch (e) { }
        });
    </script>
    @RenderSection("Scripts", required: false)
</body>
</html>
