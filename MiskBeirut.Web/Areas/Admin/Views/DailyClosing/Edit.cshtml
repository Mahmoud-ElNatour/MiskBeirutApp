@model EditDailyClosingViewModel
@{
    ViewData["Title"] = "Edit Daily Closing";
}

<div class="max-w-lg mx-auto bg-white dark:bg-slate-900 border border-primary/10 rounded-xl p-8 shadow-sm">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Edit Daily Closing — @Model.Date.ToString("yyyy-MM-dd")</h2>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-6">
        <input type="hidden" asp-for="Id" />
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Main Reading</label>
            <input value="@Model.MainReading.ToString("N2")" disabled class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2 opacity-60" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Adjusted Reading</label>
            <input asp-for="AdjustedReading" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Actual Cash</label>
            <input asp-for="ActualCash" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Note</label>
            <textarea asp-for="Note" rows="3" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2"></textarea>
        </div>
        <button type="submit" class="w-full py-3 bg-primary hover:bg-primary/95 text-white font-bold rounded-lg transition-colors">Save Changes</button>
    </form>
</div>
