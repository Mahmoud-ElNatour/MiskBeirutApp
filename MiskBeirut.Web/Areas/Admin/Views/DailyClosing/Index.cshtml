@model IEnumerable<MiskBeirut.Application.Dtos.DailyClosings.DailyClosingDto>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Daily Closings";
    var currentYear = ViewData["CurrentYear"] as int?;
    var currentMonth = ViewData["CurrentMonth"] as int?;
    var content = (MiskBeirut.Web.Support.BackofficePageContent)ViewData["Content"]!;
    var totalMainReading = Model.Sum(c => c.MainReading);
    var totalActualCash = Model.Sum(c => c.ActualCash ?? 0);
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-stack-lg">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-xs">@content.Text("title", "Daily Closings")</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">@content.Text("subtitle", "Every submitted daily close, most recent first.")</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <a asp-action="Create"
            class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-primary hover:bg-primary-container text-white rounded-DEFAULT font-label-md text-label-md uppercase tracking-wider transition-colors">
            <span class="material-symbols-outlined text-sm">add</span>
            New Close
        </a>
        <select id="closingMonth"
            class="rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-1 focus:ring-slate-blue focus:border-slate-blue text-on-surface">
            <option value="">All Months</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == currentMonth ? "selected" : null)">
                    @(new DateTime(2000, m, 1).ToString("MMMM"))
                </option>
            }
        </select>
        <select id="closingYear"
            class="rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-1 focus:ring-slate-blue focus:border-slate-blue text-on-surface">
            <option value="">All Years</option>
            @for (int y = 2023; y <= 2030; y++)
            {
                <option value="@y" selected="@(y == currentYear ? "selected" : null)">@y</option>
            }
        </select>
        <button onclick="filterClosings()"
            class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">filter_list</span>
            Filter
        </button>
    </div>
</div>

<!-- Summary Cards -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-gutter mb-stack-lg">
    <div class="bg-slate-blue text-white rounded-DEFAULT p-stack-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 transform translate-x-1/4 -translate-y-1/4">
            <span class="material-symbols-outlined text-8xl">point_of_sale</span>
        </div>
        <div class="relative z-10">
            <h6 class="font-label-sm text-label-sm uppercase tracking-wider mb-stack-sm opacity-80">Total Main Reading</h6>
            <h3 class="font-headline-lg text-headline-lg">$@totalMainReading.ToString("F2")</h3>
        </div>
    </div>

    <div class="bg-primary text-white rounded-DEFAULT p-stack-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 transform translate-x-1/4 -translate-y-1/4">
            <span class="material-symbols-outlined text-8xl">payments</span>
        </div>
        <div class="relative z-10">
            <h6 class="font-label-sm text-label-sm uppercase tracking-wider mb-stack-sm opacity-80">Total Actual Cash</h6>
            <h3 class="font-headline-lg text-headline-lg">$@totalActualCash.ToString("F2")</h3>
        </div>
    </div>

    <div class="bg-status-pending text-white rounded-DEFAULT p-stack-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 transform translate-x-1/4 -translate-y-1/4">
            <span class="material-symbols-outlined text-8xl">calendar_today</span>
        </div>
        <div class="relative z-10">
            <h6 class="font-label-sm text-label-sm uppercase tracking-wider mb-stack-sm opacity-80">Closings</h6>
            <h3 class="font-headline-lg text-headline-lg">@Model.Count()</h3>
        </div>
    </div>
</div>

<!-- Closings Table -->
<div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
            <thead>
                <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                    <th class="py-3 px-stack-md" data-sort="date">Date</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Main Reading</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Adjusted Reading</th>
                    <th class="py-3 px-stack-md text-right text-status-success" data-sort="number">Actual Cash</th>
                    <th class="py-3 px-stack-md text-center w-24">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var closing in Model)
                    {
                        <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors">
                            <td class="py-4 px-stack-md font-medium text-on-surface">@closing.Date.ToString("yyyy-MM-dd")</td>
                            <td class="py-4 px-stack-md text-right text-on-surface-variant">$@closing.MainReading.ToString("F2")</td>
                            <td class="py-4 px-stack-md text-right text-on-surface-variant">$@((closing.AdjustedReading ?? 0).ToString("F2"))</td>
                            <td class="py-4 px-stack-md text-right font-bold @(closing.ActualCash < 0 ? "text-status-urgent" : "text-status-success")">
                                $@((closing.ActualCash ?? 0).ToString("F2"))
                            </td>
                            <td class="py-4 px-stack-md">
                                <div class="flex items-center justify-center gap-3">
                                    <a asp-action="Details" asp-route-id="@closing.Id"
                                        class="text-slate-blue hover:text-primary inline-flex items-center"
                                        title="View Details">
                                        <span class="material-symbols-outlined text-sm">visibility</span>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@closing.Id"
                                        class="text-slate-blue hover:text-primary inline-flex items-center"
                                        title="Edit">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-12 px-stack-md text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center">
                                <span class="material-symbols-outlined text-4xl mb-3 text-on-surface-variant/40">receipt_long</span>
                                <p class="font-body-lg text-body-lg font-medium">@content.Text("empty_title", "No daily closing records found for this period")</p>
                                <p class="font-body-md text-body-md mt-1">@content.Text("empty_body", "Adjust your filters or submit a daily close to see data here.")</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function filterClosings() {
        const month = document.getElementById('closingMonth').value;
        const year = document.getElementById('closingYear').value;
        const params = new URLSearchParams();
        if (month) params.append('month', month);
        if (year) params.append('year', year);
        window.location.href = `?${params.toString()}`;
    }
</script>
}
