@model CreateDailyClosingViewModel
@{
    ViewData["Title"] = "New Daily Closing";
    var isEmployeeOnly = User.IsInRole(RoleNames.Employee) && !User.IsInRole(RoleNames.Admin) && !User.IsInRole(RoleNames.Supervisor);
}

<div class="max-w-lg mx-auto bg-white dark:bg-slate-900 border border-primary/10 rounded-xl p-8 shadow-sm">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">
        @(isEmployeeOnly ? "Submit Today's Closing" : "New Daily Closing")
    </h2>

    <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-rose-600 dark:text-rose-400"></div>

    <form asp-action="Create" method="post" class="space-y-6">
        @if (isEmployeeOnly)
        {
            <p class="text-sm text-slate-500">Date: <span class="font-semibold text-slate-900 dark:text-white">@Model.Date.ToString("yyyy-MM-dd")</span> (today)</p>
        }
        else
        {
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Date</label>
                <input asp-for="Date" type="date" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
            </div>
        }
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Main Reading</label>
            <input asp-for="MainReading" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Adjusted Reading</label>
            <input asp-for="AdjustedReading" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Actual Cash</label>
            <input asp-for="ActualCash" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Note</label>
            <textarea asp-for="Note" rows="3" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2"></textarea>
        </div>
        <button type="submit" class="w-full py-3 bg-primary hover:bg-primary/95 text-white font-bold rounded-lg transition-colors">Save</button>
    </form>
</div>
