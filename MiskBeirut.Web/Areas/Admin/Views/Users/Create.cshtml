@model CreateUserRequest
@{
    ViewData["Title"] = "New User";
    var allRoles = (IReadOnlyList<string>)ViewData["AllRoles"]!;
}

<div class="max-w-lg mx-auto bg-white dark:bg-slate-900 border border-primary/10 rounded-xl p-8 shadow-sm">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">New User</h2>

    <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-rose-600 dark:text-rose-400"></div>

    <form asp-action="Create" method="post" class="space-y-6">
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Username</label>
            <input asp-for="Username" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Email</label>
            <input asp-for="Email" type="email" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Password</label>
            <input asp-for="Password" type="password" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Roles</label>
            <div class="space-y-2">
                @foreach (var role in allRoles)
                {
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="SelectedRoles" value="@role" class="rounded border-slate-300" />
                        <span>@role</span>
                    </label>
                }
            </div>
        </div>
        <button type="submit" class="w-full py-3 bg-primary hover:bg-primary/95 text-white font-bold rounded-lg transition-colors">Create User</button>
    </form>
</div>
