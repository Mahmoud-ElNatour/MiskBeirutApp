@model EditUserRequest
@{
    ViewData["Title"] = "Edit User";
    var allRoles = (IReadOnlyList<string>)ViewData["AllRoles"]!;
}

<div class="max-w-lg mx-auto bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT p-container-padding">
    <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-lg">Edit User: @Model.Username</h2>

    <div asp-validation-summary="All" class="mb-stack-md font-body-md text-body-md text-brick-red"></div>

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="space-y-stack-md">
        <input type="hidden" asp-for="Id" />
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Username</label>
            <input value="@Model.Username" disabled class="w-full rounded-DEFAULT border border-border-subtle px-4 py-2 opacity-60" />
        </div>
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Email</label>
            <input asp-for="Email" type="email" class="w-full rounded-DEFAULT border border-border-subtle px-4 py-2 focus:border-slate-blue focus:ring-slate-blue" />
        </div>
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Phone</label>
            <input asp-for="PhoneNumber" class="w-full rounded-DEFAULT border border-border-subtle px-4 py-2 focus:border-slate-blue focus:ring-slate-blue" />
        </div>
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Roles</label>
            <div class="space-y-2">
                @foreach (var role in allRoles)
                {
                    <label class="flex items-center gap-2">
                        <input type="checkbox" name="SelectedRoles" value="@role" class="rounded border-border-subtle text-primary focus:ring-slate-blue" @(Model.SelectedRoles.Contains(role) ? "checked" : "") />
                        <span class="font-body-md text-body-md text-on-surface-variant">@role</span>
                    </label>
                }
            </div>
        </div>
        <button type="submit" class="w-full py-3 bg-primary hover:bg-primary-container text-white font-label-lg text-label-lg rounded-DEFAULT transition-colors">Save Changes</button>
    </form>
</div>
