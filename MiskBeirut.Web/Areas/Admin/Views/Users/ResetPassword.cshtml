@model ResetPasswordRequest
@{
    ViewData["Title"] = "Reset Password";
}

<div class="max-w-md mx-auto bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT p-container-padding">
    <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-lg">Reset Password: @Model.Username</h2>

    <div asp-validation-summary="All" class="mb-stack-md font-body-md text-body-md text-brick-red"></div>

    <form asp-action="ResetPassword" method="post" class="space-y-stack-md">
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="Username" />
        <div>
            <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">New Password</label>
            <input asp-for="NewPassword" type="password" class="w-full rounded-DEFAULT border border-border-subtle px-4 py-2 focus:border-slate-blue focus:ring-slate-blue" />
        </div>
        <button type="submit" class="w-full py-3 bg-primary hover:bg-primary-container text-white font-label-lg text-label-lg rounded-DEFAULT transition-colors">Reset Password</button>
    </form>
</div>
