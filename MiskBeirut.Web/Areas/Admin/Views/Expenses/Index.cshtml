@model IEnumerable<MiskBeirut.Application.Dtos.DailyClosings.ExpenseReportEntryDto>
@using MiskBeirut.Application.Dtos.Receivers
@{
    Layout = "_Layout";
    ViewData["Title"] = "Expenses Management";
    var currentMonth = ViewData["CurrentMonth"] as int?;
    var currentYear = ViewData["CurrentYear"] as int?;
    var currentReceiverId = ViewData["CurrentReceiverId"] as int?;
    var receivers = ViewData["Receivers"] as IReadOnlyList<ReceiverDto> ?? Array.Empty<ReceiverDto>();
    var total = ViewData["Total"] as decimal? ?? 0;
    var count = ViewData["Count"] as int? ?? 0;
    var max = ViewData["Max"] as decimal? ?? 0;
    var content = (MiskBeirut.Web.Support.BackofficePageContent)ViewData["Content"]!;
}

<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-stack-lg">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-xs">@content.Text("title", "Expenses Management")</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">@content.Text("subtitle", "Track and manage business expenses.")</p>
    </div>

    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <a asp-area="Admin" asp-controller="System" asp-action="ControlPanel"
           class="inline-flex items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back
        </a>

        <select id="expenseMonth" class="rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-1 focus:ring-slate-blue focus:border-slate-blue text-on-surface">
            <option value="">All Months</option>
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == currentMonth ? "selected" : null)">@(new DateTime(2000, m, 1).ToString("MMMM"))</option>
            }
        </select>

        <select id="expenseYear" class="rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-1 focus:ring-slate-blue focus:border-slate-blue text-on-surface">
            <option value="">All Years</option>
            @for (int y = 2023; y <= 2030; y++)
            {
                <option value="@y" selected="@(y == currentYear ? "selected" : null)">@y</option>
            }
        </select>

        <select id="expenseReceiver" class="rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-1 focus:ring-slate-blue focus:border-slate-blue text-on-surface">
            <option value="">All Receivers</option>
            @foreach (var receiver in receivers)
            {
                <option value="@receiver.Id" selected="@(receiver.Id == currentReceiverId ? "selected" : null)">@receiver.Name</option>
            }
        </select>

        <button onclick="filterExpenses()"
            class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">filter_list</span>
            Filter
        </button>

        <button type="button" data-bs-toggle="modal" data-bs-target="#addExpenseModal"
            class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-primary hover:bg-primary-container text-white rounded-DEFAULT font-label-md text-label-md uppercase tracking-wider transition-colors w-full sm:w-auto">
            <span class="material-symbols-outlined text-sm">add</span>
            Add Expense
        </button>
    </div>
</div>

<!-- Statistics Summary -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-gutter mb-stack-lg">
    <div class="bg-primary text-white rounded-DEFAULT p-stack-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 transform translate-x-1/4 -translate-y-1/4">
            <span class="material-symbols-outlined text-8xl">account_balance</span>
        </div>
        <div class="relative z-10">
            <h6 class="font-label-sm text-label-sm uppercase tracking-wider mb-stack-sm opacity-80">Total Expenses</h6>
            <h3 class="font-headline-lg text-headline-lg">$@total.ToString("F2")</h3>
        </div>
    </div>

    <div class="bg-on-surface text-white rounded-DEFAULT p-stack-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 transform translate-x-1/4 -translate-y-1/4">
            <span class="material-symbols-outlined text-8xl">tag</span>
        </div>
        <div class="relative z-10">
            <h6 class="font-label-sm text-label-sm uppercase tracking-wider mb-stack-sm opacity-80">Record Count</h6>
            <h3 class="font-headline-lg text-headline-lg">@count</h3>
        </div>
    </div>

    <div class="bg-slate-blue text-white rounded-DEFAULT p-stack-lg relative overflow-hidden">
        <div class="absolute right-0 top-0 opacity-10 transform translate-x-1/4 -translate-y-1/4">
            <span class="material-symbols-outlined text-8xl">trending_up</span>
        </div>
        <div class="relative z-10">
            <h6 class="font-label-sm text-label-sm uppercase tracking-wider mb-stack-sm opacity-80">Max Single Expense</h6>
            <h3 class="font-headline-lg text-headline-lg">$@max.ToString("F2")</h3>
        </div>
    </div>
</div>

<!-- Expenses Table -->
<div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
            <thead>
                <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                    <th class="py-3 px-stack-md" data-sort="number">ID</th>
                    <th class="py-3 px-stack-md" data-sort="date">Date</th>
                    <th class="py-3 px-stack-md" data-sort="text">Receiver</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Amount</th>
                    <th class="py-3 px-stack-md">Note</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var record in Model)
                    {
                        <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors">
                            <td class="py-4 px-stack-md text-on-surface-variant">@record.Id</td>
                            <td class="py-4 px-stack-md font-medium text-on-surface">@record.Date.ToString("yyyy-MM-dd")</td>
                            <td class="py-4 px-stack-md text-on-surface-variant">
                                <span class="inline-flex items-center px-2 py-1 rounded-DEFAULT bg-surface-container-high text-xs font-medium text-on-surface-variant">
                                    @record.ReceiverName
                                </span>
                            </td>
                            <td class="py-4 px-stack-md text-right font-medium text-on-surface-variant">$@record.Amount.ToString("F2")</td>
                            <td class="py-4 px-stack-md text-on-surface-variant">@(record.Note ?? "N/A")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="py-12 px-stack-md text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center">
                                <span class="material-symbols-outlined text-4xl mb-3 text-on-surface-variant/40">account_balance</span>
                                <p class="font-body-lg text-body-lg font-medium">@content.Text("empty_title", "No expenses found")</p>
                                <p class="font-body-md text-body-md mt-1">@content.Text("empty_body", "Adjust your filters to see data here.")</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Add Expense Modal — saved with no Daily Closing yet; DailyClosingManager attaches it
     automatically once one exists for that date (see ExpensesController.Add). -->
<div class="modal fade" id="addExpenseModal" tabindex="-1" aria-labelledby="addExpenseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content overflow-hidden">
            <div class="modal-header">
                <h5 class="modal-title flex items-center gap-2" id="addExpenseModalLabel">
                    <span class="material-symbols-outlined text-primary">add</span>
                    Add Expense
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Add" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body space-y-stack-md">
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Date</label>
                        <input type="date" name="Date" value="@DateOnly.FromDateTime(DateTime.Today).ToString("yyyy-MM-dd")" required
                            class="w-full rounded-DEFAULT border border-border-subtle text-on-surface focus:ring-slate-blue focus:border-slate-blue font-body-md text-body-md px-4 py-2" />
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Amount</label>
                        <input type="number" name="Amount" step="0.01" min="0.01" required
                            class="w-full rounded-DEFAULT border border-border-subtle text-on-surface focus:ring-slate-blue focus:border-slate-blue font-body-md text-body-md px-4 py-2" />
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Receiver</label>
                        <select name="ReceiverId" required class="w-full rounded-DEFAULT border border-border-subtle text-on-surface focus:ring-slate-blue focus:border-slate-blue font-body-md text-body-md px-4 py-2">
                            <option value="">Select receiver...</option>
                            @foreach (var receiver in receivers)
                            {
                                <option value="@receiver.Id">@receiver.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Note</label>
                        <input type="text" name="Note" placeholder="Note (optional)"
                            class="w-full rounded-DEFAULT border border-border-subtle text-on-surface focus:ring-slate-blue focus:border-slate-blue font-body-md text-body-md px-4 py-2" />
                    </div>
                    <p class="font-body-sm text-body-sm text-on-surface-variant">No Daily Closing needed — this is attached to that date's closing automatically once one exists.</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="px-4 py-2 bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-primary hover:bg-primary-container text-white rounded-DEFAULT font-label-md text-label-md transition-colors">Add Expense</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
    function filterExpenses() {
        const month = document.getElementById('expenseMonth').value;
        const year = document.getElementById('expenseYear').value;
        const receiverId = document.getElementById('expenseReceiver').value;
        const params = new URLSearchParams();
        if (month) params.append('month', month);
        if (year) params.append('year', year);
        if (receiverId) params.append('receiverId', receiverId);
        window.location.href = `?${params.toString()}`;
    }
</script>
}
