@model IEnumerable<RoleListItemViewModel>
@using MiskBeirut.Web.Areas.Admin.Models.Roles
@{
    Layout = "_Layout";
    ViewData["Title"] = "Role Manager";
    var content = (MiskBeirut.Web.Support.BackofficePageContent)ViewData["Content"]!;
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-stack-lg">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-xs">@content.Text("title", "Role Manager")</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">@content.Text("subtitle", "Create roles and manage which pages and sections each one can access.")</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <a asp-area="Admin" asp-controller="System" asp-action="ControlPanel"
            class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back
        </a>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-gutter">
    <div class="lg:col-span-2">
        <div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
                    <thead>
                        <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                            <th class="py-3 px-stack-md" data-sort="text">Role Name</th>
                            <th class="py-3 px-stack-md text-center" data-sort="number">Users</th>
                            <th class="py-3 px-stack-md text-center w-48">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var role in Model)
                            {
                                <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors">
                                    <td class="py-4 px-stack-md font-medium text-on-surface">
                                        @role.Name
                                        @if (role.Name == "Admin")
                                        {
                                            <span class="ml-2 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-xs font-bold uppercase tracking-wider">Full Access</span>
                                        }
                                    </td>
                                    <td class="py-4 px-stack-md text-center text-on-surface-variant">@role.UserCount</td>
                                    <td class="py-4 px-stack-md">
                                        <div class="flex items-center justify-center gap-3">
                                            <a asp-action="RoleUsers" asp-route-id="@role.Id" class="text-slate-blue hover:text-primary inline-flex items-center" title="Assign Users">
                                                <span class="material-symbols-outlined text-sm">group</span>
                                            </a>
                                            @if (role.Name != "Admin")
                                            {
                                                <a asp-action="RolePrivileges" asp-route-id="@role.Id" class="text-slate-blue hover:text-primary inline-flex items-center" title="Edit Privileges">
                                                    <span class="material-symbols-outlined text-sm">tune</span>
                                                </a>
                                                <form asp-action="DeleteRole" method="post" onsubmit="return confirm('Delete role &quot;@role.Name&quot;? This cannot be undone.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@role.Id" />
                                                    <button type="submit" class="text-brick-red hover:opacity-80 inline-flex items-center" title="Delete">
                                                        <span class="material-symbols-outlined text-sm">delete</span>
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <span class="text-xs text-on-surface-variant italic">Always has full access</span>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3" class="py-12 px-stack-md text-center text-on-surface-variant">No roles found.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div>
        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-stack-sm">Add Role</h3>
        <form asp-action="CreateRole" method="post" class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT p-stack-md space-y-3">
            @Html.AntiForgeryToken()
            <div>
                <label class="block font-label-sm text-label-sm text-on-surface-variant uppercase mb-stack-xs">Role Name</label>
                <input name="Name" required class="w-full rounded-DEFAULT border border-border-subtle px-3 py-2 font-body-md text-body-md" placeholder="e.g. Accountant" />
            </div>
            <button type="submit" class="w-full py-2 bg-primary hover:bg-primary-container text-white font-label-md text-label-md rounded-DEFAULT">+ Add Role</button>
            <p class="font-label-sm text-label-sm text-on-surface-variant normal-case tracking-normal">New roles start with no privileges — grant access from the tune icon after creating.</p>
        </form>
    </div>
</div>
