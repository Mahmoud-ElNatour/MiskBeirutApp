@model IEnumerable<InvestorListItemViewModel>
@using MiskBeirut.Web.Areas.Admin.Models.Investors
@{
    ViewData["Title"] = "Investors";
    var content = (MiskBeirut.Web.Support.BackofficePageContent)ViewData["Content"]!;
    var inactiveInvestors = (List<InvestorListItemViewModel>)ViewData["InactiveInvestors"]!;
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-stack-lg">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-xs">@content.Text("index_title", "Investors")</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">@content.Text("index_subtitle", "Track investor withdrawals and their expenses by receiver.")</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <a asp-area="Admin" asp-controller="System" asp-action="ControlPanel" class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back
        </a>
        <a asp-action="Create" class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-primary hover:bg-primary-container text-white rounded-DEFAULT font-label-md text-label-md uppercase tracking-wider transition-colors">
            <span class="material-symbols-outlined text-sm">person_add</span>
            @content.Text("add_button_label", "Add Investor")
        </a>
    </div>
</div>

<!-- Investors Table -->
<div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
            <thead>
                <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                    <th class="py-3 px-stack-md" data-sort="text">Name</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Total Expenses</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Total Withdrawals</th>
                    <th class="py-3 px-stack-md text-center w-24">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var investor in Model)
                    {
                        <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors">
                            <td class="py-4 px-stack-md font-medium text-on-surface flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant border border-surface-container-high shrink-0">
                                    <span class="material-symbols-outlined text-sm">person</span>
                                </div>
                                @investor.Name
                            </td>
                            <td class="py-4 px-stack-md text-right text-on-surface-variant font-medium">$@investor.TotalExpenses.ToString("F2")</td>
                            <td class="py-4 px-stack-md text-right text-on-surface-variant font-medium">$@investor.TotalWithdrawals.ToString("F2")</td>
                            <td class="py-4 px-stack-md text-center">
                                <div class="flex items-center justify-center gap-3">
                                    <a asp-action="Details" asp-route-id="@investor.Id" class="text-slate-blue hover:text-primary inline-flex" title="View Details">
                                        <span class="material-symbols-outlined text-sm">visibility</span>
                                    </a>
                                    <form asp-action="Deactivate" asp-route-id="@investor.Id" method="post" class="inline"
                                        onsubmit="return confirm('Deactivate @investor.Name? They\'ll be hidden from active lists — all their transaction history stays intact, and you can reactivate them any time.');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="text-brick-red hover:opacity-80 inline-flex" title="Deactivate">
                                            <span class="material-symbols-outlined text-sm">person_remove</span>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="py-12 px-stack-md text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center">
                                <span class="material-symbols-outlined text-4xl mb-3 text-on-surface-variant/40">group_off</span>
                                <p class="font-body-lg text-body-lg font-medium">@content.Text("empty_title", "No investors found")</p>
                                <p class="font-body-md text-body-md mt-1">@content.Text("empty_body", "Add an investor to start tracking their withdrawals and expenses.")</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (inactiveInvestors.Any())
{
    <div class="mt-stack-lg">
        <h3 class="font-headline-sm text-headline-sm text-on-surface mb-stack-sm">Inactive Investors</h3>
        <div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
                    <thead>
                        <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                            <th class="py-3 px-stack-md" data-sort="text">Name</th>
                            <th class="py-3 px-stack-md text-right" data-sort="number">Total Expenses</th>
                            <th class="py-3 px-stack-md text-right" data-sort="number">Total Withdrawals</th>
                            <th class="py-3 px-stack-md text-center w-24">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var investor in inactiveInvestors)
                        {
                            <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors opacity-70">
                                <td class="py-4 px-stack-md font-medium text-on-surface flex items-center gap-3">
                                    <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant border border-surface-container-high shrink-0">
                                        <span class="material-symbols-outlined text-sm">person</span>
                                    </div>
                                    @investor.Name
                                </td>
                                <td class="py-4 px-stack-md text-right text-on-surface-variant font-medium">$@investor.TotalExpenses.ToString("F2")</td>
                                <td class="py-4 px-stack-md text-right text-on-surface-variant font-medium">$@investor.TotalWithdrawals.ToString("F2")</td>
                                <td class="py-4 px-stack-md text-center">
                                    <div class="flex items-center justify-center gap-3">
                                        <a asp-action="Details" asp-route-id="@investor.Id" class="text-slate-blue hover:text-primary inline-flex" title="View Details">
                                            <span class="material-symbols-outlined text-sm">visibility</span>
                                        </a>
                                        <form asp-action="Reactivate" asp-route-id="@investor.Id" method="post" class="inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-status-success hover:opacity-80 inline-flex" title="Reactivate">
                                                <span class="material-symbols-outlined text-sm">person_add</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
