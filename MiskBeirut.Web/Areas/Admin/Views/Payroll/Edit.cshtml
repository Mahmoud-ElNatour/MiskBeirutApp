@model PayrollFormViewModel
@using MiskBeirut.Web.Areas.Admin.Models.Payroll
@{
    ViewData["Title"] = "Edit Payroll";
}

<div class="max-w-lg mx-auto bg-white dark:bg-slate-900 border border-primary/10 rounded-xl p-8 shadow-sm">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">@Model.EmployeeName — @Model.Year-@Model.Month.ToString("00")</h2>
    <form asp-action="Edit" method="post" class="space-y-6">
        <input type="hidden" asp-for="EmployeeId" />
        <input type="hidden" asp-for="EmployeeName" />
        <input type="hidden" asp-for="Year" />
        <input type="hidden" asp-for="Month" />
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Status</label>
            <input asp-for="Status" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Working Days</label>
                <input asp-for="WorkingDays" type="number" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Actual Working Days</label>
                <input asp-for="ActualWorkingDays" type="number" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Advance Total</label>
                <input asp-for="AdvanceTotal" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Deductions Total</label>
                <input asp-for="DeductionsTotal" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
            </div>
        </div>
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Actual Salary</label>
                <input asp-for="ActualSalary" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
            </div>
            <div>
                <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Total</label>
                <input asp-for="Total" type="number" step="0.01" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2" />
            </div>
        </div>
        <label class="flex items-center gap-2">
            <input asp-for="IsWorking" type="checkbox" class="rounded border-slate-300" />
            <span class="text-sm font-semibold text-slate-700 dark:text-slate-300">Currently Working</span>
        </label>
        <div>
            <label class="block text-sm font-semibold text-slate-700 dark:text-slate-300 mb-2">Note</label>
            <textarea asp-for="Note" rows="3" class="w-full rounded-lg border-slate-300 dark:border-slate-700 dark:bg-slate-800 px-4 py-2"></textarea>
        </div>
        <button type="submit" class="w-full py-3 bg-primary hover:bg-primary/95 text-white font-bold rounded-lg transition-colors">Save</button>
    </form>
</div>
