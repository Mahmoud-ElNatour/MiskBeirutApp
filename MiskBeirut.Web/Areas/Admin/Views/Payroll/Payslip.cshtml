@model MiskBeirut.Web.Areas.Admin.Models.Payroll.PayslipViewModel
@{
    Layout = null; // Payslip has its own standalone HTML structure
    var employee = Model.Employee;
    var record = Model.Record;
    var monthNames = new[] { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
    var monthName = monthNames[record.Month - 1];
}
<!DOCTYPE html>
<html class="light" lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Payslip - @employee.Name</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#1c4258',
                        'brick-red': '#8F383A',
                        'slate-blue': '#4E7289',
                        'status-success': '#2D6A4F',
                        'status-pending': '#D97706',
                        'on-surface': '#1a1c1d',
                        'on-surface-variant': '#42474c',
                        'border-subtle': '#E2E2E4',
                        'surface-bright': '#f9f9fa'
                    },
                    fontFamily: {
                        headline: ['EB Garamond', 'serif'],
                        sans: ['Hanken Grotesk', 'system-ui', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:wght@500;600&family=Hanken+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- Google Material Symbols -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />
    <style>
        body {
            font-family: 'Hanken Grotesk', sans-serif;
            background-color: #f9f9fa;
            color: #42474c;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .material-symbols-outlined {
            font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
        }

        @@media print {
            .no-print {
                display: none !important;
            }

            body {
                background-color: white;
                padding: 0;
            }

            .payslip-container {
                box-shadow: none !important;
                border: none !important;
                padding: 0 !important;
                max-width: 100% !important;
            }
        }
    </style>
</head>

<body class="p-4 sm:p-8">

    <div class="max-w-4xl mx-auto flex justify-end mb-6 no-print">
        <button onclick="window.print()"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-primary hover:opacity-90 text-white rounded font-medium shadow-sm transition-colors">
            <span class="material-symbols-outlined text-sm">print</span>
            Print Payslip
        </button>
    </div>

    <!-- Payslip Document -->
    <div class="payslip-container max-w-4xl mx-auto bg-white border border-border-subtle shadow-lg rounded p-8 sm:p-12">

        <!-- Header -->
        <div class="flex justify-between items-end border-b-2 border-primary pb-6 mb-8">
            <div class="flex items-center gap-3 text-primary">
                <span class="material-symbols-outlined text-4xl">inventory_2</span>
                <span class="font-headline text-3xl font-semibold tracking-tight">Misk Beirut</span>
            </div>
            <div class="text-right">
                <h1 class="text-2xl font-bold text-on-surface tracking-tight uppercase">Official Payslip</h1>
                <p class="text-on-surface-variant mt-1 uppercase text-sm font-semibold tracking-wider">@monthName @record.Year</p>
            </div>
        </div>

        <!-- Employee Info Grid -->
        <div class="grid grid-cols-2 gap-y-6 gap-x-12 mb-10 p-6 bg-surface-bright rounded border border-border-subtle">
            <div>
                <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-1">Employee Name</p>
                <p class="text-lg font-semibold text-on-surface">@employee.Name</p>
            </div>
            <div>
                <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-1">Employee ID</p>
                <p class="text-lg font-mono font-medium text-on-surface-variant">#@employee.Id.ToString("D4")</p>
            </div>
            <div>
                <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-1">Position</p>
                <p class="text-base font-medium text-on-surface-variant">@(employee.Position ?? "General Staff")</p>
            </div>
            <div>
                <p class="text-xs font-bold text-on-surface-variant uppercase tracking-widest mb-1">Payment Date</p>
                <p class="text-base font-medium text-on-surface-variant">@DateTime.UtcNow.ToString("MMMM dd, yyyy")</p>
            </div>
        </div>

        <!-- Salary Breakdown -->
        <div class="mb-10">
            <h3 class="text-sm font-bold text-on-surface-variant uppercase tracking-widest mb-4">Earnings &amp; Deductions</h3>
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b-2 border-border-subtle">
                        <th class="py-3 font-semibold text-on-surface-variant w-2/3">Description</th>
                        <th class="py-3 font-semibold text-on-surface-variant text-right w-1/3">Amount / Days</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-border-subtle">
                    <tr class="border-b border-border-subtle">
                        <td class="py-4 text-on-surface-variant font-medium">Base Salary</td>
                        <td class="py-4 text-right text-on-surface font-semibold">$@employee.BaseSalary.ToString("F2")</td>
                    </tr>
                    <tr class="border-b border-border-subtle bg-surface-bright/50">
                        <td class="py-4 text-on-surface-variant">Working Days (Scheduled)</td>
                        <td class="py-4 text-right text-on-surface-variant font-medium">@(record.WorkingDays?.ToString() ?? "—")</td>
                    </tr>
                    <tr class="border-b border-border-subtle">
                        <td class="py-4 text-on-surface-variant">Actual Working Days</td>
                        <td class="py-4 text-right text-on-surface-variant font-medium">@(record.ActualWorkingDays?.ToString() ?? "—")</td>
                    </tr>

                    @if ((record.DeductionsTotal ?? 0) > 0)
                    {
                        <tr class="border-b border-border-subtle bg-brick-red/5">
                            <td class="py-4 text-on-surface-variant font-medium flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm text-brick-red">remove</span>
                                Deductions
                            </td>
                            <td class="py-4 text-right text-brick-red font-semibold font-mono">- $@record.DeductionsTotal!.Value.ToString("F2")</td>
                        </tr>
                    }

                    @if ((record.AdvanceTotal ?? 0) > 0)
                    {
                        <tr class="border-b border-border-subtle bg-status-pending/5">
                            <td class="py-4 text-on-surface-variant font-medium flex items-center gap-2">
                                <span class="material-symbols-outlined text-sm text-status-pending">remove</span>
                                Advance Payment
                            </td>
                            <td class="py-4 text-right text-status-pending font-semibold font-mono">- $@record.AdvanceTotal!.Value.ToString("F2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Details Section -->
        @if (Model.Advances.Any() || Model.Deductions.Any())
        {
            <div class="mb-10 bg-surface-bright rounded p-6 border border-border-subtle border-dashed">
                <h4 class="text-sm font-bold text-on-surface-variant uppercase tracking-widest mb-4 flex items-center gap-2">
                    <span class="material-symbols-outlined text-sm">list_alt</span>
                    Itemized Adjustments Detail
                </h4>
                <table class="w-full text-left text-sm">
                    <thead>
                        <tr class="border-b border-border-subtle">
                            <th class="py-2 text-on-surface-variant font-medium w-32">Date</th>
                            <th class="py-2 text-on-surface-variant font-medium w-32">Type</th>
                            <th class="py-2 text-on-surface-variant font-medium">Note</th>
                            <th class="py-2 text-on-surface-variant font-medium text-right w-32">Amount</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-border-subtle">
                        @foreach (var adv in Model.Advances)
                        {
                            <tr class="border-b border-border-subtle/50">
                                <td class="py-2 text-on-surface-variant font-mono text-xs">@adv.Date.ToString("yyyy-MM-dd")</td>
                                <td class="py-2 text-status-pending font-medium text-xs uppercase tracking-wide">Advance</td>
                                <td class="py-2 text-on-surface-variant">@(adv.Note ?? "-")</td>
                                <td class="py-2 text-right text-on-surface-variant font-mono font-medium">$@Math.Abs(adv.Amount).ToString("F2")</td>
                            </tr>
                        }
                        @foreach (var ded in Model.Deductions)
                        {
                            <tr class="border-b border-border-subtle/50">
                                <td class="py-2 text-on-surface-variant font-mono text-xs">@ded.Date.ToString("yyyy-MM-dd")</td>
                                <td class="py-2 text-brick-red font-medium text-xs uppercase tracking-wide">Deduction</td>
                                <td class="py-2 text-on-surface-variant">@(ded.Note ?? "-")</td>
                                <td class="py-2 text-right text-on-surface-variant font-mono font-medium">$@Math.Abs(ded.Amount).ToString("F2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Total Section -->
        <div class="flex justify-between items-center pt-6 border-t-[3px] border-on-surface mb-16">
            <div class="text-xl font-black text-on-surface tracking-tight uppercase">Net Payable</div>
            <div class="text-4xl font-black text-status-success tracking-tight font-mono">$@((record.Total ?? 0).ToString("F2"))</div>
        </div>

        <!-- Footer -->
        <div class="text-center pt-8 border-t border-border-subtle">
            <p class="text-xs text-on-surface-variant font-medium uppercase tracking-wider mb-2">This is a computer-generated document and does not require a physical signature.</p>
            <p class="text-xs text-on-surface-variant">&copy; @record.Year Misk Beirut Business System</p>
        </div>
    </div>
</body>

</html>
