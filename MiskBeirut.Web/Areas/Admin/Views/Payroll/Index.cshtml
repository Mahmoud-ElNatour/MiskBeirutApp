@model IEnumerable<MiskBeirut.Web.Areas.Admin.Models.Payroll.PayrollIndexRowViewModel>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Payroll Management";
    var currentMonth = ViewData["CurrentMonth"] as int? ?? DateTime.UtcNow.Month;
    var currentYear = ViewData["CurrentYear"] as int? ?? DateTime.UtcNow.Year;
    var content = (MiskBeirut.Web.Support.BackofficePageContent)ViewData["Content"]!;
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-stack-lg">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-xs">@content.Text("title", "Payroll Management")</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">@content.Text("subtitle", "Employee payroll and benefits management.")</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <select id="payrollMonth"
            class="rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-1 focus:ring-slate-blue focus:border-slate-blue text-on-surface">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m" selected="@(m == currentMonth ? "selected" : null)">
                    @(new DateTime(2000, m, 1).ToString("MMMM"))
                </option>
            }
        </select>
        <select id="payrollYear"
            class="rounded-DEFAULT border border-border-subtle font-body-md text-body-md focus:ring-1 focus:ring-slate-blue focus:border-slate-blue text-on-surface">
            @for (int y = 2023; y <= 2030; y++)
            {
                <option value="@y" selected="@(y == currentYear ? "selected" : null)">@y</option>
            }
        </select>
        <button onclick="filterPayroll()"
            class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">filter_list</span>
            Filter
        </button>
    </div>
</div>

<!-- Payroll Table -->
<div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
            <thead>
                <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                    <th class="py-3 px-stack-md" data-sort="text">Employee</th>
                    <th class="py-3 px-stack-md" data-sort="text">Position</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Base Salary</th>
                    <th class="py-3 px-stack-md text-center">Working Days</th>
                    <th class="py-3 px-stack-md text-center">Actual Days</th>
                    <th class="py-3 px-stack-md text-right">Advance</th>
                    <th class="py-3 px-stack-md text-right">Deductions</th>
                    <th class="py-3 px-stack-md text-right">Actual Salary</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Net Payable</th>
                    <th class="py-3 px-stack-md text-center w-24">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var row in Model)
                    {
                        <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors">
                            <td class="py-4 px-stack-md text-on-surface font-medium">@row.Employee.Name</td>
                            <td class="py-4 px-stack-md text-on-surface-variant">@(row.Employee.Position ?? "N/A")</td>
                            <td class="py-4 px-stack-md text-right text-on-surface-variant">$@row.Employee.BaseSalary.ToString("F2")</td>
                            <td class="py-4 px-stack-md text-center text-on-surface-variant">
                                <span class="inline-flex items-center justify-center min-w-[2rem] px-2 py-1 rounded-DEFAULT bg-surface-container-high text-xs border border-surface-container-high">
                                    @(row.Record?.WorkingDays?.ToString() ?? "—")
                                </span>
                            </td>
                            <td class="py-4 px-stack-md text-center text-status-success font-bold">
                                <span class="inline-flex items-center justify-center min-w-[2rem] px-2 py-1 rounded-DEFAULT bg-[#E8F5E9] text-xs border border-status-success/20">
                                    @(row.Record?.ActualWorkingDays?.ToString() ?? "—")
                                </span>
                            </td>
                            <td class="py-4 px-stack-md text-right text-brick-red">$@((row.Record?.AdvanceTotal ?? 0).ToString("F2"))</td>
                            <td class="py-4 px-stack-md text-right text-brick-red">$@((row.Record?.DeductionsTotal ?? 0).ToString("F2"))</td>
                            <td class="py-4 px-stack-md text-right text-status-success">$@((row.Record?.ActualSalary ?? 0).ToString("F2"))</td>
                            <td class="py-4 px-stack-md text-right text-primary text-base font-bold">$@((row.Record?.Total ?? 0).ToString("F2"))</td>
                            <td class="py-4 px-stack-md">
                                <div class="flex items-center justify-center gap-3">
                                    <a asp-action="Edit" asp-route-employeeId="@row.Employee.Id" asp-route-year="@currentYear" asp-route-month="@currentMonth"
                                        class="text-status-pending hover:opacity-80 inline-flex items-center"
                                        title="Edit Payroll">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                    </a>
                                    @if (row.Record is not null)
                                    {
                                        <a asp-action="Payslip" asp-route-employeeId="@row.Employee.Id" asp-route-year="@currentYear" asp-route-month="@currentMonth" target="_blank"
                                            class="text-slate-blue hover:text-primary inline-flex items-center"
                                            title="View Payslip">
                                            <span class="material-symbols-outlined text-sm">receipt_long</span>
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-employeeId="@row.Employee.Id"
                                        class="text-on-surface-variant hover:text-primary inline-flex items-center"
                                        title="Payroll History">
                                        <span class="material-symbols-outlined text-sm">history</span>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="py-12 px-stack-md text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center">
                                <span class="material-symbols-outlined text-4xl mb-3 text-on-surface-variant/40">badge</span>
                                <p class="font-body-lg text-body-lg font-medium">No currently working employees found for this month.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
    function filterPayroll() {
        const month = document.getElementById('payrollMonth').value;
        const year = document.getElementById('payrollYear').value;
        const params = new URLSearchParams();
        if (month) params.append('month', month);
        if (year) params.append('year', year);
        window.location.href = `?${params.toString()}`;
    }
</script>
}
