@model MiskBeirut.Web.Areas.Admin.Models.Payroll.EmployeePayrollViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"Payroll History — {Model.Employee.Name}";
    var content = (MiskBeirut.Web.Support.BackofficePageContent)ViewData["Content"]!;
    var monthNames = new[] { "January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December" };
}

<!-- Header -->
<div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-stack-lg">
    <div>
        <h2 class="font-headline-lg text-headline-lg text-on-surface mb-stack-xs">@Model.Employee.Name</h2>
        <p class="font-body-md text-body-md text-on-surface-variant">@(Model.Employee.Position ?? "General Staff") — Payroll History</p>
    </div>
    <div class="flex flex-wrap items-center gap-3 w-full md:w-auto">
        <a asp-action="Index"
            class="inline-flex justify-center items-center gap-2 px-stack-md py-stack-sm bg-surface-container-lowest border border-border-subtle rounded-DEFAULT font-label-md text-label-md text-on-surface-variant hover:border-slate-blue transition-colors">
            <span class="material-symbols-outlined text-sm">arrow_back</span>
            Back to Payroll
        </a>
    </div>
</div>

<!-- History Table -->
<div class="bg-surface-container-lowest border border-surface-container-high rounded-DEFAULT overflow-hidden">
    <div class="overflow-x-auto">
        <table class="w-full text-left font-data-tabular text-data-tabular" data-sortable data-paginate="10">
            <thead>
                <tr class="border-b border-surface-container-high bg-surface-bright font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider">
                    <th class="py-3 px-stack-md">Month</th>
                    <th class="py-3 px-stack-md text-center">Working Days</th>
                    <th class="py-3 px-stack-md text-center">Actual Days</th>
                    <th class="py-3 px-stack-md text-right">Advance</th>
                    <th class="py-3 px-stack-md text-right">Deductions</th>
                    <th class="py-3 px-stack-md text-right">Actual Salary</th>
                    <th class="py-3 px-stack-md text-right" data-sort="number">Net Payable</th>
                    <th class="py-3 px-stack-md text-center w-16">Payslip</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Records.Any())
                {
                    foreach (var record in Model.Records)
                    {
                        <tr class="border-b border-surface-container-high hover:bg-surface-bright transition-colors">
                            <td class="py-4 px-stack-md text-on-surface font-medium">@monthNames[record.Month - 1] @record.Year</td>
                            <td class="py-4 px-stack-md text-center text-on-surface-variant">@(record.WorkingDays?.ToString() ?? "—")</td>
                            <td class="py-4 px-stack-md text-center text-on-surface-variant">@(record.ActualWorkingDays?.ToString() ?? "—")</td>
                            <td class="py-4 px-stack-md text-right text-brick-red">$@((record.AdvanceTotal ?? 0).ToString("F2"))</td>
                            <td class="py-4 px-stack-md text-right text-brick-red">$@((record.DeductionsTotal ?? 0).ToString("F2"))</td>
                            <td class="py-4 px-stack-md text-right text-status-success">$@((record.ActualSalary ?? 0).ToString("F2"))</td>
                            <td class="py-4 px-stack-md text-right text-primary text-base font-bold">$@((record.Total ?? 0).ToString("F2"))</td>
                            <td class="py-4 px-stack-md text-center">
                                <a asp-action="Payslip" asp-route-employeeId="@Model.Employee.Id" asp-route-year="@record.Year" asp-route-month="@record.Month" target="_blank"
                                    class="text-slate-blue hover:text-primary inline-flex"
                                    title="View Payslip">
                                    <span class="material-symbols-outlined text-sm">receipt_long</span>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="py-12 px-stack-md text-center text-on-surface-variant">
                            <div class="flex flex-col items-center justify-center">
                                <span class="material-symbols-outlined text-4xl mb-3 text-on-surface-variant/40">history</span>
                                <p class="font-body-lg text-body-lg font-medium">@content.Text("empty_title", "No payroll records found for this employee")</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
