@model EmployeePayrollViewModel
@using MiskBeirut.Web.Areas.Admin.Models.Payroll
@{
    ViewData["Title"] = $"Payroll — {Model.Employee.Name}";
    var now = DateTime.Today;
}

<div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Payroll — @Model.Employee.Name</h2>
    @if (User.IsInRole(RoleNames.Admin))
    {
        <a asp-action="Edit" asp-route-employeeId="@Model.Employee.Id" asp-route-year="@now.Year" asp-route-month="@now.Month" class="px-4 py-2 bg-primary hover:bg-primary/95 text-white font-bold rounded-lg text-sm">+ This Month</a>
    }
</div>

<div class="bg-white dark:bg-slate-900 border border-primary/10 rounded-xl shadow-sm overflow-x-auto">
    <table class="w-full text-sm text-left">
        <thead class="bg-slate-50 dark:bg-slate-800/50 text-slate-500 dark:text-slate-400 uppercase text-xs">
            <tr>
                <th class="px-6 py-3">Period</th>
                <th class="px-6 py-3">Status</th>
                <th class="px-6 py-3">Working Days</th>
                <th class="px-6 py-3">Advances</th>
                <th class="px-6 py-3">Deductions</th>
                <th class="px-6 py-3">Actual Salary</th>
                <th class="px-6 py-3 text-right">Actions</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
            @foreach (var r in Model.Records)
            {
                <tr>
                    <td class="px-6 py-3 font-semibold text-slate-900 dark:text-white">@r.Year-@r.Month.ToString("00")</td>
                    <td class="px-6 py-3">@r.Status</td>
                    <td class="px-6 py-3">@(r.ActualWorkingDays?.ToString() ?? "-") / @(r.WorkingDays?.ToString() ?? "-")</td>
                    <td class="px-6 py-3">@(r.AdvanceTotal?.ToString("N2") ?? "0.00")</td>
                    <td class="px-6 py-3">@(r.DeductionsTotal?.ToString("N2") ?? "0.00")</td>
                    <td class="px-6 py-3">@(r.ActualSalary?.ToString("N2") ?? "-")</td>
                    <td class="px-6 py-3 text-right">
                        @if (User.IsInRole(RoleNames.Admin))
                        {
                            <a asp-action="Edit" asp-route-employeeId="@Model.Employee.Id" asp-route-year="@r.Year" asp-route-month="@r.Month" class="text-primary hover:underline">Edit</a>
                        }
                    </td>
                </tr>
            }
            @if (!Model.Records.Any())
            {
                <tr><td class="px-6 py-3 text-slate-400" colspan="7">No payroll records yet.</td></tr>
            }
        </tbody>
    </table>
</div>
